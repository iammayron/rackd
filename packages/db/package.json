{
  "name": "@rackd/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./s3": "./src/s3.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:deploy": "node scripts/migrate.mjs",
    "db:seed-demo": "tsx src/seed-demo.ts",
    "ingest:fetch": "tsx src/ingest/fetch-source.ts",
    "ingest:taxonomy": "tsx src/ingest/seed-taxonomy.ts",
    "ingest:exercises": "tsx src/ingest/seed-exercises.ts",
    "ingest:media": "tsx src/ingest/download-media.ts",
    "ingest:dedup-legacy": "tsx src/ingest/dedup-legacy-exercises.ts",
    "ingest:all": "tsx src/ingest/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@rackd/core": "*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
