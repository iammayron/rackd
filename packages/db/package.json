    "test": "vitest run"
  },
  "dependencies": {
    "@rackd/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
