# rackd environment variables
# Local dev: copy the web vars into apps/web/.env.local.
# Production: set as Fly secrets (server-side) or build args (NEXT_PUBLIC_*).
# See DEPLOY.md and docs/specs/fly-setup-guide.md.

# --- Database (Drizzle -> Supabase Postgres) ---
# Supabase project Postgres connection string. Used by @rackd/db and apps/push.
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require
# Set to "false" only for a local Postgres without TLS; leave unset for Supabase Cloud.
# DATABASE_SSL=

# --- Supabase auth ---
# Client (baked at build via NEXT_PUBLIC_*; safe to expose).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server only -- validates the caller's JWT in API routes. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Object storage (Tigris, S3-compatible) -- profile photos ---
S3_ENDPOINT=https://fly.storage.tigris.dev
S3_PUBLIC_URL=https://rackd-photos.fly.storage.tigris.dev
S3_BUCKET=rackd-photos
S3_REGION=auto
S3_ACCESS_KEY=tid_...
S3_SECRET_KEY=tsec_...

# --- Web push (VAPID) ---
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
