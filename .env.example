# Self-hosted Triplit sync server (docker-compose).
# Generate a long random secret, e.g.:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# Supabase JWT secret — the sync server validates user tokens issued by Supabase.
# Local Supabase default:
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# --- Web app (apps/web/.env.local) ---
# Supabase auth (local: `supabase start` prints these):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from supabase start>
# Triplit sync (the user's Supabase access token is used automatically once signed in):
# NEXT_PUBLIC_TRIPLIT_URL=http://<tailscale-host>:8787

# --- Web Push (rest-timer notifications to a backgrounded/locked phone) ---
# Generate ONE key pair and reuse it for all three vars below:
#   npx web-push generate-vapid-keys
# (prints a Public Key and a Private Key). The public key is baked into the web
# client (NEXT_PUBLIC_*) AND given to the push sender; the private key is the
# sender's secret and must NEVER be exposed to the browser / committed.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI required by the Web Push spec (mailto: or https:):
VAPID_SUBJECT=mailto:admin@rackd.app
# Where the push sender reaches the sync server (default http://sync:8787 inside compose):
# PUSH_TRIPLIT_URL=http://sync:8787

# --- MinIO / S3 (profile photo storage) ---
# MinIO is an S3-compatible object store for profile photos. Binaries live here,
# NEVER in the synced DB - only the resulting URL is saved to the profile.
# Root credentials for the bundled MinIO service (docker-compose `minio`):
MINIO_ROOT_USER=myfit
MINIO_ROOT_PASSWORD=change-me-to-a-long-random-secret
# The web server signs uploads to MinIO with these. S3_ENDPOINT is the server-side
# address (inside docker: http://minio:9000). S3_PUBLIC_URL is the browser-facing
# base that <img> loads from - include the bucket and use a host reachable from the
# device (LAN/Tailscale), e.g. http://<tailscale-host>:9000/myfit.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000/myfit
S3_BUCKET=myfit
S3_REGION=us-east-1
S3_ACCESS_KEY=myfit
S3_SECRET_KEY=change-me-to-a-long-random-secret
