# Self-hosted Triplit sync server (docker-compose).
# Generate a long random secret, e.g.:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# --- Web app (apps/web/.env.local) ---
# Leave unset for local-only mode. Set both to enable cloud sync:
# NEXT_PUBLIC_TRIPLIT_URL=http://<tailscale-host>:8787
# NEXT_PUBLIC_TRIPLIT_TOKEN=<token from: pnpm --filter @fitnow/sync gen-token "$JWT_SECRET" service>
