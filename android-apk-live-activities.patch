@@ -0,0 +1,109 @@
+import { eq } from "drizzle-orm";
+import { describe, expect, it } from "vitest";
+import { db } from "../src/db";
+import {
+  exercises,
+  personalRecords,
+  routineExercises,
+  sessionExercises,
+  setLogs,
+} from "../src/schema";
+import { dedupLegacyExercises } from "../src/ingest/dedup-legacy-exercises";
+import { makeRoutine, makeSessionWithSets, OWNER_A } from "./factories";
+import "./setup";
+
+/**
+ * The fixture library (setup.ts) seeds `ex_bench`/`ex_squat`/`ex_row` as legacy
+ * rows (source 'rackd'). We add one imported candidate that should absorb
+ * `ex_bench`; `ex_squat`/`ex_row` have no candidate and must survive untouched.
+ */
+async function seedImportCandidate() {
+  await db.insert(exercises).values({
+    id: "bench-press",
+    name: "Bench Press",
+    primaryMuscle: "chest",
+    secondaryMuscles: [],
+    equipment: "barbell",
+    category: "barbell",
+    source: "free-exercise-db",
+    sourceId: "Bench_Press",
+    slug: "bench-press",
+  });
+}
+
+describe("dedupLegacyExercises", () => {
+  it("repoints references onto the import, preserves history, and deletes the legacy row", async () => {
+    await seedImportCandidate();
+
+    const routine = await makeRoutine({ exerciseIds: ["ex_bench"] });
+    const session = await makeSessionWithSets({
+      exerciseId: "ex_bench",
+      sets: [{ weight: 100, reps: 5 }],
+    });
+    await db.insert(personalRecords).values({
+      id: "pr1",
+      ownerId: OWNER_A,
+      exerciseId: "ex_bench",
+      type: "1rm",
+      value: 120,
+      sessionId: session.sessionId,
+      achievedAt: Date.now(),
+    });
+
+    await dedupLegacyExercises();
+
+    // References now point at the import.
+    const re = await db
+      .select()
+      .from(routineExercises)
+      .where(eq(routineExercises.id, routine.exercises[0].id));
+    expect(re[0].exerciseId).toBe("bench-press");
+    const se = await db
+      .select()
+      .from(sessionExercises)
+      .where(eq(sessionExercises.id, session.sessionExerciseId));
+    expect(se[0].exerciseId).toBe("bench-press");
+    const pr = await db.select().from(personalRecords).where(eq(personalRecords.id, "pr1"));
+    expect(pr[0].exerciseId).toBe("bench-press");
+
+    // Logged-set history survives (came along with its session exercise).
+    const logs = await db
+      .select()
+      .from(setLogs)
+      .where(eq(setLogs.sessionExerciseId, session.sessionExerciseId));
+    expect(logs).toHaveLength(1);
+    expect(logs[0].weight).toBe(100);
+
+    // Legacy row gone; unmatched legacy rows remain.
+    const benchGone = await db.select().from(exercises).where(eq(exercises.id, "ex_bench"));
+    expect(benchGone).toHaveLength(0);
+    const squat = await db.select().from(exercises).where(eq(exercises.id, "ex_squat"));
+    expect(squat).toHaveLength(1);
+  });
+
+  it("is idempotent — a second run changes nothing", async () => {
+    await seedImportCandidate();
+    await makeRoutine({ exerciseIds: ["ex_bench"] });
+
+    await dedupLegacyExercises();
+    await dedupLegacyExercises(); // must not throw or re-touch anything
+
+    const benchGone = await db.select().from(exercises).where(eq(exercises.id, "ex_bench"));
+    expect(benchGone).toHaveLength(0);
+  });
+
+  it("--dry-run writes nothing", async () => {
+    await seedImportCandidate();
+    const routine = await makeRoutine({ exerciseIds: ["ex_bench"] });
+
+    await dedupLegacyExercises({ dryRun: true });
+
+    const re = await db
+      .select()
+      .from(routineExercises)
+      .where(eq(routineExercises.id, routine.exercises[0].id));
+    expect(re[0].exerciseId).toBe("ex_bench");
+    const bench = await db.select().from(exercises).where(eq(exercises.id, "ex_bench"));
+    expect(bench).toHaveLength(1);
+  });
+});
diff --git a/packages/db/test/deleteAccount.test.ts b/packages/db/test/deleteAccount.test.ts
new file mode 100644
index 0000000..6dfa7b4
--- /dev/null
+++ b/packages/db/test/deleteAccount.test.ts
@@ -0,0 +1,139 @@
+import { describe, it, expect } from "vitest";
+import { eq } from "drizzle-orm";
+import { db } from "../src/db";
+import * as t from "../src/schema";
+import {
+  createProgram,
+  addProgramDay,
+  addBodyWeightLog,
+  updateProfile,
+  savePushSubscription,
+  schedulePush,
+  publishRoutine,
+  addRoutineExercise,
+  deleteAccountData,
+} from "../src/index";
+import { makeRoutine, makeSessionWithSets, OWNER_A, OWNER_B } from "./factories";
+
+// Count owner-scoped rows in a table. Every owned table carries `ownerId`.
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+const ownedCount = async (table: any, ownerId: string): Promise<number> => {
+  const rows = await db.select().from(table).where(eq(table.ownerId, ownerId));
+  return rows.length;
+};
+
+/**
+ * Build a full account for `ownerId`: a routine tree, a session tree, an active
+ * program with a day, a body-weight log, a profile, a push subscription with a
+ * scheduled push, and a published (public) shared routine. Returns the routine id.
+ */
+async function seedOwner(ownerId: string, endpoint: string): Promise<string> {
+  const { routineId } = await makeRoutine({ ownerId, setsPer: 2 });
+  await makeSessionWithSets({
+    ownerId,
+    routineId,
+    sets: [{ weight: 100, reps: 5 }],
+  });
+  const program = await createProgram({ ownerId, name: "Block", blockWeeks: 4 });
+  await addProgramDay({ programId: program.id, order: 1, routineId });
+  await addBodyWeightLog({ ownerId, weightKg: 80, loggedAt: Date.now() });
+  await updateProfile(ownerId, { displayName: "Me" });
+  const sub = await savePushSubscription({
+    ownerId,
+    endpoint,
+    p256dh: "key",
+    auth: "auth",
+    now: Date.now(),
+  });
+  await schedulePush({
+    ownerId,
+    subscriptionId: sub!.id,
+    fireAt: Date.now() + 60_000,
+    title: "Rest over",
+    body: "Go",
+    now: Date.now(),
+  });
+  await publishRoutine({ routineId, ownerId, authorName: "Me", now: Date.now() });
+  return routineId;
+}
+
+async function insertCustomExercise(ownerId: string, id: string): Promise<void> {
+  await db.insert(t.exercises).values({
+    id,
+    name: "Custom Move",
+    primaryMuscle: "chest",
+    secondaryMuscles: [],
+    equipment: "machine",
+    category: "machine",
+    isCustom: true,
+    ownerId,
+  });
+}
+
+describe("deleteAccountData", () => {
+  it("wipes the owner's data, keeps shared routines, and never touches another owner", async () => {
+    await seedOwner(OWNER_A, "endpoint-a");
+    const bRoutineId = await seedOwner(OWNER_B, "endpoint-b");
+
+    // A owns a custom exercise that only B's routine references (mirrors an
+    // imported shared routine reusing the author's exerciseId) → must survive.
+    await insertCustomExercise(OWNER_A, "ex_custom_shared");
+    await addRoutineExercise({
+      routineId: bRoutineId,
+      exerciseId: "ex_custom_shared",
+      order: 99,
+    });
+    // A owns a custom exercise nobody references → must be deleted.
+    await insertCustomExercise(OWNER_A, "ex_custom_orphan");
+
+    // Guard against tautologies: confirm A's trees are populated pre-delete.
+    expect(await ownedCount(t.routineExercises, OWNER_A)).toBeGreaterThan(0);
+    expect(await ownedCount(t.setLogs, OWNER_A)).toBeGreaterThan(0);
+    expect(await ownedCount(t.programDays, OWNER_A)).toBe(1);
+    expect(await ownedCount(t.scheduledPushes, OWNER_A)).toBe(1);
+
+    await deleteAccountData(OWNER_A);
+
+    // Every owner-A owned table is emptied — roots and cascaded children alike.
+    for (const table of [
+      t.routines,
+      t.routineExercises,
+      t.routineSets,
+      t.sessions,
+      t.sessionExercises,
+      t.setLogs,
+      t.programs,
+      t.programDays,
+      t.bodyWeightLogs,
+      t.userProfile,
+      t.pushSubscriptions,
+      t.scheduledPushes,
+    ]) {
+      expect(await ownedCount(table, OWNER_A)).toBe(0);
+    }
+
+    // …except the public shared routines, which outlive the author.
+    expect(await ownedCount(t.sharedRoutines, OWNER_A)).toBe(1);
+
+    // Custom exercises: the unreferenced one is gone; the still-referenced stays.
+    const aCustomIds = (
+      await db.select().from(t.exercises).where(eq(t.exercises.ownerId, OWNER_A))
+    ).map((e) => e.id);
+    expect(aCustomIds).toContain("ex_custom_shared");
+    expect(aCustomIds).not.toContain("ex_custom_orphan");
+
+    // Owner B is fully intact across the board.
+    for (const table of [
+      t.routines,
+      t.sessions,
+      t.programs,
+      t.bodyWeightLogs,
+      t.userProfile,
+      t.pushSubscriptions,
+      t.scheduledPushes,
+      t.sharedRoutines,
+    ]) {
+      expect(await ownedCount(table, OWNER_B)).toBe(1);
+    }
+  });
+});
diff --git a/packages/db/test/detectAndRecordPRs.test.ts b/packages/db/test/detectAndRecordPRs.test.ts
