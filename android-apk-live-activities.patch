+    { base: "var(--color-primary-700)", inverse: "var(--color-primary-500)" },
+    { base: "var(--color-primary-900)", inverse: "var(--color-primary-700)" },
+    { base: "var(--color-sky-600)", inverse: "var(--color-sky-400)" },
