+            >
+              Discover routines
+            </Button>
+          </>
+        )}
+      </main>
+      <Nav />
+
+      {browsing && (
+        <div className="fixed inset-0 z-50 flex flex-col bg-[var(--bg)]">
+          <header
+            className="flex items-center gap-2 px-4 pb-4 border-b border-[var(--border)]"
+            style={{ paddingTop: "calc(1rem + var(--safe-top))" }}
+          >
+            {previewTpl ? (
+              <button
+                type="button"
+                onClick={() => setPreviewTpl(null)}
+                className="text-[var(--accent)] font-semibold"
+              >
+                ‹ Templates
+              </button>
+            ) : (
+              <h2 className="flex-1 text-lg font-bold">Templates</h2>
+            )}
+            <Button
+              variant="secondary"
+              size="sm"
+              className="ms-auto"
+              onClick={() => {
+                setBrowsing(false);
+                setPreviewTpl(null);
+              }}
+            >
+              Close
+            </Button>
+          </header>
+
+          {previewTpl ? (
+            // Preview — full breakdown before committing. Cloning copies the
+            // program into the user's plans; it does NOT activate it.
+            <>
+              <div className="flex-1 overflow-y-auto p-4 flex flex-col gap-4">
+                <div>
+                  <div className="flex items-center gap-2 mb-1">
+                    <h3 className="text-xl font-extrabold flex-1">{previewTpl.name}</h3>
+                    <Badge tone="accent">{previewTpl.days.length} days</Badge>
+                  </div>
+                  <p className="text-sm text-[var(--text-muted)]">{previewTpl.description}</p>
+                </div>
+
+                {previewTpl.days.map((d, i) => (
+                  <Card key={i} padding={0}>
+                    <div className="px-4 pt-3.5 pb-2 flex items-center gap-2">
+                      <span className="font-extrabold text-[var(--text)]">{d.name}</span>
+                      <span className="text-sm text-[var(--text-muted)]">
+                        · {d.exercises.length} exercises
+                      </span>
+                    </div>
+                    <ul className="list-none p-0 m-0 px-3 pb-3 flex flex-col gap-1.5">
+                      {d.exercises.map((ex, j) => (
+                        <li
+                          key={j}
+                          className="flex items-center gap-2 rounded-[var(--radius)] bg-[var(--surface-2)] px-3.5 py-2.5"
+                        >
+                          <span className="flex-1 font-semibold text-[var(--text)] truncate">
+                            {exerciseName.get(ex.exerciseId) ?? ex.exerciseId}
+                          </span>
+                          <span className="text-sm text-[var(--text-muted)] tabular-nums">
+                            {ex.sets} × {ex.reps}
+                          </span>
+                        </li>
+                      ))}
+                    </ul>
+                  </Card>
+                ))}
+              </div>
+
+              <div
+                className="border-t border-[var(--border)] p-4"
+                style={{ paddingBottom: "calc(1rem + var(--safe-bottom))" }}
+              >
+                <Button
+                  variant="primary"
+                  fullWidth
+                  onClick={() => useTemplate(previewTpl.id)}
+                  disabled={cloning}
+                >
+                  {cloning ? "Adding…" : "Add to my programs"}
+                </Button>
+                <p className="mt-2 text-center text-xs text-[var(--text-muted)]">
+                  Copies it into your plans — activate it whenever you&apos;re ready.
+                </p>
+              </div>
+            </>
+          ) : (
+            <div className="flex-1 overflow-y-auto p-4 flex flex-col gap-4">
+              {templates.map((t) => (
+                <Card key={t.id} variant="feature">
+                  <div className="flex items-center gap-2 mb-1">
+                    <h3 className="text-lg font-bold flex-1">{t.name}</h3>
+                    <Badge tone="accent">{t.days.length} days</Badge>
+                  </div>
+                  <p className="text-sm text-[var(--text-muted)] mb-2">{t.description}</p>
+                  <p className={`${EYEBROW} mb-3`}>{t.days.map((d) => d.name).join(" · ")}</p>
+                  <Button variant="primary" fullWidth onClick={() => setPreviewTpl(t)}>
+                    Preview program ›
+                  </Button>
+                </Card>
+              ))}
+            </div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/apps/web/src/app/providers.tsx b/apps/web/src/app/providers.tsx
new file mode 100644
index 0000000..1fac08a
--- /dev/null
+++ b/apps/web/src/app/providers.tsx
@@ -0,0 +1,67 @@
+"use client";
+
+import { useEffect } from "react";
+import { QueryClientProvider } from "@tanstack/react-query";
+import { AuthProvider, useAuth } from "@/lib/auth";
+import { queryClient, startQueryPersistence } from "@/lib/query";
+import { flushQueue } from "@/lib/offline-queue";
+import { hydrateUnit, useSyncUnitFromProfile } from "@/lib/units-store";
+import { LoginScreen } from "@/components/LoginScreen";
+import { ToastProvider } from "@/components/toast/ToastProvider";
+import { ConfirmProvider } from "@/components/ConfirmDialog";
+import { InstallWall, useIsInstalled } from "@/components/InstallWall";
+import { ExerciseDetailSheet } from "@/features/exercise/ExerciseDetailSheet";
+
+/** Signed-in shell: seeds runtime state that depends on an authed session. */
+function AppShell({ children }: { children: React.ReactNode }) {
+  useSyncUnitFromProfile();
+  return (
+    <>
+      {children}
+      <ExerciseDetailSheet />
+    </>
+  );
+}
+
+/** Auth gate: spinner while resolving, login when signed out, app when signed in. */
+function Gate({ children }: { children: React.ReactNode }) {
+  const { user, loading } = useAuth();
+  const installed = useIsInstalled();
+
+  useEffect(() => {
+    hydrateUnit();
+    startQueryPersistence();
+    // Replay any writes queued while offline, now and whenever we reconnect.
+    void flushQueue();
+    const onOnline = () => void flushQueue();
+    window.addEventListener("online", onOnline);
+    return () => window.removeEventListener("online", onOnline);
+  }, []);
+
+  // Install gate first: Rackd is install-only, so anyone in a plain browser tab
+  // sees the "Add to Home Screen" wall before any auth UI. `null` = still detecting.
+  if (installed === null) {
+    return <div className="p-8 text-[var(--text-muted)]">Loading Rackd…</div>;
+  }
+  if (!installed) return <InstallWall />;
+
+  if (loading) {
+    return <div className="p-8 text-[var(--text-muted)]">Loading Rackd…</div>;
+  }
+  if (!user) return <LoginScreen />;
+  return <AppShell>{children}</AppShell>;
+}
+
+export function Providers({ children }: { children: React.ReactNode }) {
+  return (
+    <ToastProvider>
+      <ConfirmProvider>
+        <QueryClientProvider client={queryClient}>
+          <AuthProvider>
+            <Gate>{children}</Gate>
+          </AuthProvider>
+        </QueryClientProvider>
+      </ConfirmProvider>
+    </ToastProvider>
+  );
+}
