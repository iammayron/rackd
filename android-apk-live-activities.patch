--- /dev/null
+++ b/apps/web/src/lib/api.ts
@@ -0,0 +1,56 @@
+import { getSupabase } from "./supabase";
+import { enqueue, isWriteMethod } from "./offline-queue";
+
+/**
+ * Typed fetch wrapper for the JSON API. Attaches the Supabase access token (or
+ * demo token when running without an external auth provider) and throws on
+ * non-2xx so React Query surfaces the error.
+ */
+export async function api<T>(path: string, options?: RequestInit): Promise<T> {
+  let token: string | undefined;
+  try {
+    const { data } = await getSupabase().auth.getSession();
+    token = data.session?.access_token;
+  } catch {}
+  if (!token) {
+    token = "demo-token";
+  }
+
+  const res = await fetch(path, {
+    ...options,
+    headers: {
+      "Content-Type": "application/json",
+      ...(token ? { Authorization: `Bearer ${token}` } : {}),
+      ...options?.headers,
+    },
+  });
+  if (!res.ok) throw new Error(`API ${res.status}: ${await res.text()}`);
+  // 204 / empty body → undefined.
+  const text = await res.text();
+  return (text ? JSON.parse(text) : undefined) as T;
+}
+
+/**
+ * Like `api`, but on a network failure for a write it queues the mutation in
+ * IndexedDB (offline support) and resolves optimistically with `undefined`.
+ * Reads always go straight through (served from the React Query cache when
+ * offline). Use for fire-and-forget mutations that tolerate eventual delivery.
+ */
+export async function apiMutate<T = unknown>(
+  path: string,
+  options: RequestInit & { method: string },
+): Promise<T | undefined> {
+  try {
+    return await api<T>(path, options);
+  } catch (e) {
+    if (isWriteMethod(options.method) && !navigator.onLine) {
+      await enqueue({
+        url: path,
+        method: options.method,
+        body: typeof options.body === "string" ? options.body : undefined,
+      });
+      return undefined;
+    }
+    throw e;
+  }
+}
diff --git a/apps/web/src/lib/auth.tsx b/apps/web/src/lib/auth.tsx
new file mode 100644
index 0000000..ddc9740
--- /dev/null
+++ b/apps/web/src/lib/auth.tsx
@@ -0,0 +1,185 @@
+"use client";
+
+import { createContext, useContext, useEffect, useState } from "react";
+import type { Session, User } from "@supabase/supabase-js";
+import { getSupabase, isAuthConfigured } from "./supabase";
+import { api } from "./api";
+
+/**
+ * Module-level cache of the current user id so the synchronous `getCurrentUserId()`
+ * (used in write paths) stays simple. Kept in sync by AuthProvider.
+ */
+let currentUserId = "";
+export function getCurrentUserId(): string {
+  return currentUserId;
+}
+
+interface AuthState {
+  user: User | null;
+  loading: boolean;
+  signIn: (email: string, password: string) => Promise<{ error?: string }>;
+  signUp: (email: string, password: string) => Promise<{ error?: string }>;
+  signOut: () => Promise<void>;
+  /**
+   * Change the signed-in user's password. Verifies `currentPassword` first by
+   * re-authenticating (Supabase lets a live session set a new password without
+   * the old one — we require it so a borrowed/unlocked session can't).
+   */
+  updatePassword: (currentPassword: string, newPassword: string) => Promise<{ error?: string }>;
+  /** Permanently delete the account (data + auth user), then sign out. */
+  deleteAccount: () => Promise<{ error?: string }>;
+}
+
+const AuthContext = createContext<AuthState | null>(null);
+
+export function useAuth(): AuthState {
+  const ctx = useContext(AuthContext);
+  if (!ctx) throw new Error("useAuth must be used within AuthProvider");
+  return ctx;
+}
+
+export function AuthProvider({ children }: { children: React.ReactNode }) {
+  const [user, setUser] = useState<User | null>(null);
+  const [loading, setLoading] = useState(true);
+
+  useEffect(() => {
+    if (!isAuthConfigured()) {
+      try {
+        const saved = localStorage.getItem("rackd.demo_user");
+        if (saved) {
+          const u = JSON.parse(saved);
+          currentUserId = u.id;
+          setUser(u);
+        } else {
+          // Auto sign in as demo lifter so preview works instantly
+          const demoUser = {
+            id: "demo-user-id",
+            email: "demo@rackd.test",
+            app_metadata: {},
+            user_metadata: { name: "Demo Lifter" },
+            aud: "authenticated",
+            created_at: new Date().toISOString(),
+          } as User;
+          currentUserId = demoUser.id;
+          setUser(demoUser);
+          localStorage.setItem("rackd.demo_user", JSON.stringify(demoUser));
+        }
+      } catch {
+        const fallback = {
+          id: "demo-user-id",
+          email: "demo@rackd.test",
+          app_metadata: {},
+          user_metadata: { name: "Demo Lifter" },
+          aud: "authenticated",
+          created_at: new Date().toISOString(),
+        } as User;
+        currentUserId = fallback.id;
+        setUser(fallback);
+      }
+      setLoading(false);
+      return;
+    }
+
+    const sb = getSupabase();
+
+    // Just track the Supabase session: the API client reads the access token per
+    // request, and the exercise library is seeded once server-side (not per login).
+    function apply(session: Session | null) {
+      currentUserId = session?.user?.id ?? "";
+      setUser(session?.user ?? null);
+    }
+
+    sb.auth.getSession().then(({ data }) => {
+      apply(data.session);
+      setLoading(false);
+    });
+
+    const { data: sub } = sb.auth.onAuthStateChange((_event, session) => {
+      apply(session);
+    });
+    return () => sub.subscription.unsubscribe();
+  }, []);
+
+  const value: AuthState = {
+    user,
+    loading,
+    signIn: async (email, password) => {
+      if (!isAuthConfigured()) {
+        const demoUser = {
+          id: "demo-user-id",
+          email: email || "demo@rackd.test",
+          app_metadata: {},
+          user_metadata: { name: "Demo Lifter" },
+          aud: "authenticated",
+          created_at: new Date().toISOString(),
+        } as User;
+        currentUserId = demoUser.id;
+        setUser(demoUser);
+        localStorage.setItem("rackd.demo_user", JSON.stringify(demoUser));
+        return {};
+      }
+      const { error } = await getSupabase().auth.signInWithPassword({ email, password });
+      return { error: error?.message };
+    },
+    signUp: async (email, password) => {
+      if (!isAuthConfigured()) {
+        const demoUser = {
+          id: "demo-user-id",
+          email: email || "demo@rackd.test",
+          app_metadata: {},
+          user_metadata: { name: "Demo Lifter" },
+          aud: "authenticated",
+          created_at: new Date().toISOString(),
+        } as User;
+        currentUserId = demoUser.id;
+        setUser(demoUser);
+        localStorage.setItem("rackd.demo_user", JSON.stringify(demoUser));
+        return {};
+      }
+      const { error } = await getSupabase().auth.signUp({ email, password });
+      return { error: error?.message };
+    },
+    signOut: async () => {
+      if (!isAuthConfigured()) {
+        currentUserId = "";
+        setUser(null);
+        localStorage.removeItem("rackd.demo_user");
+        return;
+      }
+      await getSupabase().auth.signOut();
+    },
+    updatePassword: async (currentPassword, newPassword) => {
+      if (!isAuthConfigured()) {
+        return {};
+      }
+      const sb = getSupabase();
+      const email = user?.email;
+      if (!email) return { error: "You must be signed in." };
+      // Re-authenticate to prove the current password before changing it.
+      const { error: reauth } = await sb.auth.signInWithPassword({
+        email,
+        password: currentPassword,
+      });
+      if (reauth) return { error: "Current password is incorrect." };
+      const { error } = await sb.auth.updateUser({ password: newPassword });
+      return { error: error?.message };
+    },
+    deleteAccount: async () => {
+      try {
+        await api("/api/account", { method: "DELETE" });
+      } catch (e) {
+        return { error: e instanceof Error ? e.message : "Couldn't delete account." };
+      }
+      if (!isAuthConfigured()) {
+        currentUserId = "";
+        setUser(null);
+        localStorage.removeItem("rackd.demo_user");
+        return {};
+      }
+      await getSupabase().auth.signOut();
+      return {};
+    },
+  };
+
+  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
+}
diff --git a/apps/web/src/lib/day.ts b/apps/web/src/lib/day.ts
new file mode 100644
index 0000000..2662539
--- /dev/null
+++ b/apps/web/src/lib/day.ts
@@ -0,0 +1,16 @@
+const DAY_MS = 86_400_000;
+
+/**
+ * Local-midnight day index for an epoch ms — consecutive calendar days differ by
+ * exactly 1 and any clock time on the same day collapses to one index.
+ *
+ * Lives here rather than in `@rackd/core` because core deliberately keeps `Date`
+ * out ("all Date-handling stays in the caller" — see `currentStreak`,
+ * `weekStartIndex`, `daysAway`, which all take day indices). Going through local
+ * midnight rather than `Math.floor(ms / DAY_MS)` is what keeps DST honest: a
+ * spring-forward day is 23h and a fall-back day 25h of wall-clock time, so UTC
+ * day arithmetic would drift.
+ */
+export function dayIndex(ms: number): number {
+  return Math.floor(new Date(ms).setHours(0, 0, 0, 0) / DAY_MS);
+}
diff --git a/apps/web/src/lib/offline-queue.ts b/apps/web/src/lib/offline-queue.ts
new file mode 100644
index 0000000..e64f40c
--- /dev/null
+++ b/apps/web/src/lib/offline-queue.ts
@@ -0,0 +1,70 @@
+import { get, set, del, keys } from "idb-keyval";
+import { getSupabase } from "./supabase";
+
+/**
+ * IndexedDB-backed FIFO queue of write mutations made while offline. The service
+ * worker can't replay arbitrary authed POSTs, so we persist them here and flush
+ * on reconnect / app mount. Reads are covered separately by the React Query
+ * cache persisted to IndexedDB.
+ */
+interface QueuedMutation {
+  id: string;
+  url: string;
+  method: string;
+  body?: string;
+  createdAt: number;
+}
+
+const PREFIX = "mutation:";
+
+export function isWriteMethod(method: string): boolean {
+  const m = method.toUpperCase();
+  return m === "POST" || m === "PUT" || m === "PATCH" || m === "DELETE";
+}
+
+export async function enqueue(mutation: Omit<QueuedMutation, "id" | "createdAt">): Promise<void> {
+  const entry: QueuedMutation = {
+    ...mutation,
+    id: crypto.randomUUID(),
+    createdAt: Date.now(),
+  };
+  await set(`${PREFIX}${entry.id}`, entry);
+}
+
+/** Replay queued mutations oldest-first; stop on the first failure (still offline). */
+export async function flushQueue(): Promise<number> {
+  const allKeys = await keys();
+  const mutationKeys = allKeys.filter((k) => String(k).startsWith(PREFIX));
+  const entries: QueuedMutation[] = [];
+  for (const key of mutationKeys) {
+    const entry = await get<QueuedMutation>(key);
+    if (entry) entries.push(entry);
+  }
+  entries.sort((a, b) => a.createdAt - b.createdAt);
+
+  let flushed = 0;
+  for (const entry of entries) {
+    const { data } = await getSupabase().auth.getSession();
+    try {
+      const res = await fetch(entry.url, {
+        method: entry.method,
+        headers: {
+          "Content-Type": "application/json",
+          ...(data.session?.access_token
+            ? { Authorization: `Bearer ${data.session.access_token}` }
+            : {}),
+        },
+        body: entry.body,
+      });
+      if (res.ok) {
+        await del(`${PREFIX}${entry.id}`);
+        flushed++;
+      } else {
+        break; // server-side rejection — stop, leave the rest queued
+      }
+    } catch {
+      break; // still offline
+    }
+  }
+  return flushed;
+}
diff --git a/apps/web/src/lib/push.ts b/apps/web/src/lib/push.ts
new file mode 100644
index 0000000..c563fcb
--- /dev/null
+++ b/apps/web/src/lib/push.ts
@@ -0,0 +1,211 @@
+"use client";
+
+import { api } from "@/lib/api";
+import { getCurrentUserId } from "@/lib/auth";
+
+/**
+ * Notification + Web Push helpers.
+ *
+ * iOS quirks (the reason this file exists):
+ * - iOS PWAs DO NOT support the `new Notification(...)` constructor. The only
+ *   way to show a notification on iOS is `ServiceWorkerRegistration.showNotification`.
+ *   So we always go through the SW registration and only fall back to the
+ *   constructor on other platforms.
+ * - Notifications only work in an *installed* (Add-to-Home-Screen) PWA on iOS 16.4+.
+ * - A backgrounded PWA has its JS suspended, so a `setInterval`-driven local
+ *   notification will NOT fire while the app is closed/backgrounded. Reaching a
+ *   locked iPhone requires a *server-side* Web Push delivered at the timer's
+ *   endAt — we register the device subscription here and queue a `scheduledPush`
+ *   (via @rackd/db) that the apps/push sender drains.
+ */
+
+/** Copy for the rest-over notification (kept in one place; the SW has a fallback). */
+const REST_OVER = { title: "Rest over", body: "Time for your next set." } as const;
+
+/** True when we can show notifications at all (permission granted). */
+export function canNotify(): boolean {
+  return typeof Notification !== "undefined" && Notification.permission === "granted";
+}
+
+/**
+ * Request notification permission. Must be called from a user gesture on iOS.
+ * Returns the resulting permission ("granted" | "denied" | "default").
+ */
+export async function requestNotifyPermission(): Promise<NotificationPermission> {
+  if (typeof Notification === "undefined") return "denied";
+  if (Notification.permission !== "default") return Notification.permission;
+  try {
+    return await Notification.requestPermission();
+  } catch {
+    return Notification.permission;
+  }
+}
+
+export interface ExtendedNotificationOptions extends NotificationOptions {
+  renotify?: boolean;
+  vibrate?: number[] | number;
+  actions?: Array<{ action: string; title: string; icon?: string }>;
+}
+
+/**
+ * Show a notification now. Prefers the service-worker registration
+ * (`showNotification`) — the only path that works on iOS — and falls back to the
+ * `Notification` constructor elsewhere. No-ops without permission.
+ */
+export async function showLocalNotification(
+  title: string,
+  options?: ExtendedNotificationOptions,
+): Promise<void> {
+  if (!canNotify()) return;
+  const opts = {
+    icon: "/icons/icon-192.png",
+    badge: "/icons/icon-192.png",
+    tag: "rest-timer",
+    renotify: true,
+    silent: false,
+    requireInteraction: true,
+    vibrate: [400, 150, 400, 150, 600],
+    ...options,
+  } as NotificationOptions;
+  if (typeof navigator !== "undefined" && "serviceWorker" in navigator) {
+    try {
+      const reg = await navigator.serviceWorker.ready;
+      await reg.showNotification(title, opts);
+      return;
+    } catch {
+      // fall through to constructor below
+    }
+  }
+  try {
+    new Notification(title, opts);
+  } catch {
+    // some platforms (iOS) throw on the constructor — already tried the SW path
+  }
+}
+
+function urlBase64ToUint8Array(base64: string): Uint8Array<ArrayBuffer> {
+  const padding = "=".repeat((4 - (base64.length % 4)) % 4);
+  const normalized = (base64 + padding).replace(/-/g, "+").replace(/_/g, "/");
+  const raw = atob(normalized);
+  const out = new Uint8Array(new ArrayBuffer(raw.length));
+  for (let i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
+  return out;
+}
+
+/**
+ * Subscribe this device's SW to the push service using the VAPID public key,
+ * returning the browser `PushSubscription` (or null when unconfigured /
+ * unsupported / permission missing). Reuses an existing subscription if present.
+ */
+export async function ensurePushSubscription(): Promise<PushSubscription | null> {
+  const vapidKey = process.env.NEXT_PUBLIC_VAPID_PUBLIC_KEY;
+  if (!vapidKey) return null;
+  if (typeof navigator === "undefined" || !("serviceWorker" in navigator)) return null;
+  if (!canNotify()) return null;
+  try {
+    const reg = await navigator.serviceWorker.ready;
+    const existing = await reg.pushManager.getSubscription();
+    if (existing) return existing;
+    return await reg.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: urlBase64ToUint8Array(vapidKey),
+    });
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Ensure this device's subscription is stored server-side (via @rackd/db) and
+ * return its persisted row id — the handle the sender targets. Null when push is
+ * unconfigured/unsupported, permission isn't granted, or there's no signed-in
+ * user yet. Idempotent (savePushSubscription dedupes by endpoint).
+ */
+export async function registerPushSubscription(): Promise<string | null> {
+  const sub = await ensurePushSubscription();
+  if (!sub) return null;
+  const json = sub.toJSON();
+  const endpoint = json.endpoint;
+  const p256dh = json.keys?.p256dh;
+  const auth = json.keys?.auth;
+  if (!endpoint || !p256dh || !auth) return null;
+  // Short-circuit when signed out (the API would 401 anyway). Owner is derived
+  // server-side from the JWT — never sent in the payload.
+  if (!getCurrentUserId()) return null;
+  try {
+    const row = await api<{ id: string }>("/api/push-subscriptions", {
+      method: "POST",
+      body: JSON.stringify({
+        endpoint,
+        p256dh,
+        auth,
+        userAgent: typeof navigator !== "undefined" ? navigator.userAgent : undefined,
+      }),
+    });
+    return row.id;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * The id of the scheduled push backing the current rest timer, so add-time can
+ * reschedule it and skip/foreground-fire can cancel it. Module-scoped because
+ * there is exactly one global rest timer.
+ */
+let scheduledPushId: string | null = null;
+
+/**
+ * Queue a server-side rest-over push for `fireAt` (the timer's endAt). Registers
+ * the device if needed. Best-effort: any failure (push off, offline, no user)
+ * silently no-ops — the local foreground notification still covers that case.
+ */
+export async function scheduleRestPush(fireAt: number): Promise<void> {
+  try {
+    // Drop any push still queued from a previous rest so it can't fire late.
+    await cancelRestPush();
+    const subscriptionId = await registerPushSubscription();
+    if (!subscriptionId) return;
+    const row = await api<{ id: string }>("/api/scheduled-pushes", {
+      method: "POST",
+      body: JSON.stringify({
+        subscriptionId,
+        fireAt,
+        title: REST_OVER.title,
+        body: REST_OVER.body,
+      }),
+    });
+    scheduledPushId = row.id;
+  } catch {
+    // best-effort; never block the timer on push wiring
+  }
+}
+
+/** Move the queued push to a new fire time (rest +/- time). No-op if none queued. */
+export async function rescheduleRestPush(fireAt: number): Promise<void> {
+  const id = scheduledPushId;
+  if (!id) return;
+  try {
+    await api(`/api/scheduled-pushes/${id}`, {
+      method: "PUT",
+      body: JSON.stringify({ fireAt }),
+    });
+  } catch {
+    // best-effort
+  }
+}
+
+/**
+ * Cancel the queued push (rest skipped, or the timer fired locally while the app
+ * was foregrounded — no need for the server to also send). No-op if none queued.
+ */
+export async function cancelRestPush(): Promise<void> {
+  const id = scheduledPushId;
+  scheduledPushId = null;
+  if (!id) return;
+  try {
+    await api(`/api/scheduled-pushes/${id}`, { method: "DELETE" });
+  } catch {
+    // best-effort
+  }
+}
