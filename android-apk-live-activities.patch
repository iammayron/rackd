--- /dev/null
+++ b/.cursor/hooks/format.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+# Cursor afterFileEdit hook: format the file the agent just edited, using whatever
+# formatter the project has. Receives the hook payload as JSON on stdin.
+# Never blocks the edit (always exit 0).
+#
+# Cursor project hooks run from the repo root, so reference this script as
+# ".cursor/hooks/format.sh" in .cursor/hooks.json.
+set -euo pipefail
+
+input="$(cat)"
+# afterFileEdit payload carries the edited path; field name varies by version,
+# so try the common ones.
+file="$(printf '%s' "$input" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const j=JSON.parse(s);process.stdout.write(j.file_path||j.filePath||j.path||(j.file&&(j.file.path||j.file.file_path))||"")}catch{process.stdout.write("")}})' 2>/dev/null || true)"
+
+[ -z "$file" ] && exit 0
+[ -f "$file" ] || exit 0
+
+have() { command -v "$1" >/dev/null 2>&1; }
+
+case "$file" in
+  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.json|*.css|*.scss|*.html|*.md|*.mdx|*.yaml|*.yml)
+    if have biome; then biome format --write "$file" >/dev/null 2>&1 || true
+    elif have prettier; then prettier --write "$file" >/dev/null 2>&1 || true
+    else npx --no-install prettier --write "$file" >/dev/null 2>&1 || true
+    fi
+    ;;
+  *.py)
+    if have ruff; then ruff format "$file" >/dev/null 2>&1 || true; fi
+    if have black; then black -q "$file" >/dev/null 2>&1 || true; fi
+    ;;
+  *.go)  have gofmt && gofmt -w "$file" >/dev/null 2>&1 || true ;;
+  *.rs)  have rustfmt && rustfmt "$file" >/dev/null 2>&1 || true ;;
+  *.rb)  have rubocop && rubocop -A "$file" >/dev/null 2>&1 || true ;;
+esac
+exit 0
diff --git a/.cursor/rules/core.mdc b/.cursor/rules/core.mdc
new file mode 100644
index 0000000..b602b94
--- /dev/null
+++ b/.cursor/rules/core.mdc
@@ -0,0 +1,29 @@
+---
+description: Pure domain logic + canonical types conventions for packages/core
+globs: packages/core/**/*.ts
+alwaysApply: false
+---
+
+# packages/core conventions
+
+`packages/core` is **pure domain logic + all domain types**. This is what React
+Native reuses later, so it has **ZERO platform / UI / DB dependencies** — no
+`pg`, no React, no Next, no browser/Node-only APIs. If you reach for one, the
+code belongs elsewhere.
+
+## Types are owned here
+- **All domain types live once** in `src/types.ts`. Everything else imports them; never redeclare a domain shape (DRY).
+- The DB schema (`packages/db/src/schema.ts`) mirrors these types — when a type changes, the schema must follow (see `/db-migrate`).
+
+## Calculations
+- 1RM, plates, volume, progression live in `src/calc.ts` — pure functions, no side effects.
+- **Add a colocated `*.test.ts` for every new pure function.** Follow `calc.test.ts`'s house style: table-driven cases, exact expected numbers, edge/boundary inputs (zero, negative, empty, rounding seams). These are the fast gate (`pnpm --filter @rackd/core test`).
+- Stored/asserted weight is canonical **kg** — assert in kg, never lb.
+
+## Timer
+- `src/timer.ts` is wall-clock: store an absolute `endAt`, recompute `remainingMs(state, now)`. **Always inject `now`** into functions and tests — never call `Date.now()` inside the logic or assert against real wall-clock time.
+
+## Discipline
+- **KISS** — no server/AI/abstraction until a real second caller exists. Rule of three before extracting.
+
+See `@AGENTS.md` for global rules and commands.
diff --git a/.cursor/rules/db.mdc b/.cursor/rules/db.mdc
