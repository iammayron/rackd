+"use client";
+
+import { useMemo } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { currentStreak, weekStartIndex } from "@rackd/core";
+import { useUnit } from "@/lib/units-store";
+import { api } from "@/lib/api";
+import { qk } from "@/lib/query";
+
+interface SessionRow {
+  id: string;
+  startedAt: number;
+}
+
+interface WeeklyVolumeRow {
+  weekStart: number;
+  volume: number;
+}
+
+const DAY_MS = 86_400_000;
+
+/** Local-midnight day index for an epoch ms — consecutive days differ by 1. */
+function dayIndex(ms: number): number {
+  return Math.floor(new Date(ms).setHours(0, 0, 0, 0) / DAY_MS);
+}
+
+/**
+ * Dashboard "This week" card — an upbeat, Duolingo-style snapshot: current day
+ * streak on the left, this week's training volume on the right. Streak lives
+ * here (not in the sessions list) so the two motivating numbers sit together.
+ */
+export function ThisWeekCard() {
+  const { unit, display } = useUnit();
+  const { data: sessions = [] } = useQuery({
+    queryKey: qk.sessions,
+    queryFn: () => api<SessionRow[]>("/api/sessions"),
+  });
+  const { data: weeklyVolume = [] } = useQuery({
+    queryKey: qk.weeklyVolume,
+    queryFn: () => api<WeeklyVolumeRow[]>("/api/stats/weekly-volume"),
+  });
+
+  const streak = useMemo(
+    () =>
+      currentStreak(
+        sessions.map((s) => dayIndex(s.startedAt)),
+        dayIndex(Date.now()),
+      ),
+    [sessions],
+  );
+
+  const volumeKg = useMemo(() => {
+    const now = Date.now();
+    const weekStart = weekStartIndex(dayIndex(now), new Date(now).getDay()) * DAY_MS;
+    return weeklyVolume
+      .filter((w) => w.weekStart >= weekStart)
+      .reduce((sum, w) => sum + w.volume, 0);
+  }, [weeklyVolume]);
+
+  const volume = Math.round(display(volumeKg, 0)).toLocaleString();
+
+  return (
+    <section className="mb-8 rounded-[var(--radius-lg)] border border-[var(--border)] bg-[var(--surface)] p-5">
+      <h2 className="mb-4 text-sm font-semibold uppercase tracking-wide text-[var(--text-muted)]">
+        This week
+      </h2>
+
+      <div className="grid grid-cols-2 gap-4">
+        <div>
+          <p className="text-xs font-semibold uppercase tracking-wide text-[var(--text-muted)]">
+            Streak
+          </p>
+          <p className="mt-1 text-4xl font-extrabold leading-none text-[var(--accent)] tabular-nums">
+            {streak}
+          </p>
+          <p className="mt-1 text-sm text-[var(--text-muted)]">
+            day{streak === 1 ? "" : "s"} {streak > 0 ? "🔥" : ""}
+          </p>
+        </div>
+        <div>
+          <p className="text-xs font-semibold uppercase tracking-wide text-[var(--text-muted)]">
+            Volume
+          </p>
+          <p className="mt-1 text-4xl font-extrabold leading-none text-[var(--accent)] tabular-nums">
+            {volume}
+            <span className="ml-1 text-lg font-bold">{unit}</span>
+          </p>
+          <p className="mt-1 text-sm text-[var(--text-muted)]">this week</p>
+        </div>
+      </div>
+    </section>
+  );
+}
diff --git a/apps/web/src/features/dashboard/VolumeTrendCard.tsx b/apps/web/src/features/dashboard/VolumeTrendCard.tsx
new file mode 100644
index 0000000..edb2fa4
--- /dev/null
+++ b/apps/web/src/features/dashboard/VolumeTrendCard.tsx
@@ -0,0 +1,94 @@
+"use client";
+
+import { useMemo } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { useUnit } from "@/lib/units-store";
+import { api } from "@/lib/api";
+import { qk } from "@/lib/query";
+import { BarChart } from "@/components/Chart";
+
+interface WeeklyVolumeRow {
+  weekStart: number;
+  volume: number;
+}
+
+const WEEKS = 6;
+const DAY_MS = 86_400_000;
+
+/** Compact tonnage label, e.g. "38.2t" (display units already applied). */
+function tonnage(value: number): string {
+  return `${(value / 1000).toFixed(1)}t`;
+}
+
+/** Monday 00:00 UTC of the ISO week containing `ms` — mirrors the API's buckets. */
+function weekStartUTC(ms: number): number {
+  const d = new Date(ms);
+  const since = (d.getUTCDay() + 6) % 7; // Mon=0 … Sun=6
+  return Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate() - since);
+}
+
+/**
+ * Progress-page "Volume" trend — a fixed six-week window so the chart always has
+ * a full row of bars: weeks with no training render as a flat baseline, the ones
+ * with volume rise above it. Reads the same weekly buckets as the stat row.
+ */
+export function VolumeTrendCard() {
+  const { unit, display } = useUnit();
+  const { data: weeklyVolume = [] } = useQuery({
+    queryKey: qk.weeklyVolume,
+    queryFn: () => api<WeeklyVolumeRow[]>("/api/stats/weekly-volume"),
+  });
+
+  // A continuous WEEKS-long series ending this week (missing weeks → 0), plus the
+  // real logged weeks for the delta/tonnage labels.
+  const { series, actual } = useMemo(() => {
+    const byWeek = new Map(weeklyVolume.map((w) => [w.weekStart, w.volume]));
+    const thisMon = weekStartUTC(Date.now());
+    const series: number[] = [];
+    for (let i = WEEKS - 1; i >= 0; i--) {
+      series.push(display(byWeek.get(thisMon - i * 7 * DAY_MS) ?? 0));
+    }
+    const actual = [...weeklyVolume]
+      .sort((a, b) => a.weekStart - b.weekStart)
+      .map((w) => display(w.volume));
+    return { series, actual };
+  }, [weeklyVolume, display]);
+
+  const first = actual[0];
+  const last = actual[actual.length - 1];
+  const deltaPct = first && last && first > 0 ? Math.round(((last - first) / first) * 100) : 0;
+  const up = deltaPct >= 0;
+
+  return (
+    <section className="mb-8 rounded-[var(--radius-lg)] border border-[var(--border)] bg-[var(--surface)] p-5">
+      <div className="mb-4 flex items-center justify-between">
+        <h2 className="text-sm font-semibold uppercase tracking-wide text-[var(--text-muted)]">
+          Volume
+        </h2>
+        {actual.length > 0 && (
+          <span className="text-sm font-semibold text-[var(--text-muted)]">last {WEEKS} weeks</span>
+        )}
+      </div>
+
+      {actual.length === 0 ? (
+        <p className="text-[var(--text-muted)]">
+          No volume yet. Finish a workout to start your trend.
+        </p>
+      ) : (
+        <>
+          <BarChart data={series} unit={unit} />
+          {actual.length >= 2 && (
+            <div className="mt-3 flex items-center justify-between text-sm">
+              <span className="text-[var(--text-muted)] tabular-nums">{tonnage(first!)}</span>
+              <span className="font-bold text-[var(--accent)] tabular-nums">
+                {up ? "+" : ""}
+                {deltaPct}% {up ? "↑" : "↓"}
+              </span>
+              <span className="text-[var(--text-muted)] tabular-nums">{tonnage(last!)}</span>
+            </div>
+          )}
+        </>
+      )}
+    </section>
+  );
+}
diff --git a/apps/web/src/features/dashboard/WeightProgressCard.tsx b/apps/web/src/features/dashboard/WeightProgressCard.tsx
new file mode 100644
index 0000000..0b7b5fa
--- /dev/null
+++ b/apps/web/src/features/dashboard/WeightProgressCard.tsx
@@ -0,0 +1,228 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { api } from "@/lib/api";
+import { queryClient, qk } from "@/lib/query";
+import { Button } from "@rackd/ui";
+import { useUnit } from "@/lib/units-store";
+import { useAuth } from "@/lib/auth";
+import { BottomSheet } from "@/components/BottomSheet";
+
+interface WeightLogRow {
+  id: string;
+  weightKg: number;
+  loggedAt: number;
+}
+
+interface ProfileRow {
+  id: string;
+  currentWeightKg?: number;
+  goalWeightKg?: number;
+}
+
+/** Tiny inline sparkline of the weight trend. Pure SVG, no chart lib. */
+function Sparkline({ values }: { values: number[] }) {
+  const W = 260;
+  const H = 56;
+  const PAD = 4;
+  const path = useMemo(() => {
+    if (values.length === 0) return "";
+    // A single log can't show a trend — draw a flat line across the midline so
+    // the chart still appears (it fills in as more weigh-ins are logged).
+    if (values.length === 1) {
+      const y = (H / 2).toFixed(1);
+      return `M${PAD},${y} L${(W - PAD).toFixed(1)},${y}`;
+    }
+    const min = Math.min(...values);
+    const max = Math.max(...values);
+    const span = max - min || 1;
+    const stepX = (W - PAD * 2) / (values.length - 1);
+    return values
+      .map((v, i) => {
+        const x = PAD + i * stepX;
+        const y = PAD + (1 - (v - min) / span) * (H - PAD * 2);
+        return `${i === 0 ? "M" : "L"}${x.toFixed(1)},${y.toFixed(1)}`;
+      })
+      .join(" ");
+  }, [values]);
+
+  if (values.length === 0) return null;
+  return (
+    <svg
+      viewBox={`0 0 ${W} ${H}`}
+      preserveAspectRatio="none"
+      className="mt-4 h-14 w-full"
+      aria-hidden="true"
+    >
+      <path
+        d={path}
+        fill="none"
+        stroke="var(--accent)"
+        strokeWidth={2}
+        strokeLinecap="round"
+        strokeLinejoin="round"
+      />
+    </svg>
+  );
+}
+
+/** A friendly first name for the sheet subtitle ("Today · Sam"), best-effort. */
+function firstName(meta: Record<string, unknown> | undefined, email: string | undefined): string {
+  const full = typeof meta?.full_name === "string" ? meta.full_name : undefined;
+  const name = full ?? (typeof meta?.name === "string" ? (meta.name as string) : undefined);
+  if (name) return name.trim().split(/\s+/)[0]!;
+  if (email) return email.split("@")[0]!;
+  return "";
+}
+
+export function WeightProgressCard() {
+  const { unit, display, toKg, fmt } = useUnit();
+  const { user } = useAuth();
+
+  const { data: logs = [] } = useQuery({
+    queryKey: qk.bodyWeight,
+    queryFn: () => api<WeightLogRow[]>("/api/body-weight"),
+  });
+  const { data: profile } = useQuery({
+    queryKey: qk.profile,
+    queryFn: () => api<ProfileRow>("/api/profile"),
+  });
+
+  const latestLog = logs.length > 0 ? logs[logs.length - 1] : undefined;
+  const currentKg = profile?.currentWeightKg ?? latestLog?.weightKg;
+  const goalKg = profile?.goalWeightKg;
+
+  // The sheet edits in display units (kg or lb); convert to kg only on save.
+  const [open, setOpen] = useState(false);
+  const [value, setValue] = useState(0);
+  const [saving, setSaving] = useState(false);
+
+  const remaining = useMemo(() => {
+    if (currentKg === undefined || goalKg === undefined) return undefined;
+    return display(Math.abs(currentKg - goalKg));
+  }, [currentKg, goalKg, display]);
+
+  function openSheet() {
+    // Seed the stepper from the current weight (display units), else a sane start.
+    const seed = currentKg !== undefined ? display(currentKg) : unit === "lb" ? 165 : 75;
+    setValue(Math.round(seed * 10) / 10);
+    setOpen(true);
+  }
+
+  function bump(delta: number) {
+    setValue((v) => Math.max(0, Math.round((v + delta) * 10) / 10));
+  }
+
+  async function save() {
+    if (!Number.isFinite(value) || value <= 0 || saving) return;
+    setSaving(true);
+    try {
+      await api("/api/body-weight", {
+        method: "POST",
+        body: JSON.stringify({ weightKg: toKg(value), loggedAt: Date.now() }),
+      });
+      queryClient.invalidateQueries({ queryKey: qk.bodyWeight });
+      queryClient.invalidateQueries({ queryKey: qk.profile });
+      setOpen(false);
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  const hasData = currentKg !== undefined || logs.length > 0;
+  const name = firstName(user?.user_metadata, user?.email ?? undefined);
+
+  return (
+    <section className="mb-8 rounded-[var(--radius-lg)] border border-[var(--border)] bg-[var(--surface)] p-6">
+      <div className="flex items-start justify-between gap-3">
+        <p className="text-xs font-semibold uppercase tracking-wide text-[var(--text-muted)]">
+          Weight progress
+        </p>
+        <button
+          type="button"
+          onClick={openSheet}
+          className="text-sm font-semibold text-[var(--accent)]"
+        >
+          Log weight
+        </button>
+      </div>
+
+      {hasData ? (
+        <>
+          <div className="mt-3 flex items-end gap-10">
+            <div>
+              <p className="text-xs font-semibold uppercase tracking-wide text-[var(--text-muted)]">
+                Current
+              </p>
+              <p className="mt-1 text-3xl font-extrabold leading-none tabular-nums">
+                {currentKg !== undefined ? fmt(currentKg) : "—"}
+              </p>
+            </div>
+            <div>
+              <p className="text-xs font-semibold uppercase tracking-wide text-[var(--text-muted)]">
+                Goal
+              </p>
+              <p className="mt-1 text-3xl font-extrabold leading-none tabular-nums">
+                {goalKg !== undefined ? fmt(goalKg) : "—"}
+              </p>
+            </div>
+          </div>
+          {remaining !== undefined && (
+            <p className="mt-2 text-sm text-[var(--text-muted)]">
+              {remaining > 0 ? `${remaining} ${unit} to go` : "Goal reached 🎉"}
+            </p>
+          )}
+          <Sparkline values={logs.map((l) => display(l.weightKg))} />
+        </>
+      ) : (
+        <p className="mt-2 text-[var(--text-muted)]">
+          No weight logged yet. Log your weight to track progress toward your goal.
+        </p>
+      )}
+
+      <BottomSheet
+        open={open}
+        onClose={() => setOpen(false)}
+        title="Log weight"
+        subtitle={name ? `Today · ${name}` : "Today"}
+      >
+        <div className="px-1 pt-2">
+          <div className="flex items-center justify-center gap-6">
+            <button
+              type="button"
+              aria-label="Decrease"
+              onClick={() => bump(-0.1)}
+              className="flex h-14 w-14 items-center justify-center rounded-full bg-[var(--surface-2)] text-2xl font-bold text-[var(--text)] active:scale-95"
+            >
+              −
+            </button>
+            <div className="min-w-[7.5rem] text-center">
+              <span className="text-5xl font-extrabold tabular-nums">{value.toFixed(1)}</span>
+              <span className="ml-1.5 text-xl font-bold text-[var(--text-muted)]">{unit}</span>
+            </div>
+            <button
+              type="button"
+              aria-label="Increase"
+              onClick={() => bump(0.1)}
+              className="flex h-14 w-14 items-center justify-center rounded-full bg-[var(--surface-2)] text-2xl font-bold text-[var(--text)] active:scale-95"
+            >
+              +
+            </button>
+          </div>
+
+          <Button
+            variant="primary"
+            size="lg"
+            fullWidth
+            onClick={save}
+            disabled={saving || value <= 0}
+            className="mt-7"
+          >
+            {saving ? "Saving…" : "Save"}
+          </Button>
+        </div>
+      </BottomSheet>
+    </section>
+  );
+}
diff --git a/apps/web/src/features/exercise/ExerciseDemo.tsx b/apps/web/src/features/exercise/ExerciseDemo.tsx
new file mode 100644
index 0000000..32db770
--- /dev/null
+++ b/apps/web/src/features/exercise/ExerciseDemo.tsx
@@ -0,0 +1,100 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { useBodyScrollLock } from "@/lib/scroll-lock";
+
+/**
+ * Looping exercise demo from the source's start/end photos (free-exercise-db
+ * ships 2 frames per exercise). Cross-fading them on a loop reads as a short
+ * motion clip — no gif/video asset needed. Tap to open a fullscreen lightbox
+ * (works on iOS, where requestFullscreen on non-video elements is unsupported).
+ * Honors prefers-reduced-motion (static first frame).
+ */
+
+const FADE_MS = 700;
+
+export function ExerciseDemo({
+  frames,
+  alt,
+  holdMs = 1400,
+}: {
+  frames: string[];
+  alt: string;
+  holdMs?: number;
+}) {
+  const [active, setActive] = useState(0);
+  const [open, setOpen] = useState(false);
+
+  // Advance frames; the fade is a CSS opacity transition so the swap eases
+  // rather than cuts. holdMs is the dwell on a frame between cross-fades.
+  useEffect(() => {
+    if (frames.length < 2) return;
+    if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) return;
+    const t = setInterval(() => setActive((i) => (i + 1) % frames.length), holdMs);
+    return () => clearInterval(t);
+  }, [frames.length, holdMs]);
+
+  // Esc to close. Background scroll is locked through the shared counter — this
+  // lightbox opens from inside a sheet that already holds a lock, and a
+  // hand-rolled save/restore here would hand the page back while the sheet is
+  // still up.
+  useEffect(() => {
+    if (!open) return;
+    const onKey = (e: KeyboardEvent) => e.key === "Escape" && setOpen(false);
+    window.addEventListener("keydown", onKey);
+    return () => window.removeEventListener("keydown", onKey);
+  }, [open]);
+  useBodyScrollLock(open);
+
+  const layers = (fit: "cover" | "contain") =>
+    frames.map((url, i) => (
+      // eslint-disable-next-line @next/next/no-img-element
+      <img
+        key={i}
+        src={url}
+        alt={i === 0 ? alt : ""}
+        className={`absolute inset-0 h-full w-full ${fit === "cover" ? "object-cover" : "object-contain"} ease-in-out`}
+        style={{ opacity: i === active ? 1 : 0, transition: `opacity ${FADE_MS}ms` }}
+      />
+    ));
+
+  return (
+    <>
+      <button
+        type="button"
+        onClick={() => setOpen(true)}
+        aria-label={`Expand ${alt} demonstration`}
+        className="absolute inset-0 m-0 border-0 bg-transparent p-0 cursor-zoom-in"
+      >
+        {layers("cover")}
+        <span
+          aria-hidden="true"
+          className="absolute bottom-2 right-2 flex h-7 w-7 items-center justify-center rounded-full bg-black/45 text-white text-sm leading-none backdrop-blur-sm"
+        >
+          ⤢
+        </span>
+      </button>
+
+      {open && (
+        <div
+          onClick={() => setOpen(false)}
+          role="dialog"
+          aria-modal="true"
+          aria-label={`${alt} demonstration`}
+          className="fixed inset-0 z-[100] flex items-center justify-center bg-black/85 p-4"
+        >
+          <div className="relative w-full max-w-2xl" style={{ height: "min(80vh, 90vw)" }}>
+            {layers("contain")}
+          </div>
+          <button
+            type="button"
+            aria-label="Close"
+            className="absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/15 text-white text-xl leading-none"
+          >
+            ✕
+          </button>
+        </div>
+      )}
+    </>
+  );
+}
diff --git a/apps/web/src/features/exercise/ExerciseDetail.tsx b/apps/web/src/features/exercise/ExerciseDetail.tsx
new file mode 100644
index 0000000..7aee039
--- /dev/null
+++ b/apps/web/src/features/exercise/ExerciseDetail.tsx
@@ -0,0 +1,261 @@
+"use client";
+
+import { useMemo } from "react";
+import { suggestReplacements } from "@rackd/core";
+import {
+  Card,
+  Badge,
+  MuscleVisualizer,
+  exerciseGradient,
+  type MuscleInvolvementView,
+} from "@rackd/ui";
+import { useQuery } from "@tanstack/react-query";
+import { api } from "@/lib/api";
+import { qk } from "@/lib/query";
+import { useUnit } from "@/lib/units-store";
+import { LineChart, BarChart } from "@/components/Chart";
+import { ExerciseDemo } from "./ExerciseDemo";
+
+interface ExerciseMediaView {
+  kind: string;
+  url: string;
+  width?: number | null;
+  height?: number | null;
+  order: number;
+}
+
+interface ExerciseRow {
+  id: string;
+  name: string;
+  primaryMuscle: string;
+  secondaryMuscles?: string[];
+  equipment: string;
+  category: string;
+  instructions?: string;
+  formCues?: string[];
+  thumbnailUrl?: string;
+  clipUrl?: string;
+  clipUrlWebm?: string;
+  // Exercise-data-platform fields (present on seeded library rows).
+  movementPattern?: string;
+  mechanic?: string;
+  /** Fine-grained muscle involvement + activation (from getExerciseDetail). */
+  muscles?: MuscleInvolvementView[];
+  /** Ordered media (the [id] detail route joins this). */
+  media?: ExerciseMediaView[];
+}
+
+/** Per-session stat point for one exercise (mirrors the /stats route). */
+interface ExerciseStatPoint {
+  sessionId: string;
+  date: number;
+  best1rm: number;
+  volume: number;
+  topWeight: number;
+}
+
+const EYEBROW = "text-[var(--text-muted)] text-xs font-bold uppercase tracking-wider mb-3";
+
+const cap = (s: string) =>
+  !s ? s : s.toLowerCase() === "fullbody" ? "Full body" : s.charAt(0).toUpperCase() + s.slice(1);
+
+/** Instructions are a single string; split into steps on newlines, else one block. */
+function steps(instructions?: string): string[] {
+  if (!instructions) return [];
+  const lines = instructions
+    .split(/\r?\n+/)
+    .map((l) => l.replace(/^\s*\d+[.)]\s*/, "").trim())
+    .filter(Boolean);
+  return lines.length ? lines : [instructions.trim()];
+}
+
+/**
+ * The exercise-detail body, shared by the slide-up sheet and the deep-link page.
+ * `onSelectExercise` decides what a "Similar exercise" tap does — swap the sheet
+ * (store.open) or navigate the page (router.push).
+ */
+export function ExerciseDetail({
+  id,
+  onSelectExercise,
+}: {
+  id: string;
+  onSelectExercise: (id: string) => void;
+}) {
+  const { unit, display } = useUnit();
+
+  const { data: ex } = useQuery({
+    queryKey: qk.exercise(id),
+    queryFn: () => api<ExerciseRow>(`/api/exercises/${id}`),
+    enabled: Boolean(id),
+  });
+  const { data: all = [] } = useQuery({
+    queryKey: qk.exercises,
+    queryFn: () => api<ExerciseRow[]>("/api/exercises"),
+  });
+  const { data: points = [] } = useQuery({
+    queryKey: qk.exerciseStats(id),
+    queryFn: () => api<ExerciseStatPoint[]>(`/api/exercises/${id}/stats`),
+    enabled: Boolean(id),
+  });
+
+  const similar = useMemo(() => {
+    if (!ex) return [];
+    return suggestReplacements(all, {
+      id: ex.id,
+      primaryMuscle: ex.primaryMuscle,
+      equipment: ex.equipment,
+      secondaryMuscles: [...(ex.secondaryMuscles ?? [])],
+      movementPattern: ex.movementPattern,
+      mechanic: ex.mechanic,
+    }).slice(0, 5);
+  }, [all, ex]);
+
+  if (!ex) {
+    return <p className="px-1 py-6 text-[var(--text-muted)]">Exercise not found.</p>;
+  }
+
+  const secondary = [...(ex.secondaryMuscles ?? [])];
+  // Demonstration frames (free-exercise-db ships start/end photos per exercise).
+  const frames = (ex.media ?? []).filter((m) => m.kind === "image").map((m) => m.url);
+  const heroImage = frames[0] ?? ex.thumbnailUrl;
+  const initials = ex.name
+    .split(" ")
+    .map((w) => w[0])
+    .join("")
+    .slice(0, 2)
+    .toUpperCase();
+  const instructionSteps = steps(ex.instructions);
+  const cues = ex.formCues ?? [];
+
+  // Volume over the last 6 sessions, left-padded so a sparse history reads as a
+  // trend (one bar + a flat baseline) instead of a single full-width block —
+  // matching the Progress page's volume chart.
+  const VOL_WINDOW = 6;
+  const recentVolume = points.slice(-VOL_WINDOW).map((p) => display(p.volume));
+  const volumeSeries = [
+    ...Array(Math.max(0, VOL_WINDOW - recentVolume.length)).fill(0),
+    ...recentVolume,
+  ];
+
+  return (
+    <div className="flex flex-col gap-4">
+      {/* Hero media — autoplaying clip or the demo image; tap to view fullscreen. */}
+      <div
+        className="relative -mx-4 -mt-2 h-[180px] flex items-center justify-center overflow-hidden"
+        style={{ background: exerciseGradient(ex.primaryMuscle) }}
+      >
+        {ex.clipUrl ? (
+          <video
+            src={ex.clipUrl}
+            poster={ex.thumbnailUrl}
+            muted
+            loop
+            autoPlay
+            playsInline
+            onClick={(e) => e.currentTarget.requestFullscreen?.()}
+            className="absolute inset-0 h-full w-full object-cover cursor-pointer"
+          />
+        ) : frames.length > 1 ? (
+          <ExerciseDemo frames={frames} alt={ex.name} />
+        ) : heroImage ? (
+          // eslint-disable-next-line @next/next/no-img-element
+          <img
+            src={heroImage}
+            alt={ex.name}
+            onClick={(e) => e.currentTarget.requestFullscreen?.()}
+            className="absolute inset-0 h-full w-full object-cover cursor-pointer"
+          />
+        ) : (
+          <span
+            aria-hidden="true"
+            className="text-[64px] font-extrabold tracking-tight"
+            style={{ color: "rgba(255,255,255,0.85)" }}
+          >
+            {initials}
+          </span>
+        )}
+      </div>
+
+      <div className="flex gap-2 flex-wrap">
+        <Badge tone="accent">{cap(ex.primaryMuscle)}</Badge>
+        <Badge tone="neutral">{cap(ex.equipment)}</Badge>
+      </div>
+
+      {instructionSteps.length > 0 && (
+        <Card>
+          <div className={EYEBROW}>How to perform</div>
+          <ol className="m-0 p-0 list-none flex flex-col gap-3">
+            {instructionSteps.map((step, i) => (
+              <li key={i} className="flex gap-3 items-start">
+                <span
+                  className="flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-[13px] font-extrabold mt-px"
+                  style={{ background: "var(--accent-wash)", color: "var(--accent)" }}
+                >
+                  {i + 1}
+                </span>
+                <span className="text-[14.5px] leading-normal">{step}</span>
+              </li>
+            ))}
+          </ol>
+        </Card>
+      )}
+
+      {cues.length > 0 && (
+        <Card>
+          <div className={EYEBROW}>Form cues</div>
+          <ul className="m-0 p-0 list-none flex flex-col gap-2.5">
+            {cues.map((cue, i) => (
+              <li key={i} className="flex gap-2.5 items-start">
+                <span className="mt-px text-[var(--accent)] font-extrabold" aria-hidden="true">
+                  ✓
+                </span>
+                <span className="text-[14.5px] leading-normal">{cue}</span>
+              </li>
+            ))}
+          </ul>
+        </Card>
+      )}
+
+      <Card>
+        <div className={EYEBROW}>Muscles worked</div>
+        <MuscleVisualizer primary={ex.primaryMuscle} secondary={secondary} muscles={ex.muscles} />
+      </Card>
+
+      {similar.length > 0 && (
+        <Card>
+          <div className={EYEBROW}>Similar exercises</div>
+          <ul className="m-0 p-0 list-none flex flex-col gap-1">
+            {similar.map((s) => (
+              <li key={s.id}>
+                <button
+                  type="button"
+                  onClick={() => onSelectExercise(s.id)}
+                  className="flex w-full items-center gap-3 min-h-11 py-2 text-left text-[var(--text)]"
+                >
+                  <span className="font-semibold">{s.name}</span>
+                  <span className="ms-auto text-sm text-[var(--text-muted)]">
+                    {cap(s.primaryMuscle)} · {cap(s.equipment)}
+                  </span>
+                  <span className="text-[var(--text-muted)]">›</span>
+                </button>
+              </li>
+            ))}
+          </ul>
+        </Card>
+      )}
+
+      {points.length > 0 && (
+        <>
+          <Card variant="feature">
+            <div className={EYEBROW}>Est 1RM over time</div>
+            <LineChart data={points.map((p) => display(p.best1rm))} unit={unit} />
+          </Card>
+          <Card variant="feature">
+            <div className={EYEBROW}>Volume · last {VOL_WINDOW} sessions</div>
+            <BarChart data={volumeSeries} unit={unit} />
+          </Card>
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/apps/web/src/features/exercise/ExerciseDetailPreview.tsx b/apps/web/src/features/exercise/ExerciseDetailPreview.tsx
new file mode 100644
index 0000000..5433366
--- /dev/null
+++ b/apps/web/src/features/exercise/ExerciseDetailPreview.tsx
@@ -0,0 +1,84 @@
+"use client";
+
+import { useQuery } from "@tanstack/react-query";
+import { api } from "@/lib/api";
+import { qk } from "@/lib/query";
+import { ExerciseDetail } from "./ExerciseDetail";
+
+interface ExerciseHeadRow {
+  name: string;
+  category?: string;
+}
+
+const cap = (s: string) =>
+  !s ? s : s.toLowerCase() === "fullbody" ? "Full body" : s.charAt(0).toUpperCase() + s.slice(1);
+
+/**
+ * Full-detail exercise preview shown above a picker sheet. Renders the same rich
+ * {@link ExerciseDetail} body the rest of the app uses (hero media, how-to,
+ * form cues, muscle visualizer, history charts) plus a pinned primary action
+ * ("Swap to…" / "Add…"). Sits at z-[110] so it clears the picker's z-[100]
+ * BottomSheet. Tapping a "Similar exercise" swaps the preview in place via
+ * `onSelectExercise`.
+ */
+export function ExerciseDetailPreview({
+  id,
+  onClose,
+  onSelectExercise,
+  action,
+}: {
+  id: string;
+  onClose: () => void;
+  onSelectExercise: (id: string) => void;
+  /** Pinned primary action; `onClick` receives nothing — caller closes over `id`. */
+  action: { label: string; onClick: () => void };
+}) {
+  const { data: ex } = useQuery({
+    queryKey: qk.exercise(id),
+    queryFn: () => api<ExerciseHeadRow>(`/api/exercises/${id}`),
+    enabled: Boolean(id),
+  });
+
+  return (
+    <div
+      className="fixed inset-0 z-[110] flex items-end sm:items-center justify-center bg-black/60"
+      onClick={onClose}
+    >
+      <div
+        className="rk-squircle-corners w-[min(440px,100%)] max-h-[88vh] flex flex-col overflow-hidden bg-[var(--bg)] rounded-t-[var(--radius-lg)] sm:rounded-[var(--radius-lg)] shadow-[var(--shadow-lg)]"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <div className="flex items-baseline gap-3 px-4 pt-4 pb-2 shrink-0">
+          <h2 className="flex-1 min-w-0 truncate text-[17px] font-extrabold">
+            {ex?.name ?? "Preview"}
+          </h2>
+          {ex?.category && (
+            <span className="text-[13px] text-[var(--text-muted)]">{cap(ex.category)}</span>
+          )}
+          <button
+            type="button"
+            onClick={onClose}
+            aria-label="Close"
+            className="shrink-0 text-lg text-[var(--text-muted)]"
+          >
+            ×
+          </button>
+        </div>
+
+        <div className="overflow-y-auto px-4 pt-2 pb-3 flex-1">
+          <ExerciseDetail id={id} onSelectExercise={onSelectExercise} />
+        </div>
+
+        <div className="shrink-0 border-t border-[var(--border)] bg-[var(--bg)] px-4 pt-3 pb-[calc(16px+env(safe-area-inset-bottom))]">
+          <button
+            type="button"
+            onClick={action.onClick}
+            className="w-full min-h-11 rounded-[var(--radius)] bg-[var(--accent)] text-white font-bold focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
+          >
+            {action.label}
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
