+        ],
+      },
+    ],
+  },
+  {
+    id: "tpl_ppl",
+    name: "Push / Pull / Legs",
+    description: "Classic 3-day split. Run twice a week for 6 sessions.",
+    days: [
+      {
+        name: "Push",
