index 0000000..45a6c35
--- /dev/null
+++ b/apps/web/src/app/globals.css
@@ -0,0 +1,198 @@
+@import "tailwindcss";
+@import "../../node_modules/preline/variants.css";
+@import "@rackd/ui/tokens.css";
+
+/* Let Tailwind scan Preline's JS so its component classes are generated. */
+@source "../../node_modules/preline/dist/*.js";
+
+html,
+body {
+  background: var(--bg);
+  color: var(--text);
+  font-family: var(--font-sans);
+  -webkit-tap-highlight-color: transparent;
+}
+
+/* App is a phone on the web: center a phone-width column on desktop. */
+.app-shell {
+  max-width: 480px;
+  margin: 0 auto;
+  min-height: 100dvh;
+  /* iOS PWA safe areas: clear the status bar / notch (top) + landscape notch
+     (sides). Bottom (home indicator) is handled on the sticky <nav> itself,
+     since sticky bottom-0 anchors to the viewport, not this padding box. */
+  padding-top: env(safe-area-inset-top);
+  padding-left: env(safe-area-inset-left);
+  padding-right: env(safe-area-inset-right);
+}
+
+/* Full-height page wrappers must subtract the top inset the shell added, or
+   they overflow by that amount and the sticky nav drifts off-screen. */
+.app-shell .min-h-\[100dvh\] {
+  min-height: calc(100dvh - env(safe-area-inset-top));
+}
+
+/* Opaque strip over the status-bar inset so scrolled content never shows
+   through the translucent bar. Above page content (z-30) + sticky headers,
+   below toasts (z-50) and sheets (z-100). */
+.rk-status-scrim {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  height: var(--safe-top);
+  background: var(--bg);
+  z-index: 40;
+  pointer-events: none;
+}
+
+/* Portrait-only guard. The manifest `orientation` + screen.orientation.lock()
+   only work on Android/Chromium; iOS ignores both, so this CSS overlay is the
+   real enforcement there. Hidden by default; shown only when a *phone-sized*
+   viewport is held in landscape. `max-height: 500px` is the key: in landscape a
+   phone's short side becomes the height (~360–430px), so this catches phones
+   but never desktop/tablet windows or a portrait phone — desktop is untouched. */
+.rk-rotate-guard {
+  display: none;
+}
+
+@media (orientation: landscape) and (max-height: 500px) {
+  .rk-rotate-guard {
+    position: fixed;
+    inset: 0;
+    z-index: 9999; /* above sticky nav, toasts, and Preline modals */
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    gap: var(--space-4);
+    padding: max(var(--space-6), env(safe-area-inset-top))
+      max(var(--space-6), env(safe-area-inset-right))
+      max(var(--space-6), env(safe-area-inset-bottom))
+      max(var(--space-6), env(safe-area-inset-left));
+    background: var(--bg);
+    color: var(--text);
+    text-align: center;
+  }
+
+  .rk-rotate-guard svg {
+    color: var(--accent);
+    animation: rk-rotate-hint 2.4s var(--ease-in-out) infinite;
+  }
+
+  .rk-rotate-guard__text {
+    margin: 0;
+    max-width: 22ch;
+    font-size: var(--text-lg);
+    font-weight: var(--fw-semibold);
+    line-height: var(--leading-snug);
+  }
+}
+
+@keyframes rk-rotate-hint {
+  0%,
+  60%,
+  100% {
+    transform: rotate(0deg);
+  }
+  30% {
+    transform: rotate(-90deg);
+  }
+}
+
+/* iOS-style squircle (continuous rounded corners / superellipse). Baseline is an
+   SVG superellipse applied as a CSS mask, which works reliably in WebKit (this is
+   an installed iPhone PWA) — `corner-shape: superellipse()` is too patchy to rely
+   on. The mask stretches to the box (mask-size: 100% 100% + preserveAspectRatio
+   none), so it's size-agnostic and reusable for any avatar/icon. `overflow:hidden`
+   clips child media (images/video) to the same shape. */
+.rk-squircle {
+  overflow: hidden;
+  /* Fallback radius so corners are NEVER hard 90° even if the mask fails. */
+  border-radius: 30%;
+  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%20100%20100%27%20preserveAspectRatio=%27none%27%3E%3Cpath%20d=%27M50%200C12%200%200%2012%200%2050C0%2088%2012%20100%2050%20100C88%20100%20100%2088%20100%2050C100%2012%2088%200%2050%200Z%27%20fill=%27white%27/%3E%3C/svg%3E");
+  mask-image: url("data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%20100%20100%27%20preserveAspectRatio=%27none%27%3E%3Cpath%20d=%27M50%200C12%200%200%2012%200%2050C0%2088%2012%20100%2050%20100C88%20100%20100%2088%20100%2050C100%2012%2088%200%2050%200Z%27%20fill=%27white%27/%3E%3C/svg%3E");
+  -webkit-mask-size: 100% 100%;
+  mask-size: 100% 100%;
+  -webkit-mask-repeat: no-repeat;
+  mask-repeat: no-repeat;
+}
+
+/* Progressive enhancement: where the native continuous-corner primitive is
+   supported, drop the rasterized mask and use a true superellipse on top of a
+   real border-radius (corner-shape does nothing without one). */
+@supports (corner-shape: superellipse(1)) {
+  .rk-squircle {
+    -webkit-mask-image: none;
+    mask-image: none;
+    border-radius: 30%;
+    corner-shape: superellipse(2.5);
+  }
+}
+
+/* ─── Squircle corners, system-wide (progressive enhancement) ──────────────
+   iOS-style continuous corners on standard ROUNDED-RECTANGLE surfaces. Unlike
+   `.rk-squircle` (an SVG mask, only for the solid ExerciseThumb), this layers a
+   true superellipse on top of the element's EXISTING border-radius — so borders,
+   box-shadows, focus rings, overflow and content are all preserved. It's pure
+   progressive enhancement: browsers without `corner-shape` keep their normal
+   rounded corners, so there's nothing to fall back on.
+
+   The single source of truth for the squircle treatment. We opt elements in by:
+   (a) the standard Tailwind rectangle-radius utilities the app already uses, and
+   (b) a shared `.rk-squircle-corners` class for inline-styled design-system
+   components (Card/Button/Input) + key surfaces (BottomSheet) that don't carry a
+   `rounded-*` utility.
+
+   Deliberately EXCLUDES fully-round shapes — `rounded-full`, pill radii
+   (--radius-pill), avatars, circular buttons — because a superellipse on a
+   circle reads as a wobble, not a squircle. We never use `*` and never match
+   `rounded-full`, so those stay perfectly round. */
+@supports (corner-shape: superellipse(1)) {
+  .rk-squircle-corners,
+  .rounded-md,
+  .rounded-lg,
+  .rounded-xl,
+  .rounded-2xl,
+  .rounded-3xl {
+    corner-shape: superellipse(2.5);
+  }
+}
+
+/* Bottom-sheet entrance: panel slides up, backdrop fades in. Reduced-motion is
+   handled globally below (durations collapse to ~0). */
+@keyframes rk-sheet-up {
+  from {
+    transform: translateY(100%);
+  }
+  to {
+    transform: translateY(0);
+  }
+}
+@keyframes rk-fade-in {
+  from {
+    opacity: 0;
+  }
+  to {
+    opacity: 1;
+  }
+}
+.rk-sheet-up {
+  animation: rk-sheet-up var(--dur-slow) var(--ease-out);
+}
+.rk-backdrop-in {
+  animation: rk-fade-in var(--dur) ease;
+}
+
+/* Respect reduced-motion: calm the press-shrink, ring sweep, and any animation.
+   Rackd's motion is quick and confident, never essential — safe to neutralize. */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
