@@ -0,0 +1,91 @@
+"use client";
+
+import { BottomSheet } from "@/components/BottomSheet";
+
+export interface ProgramChoice {
+  id: string;
+  name: string;
+  /** Optional one-line meta (e.g. schedule mode, day count). */
+  meta?: string;
+}
+
+/**
+ * Bottom-sheet picker for choosing which program to activate. Shared by the Home
+ * "no active program" prompt (Rule 1) and the editor's delete-active flow
+ * (Rule 3). Selecting a row calls `onSelect` and closes; dismissing leaves the
+ * current selection untouched.
+ */
+export function ActivateProgramSheet({
+  open,
+  onClose,
+  programs,
+  activeId,
+  onSelect,
+  title = "Activate a program",
+}: {
+  open: boolean;
+  onClose: () => void;
+  programs: ProgramChoice[];
+  activeId?: string;
+  onSelect: (programId: string) => void;
+  title?: string;
+}) {
+  return (
+    <BottomSheet open={open} onClose={onClose} title={title}>
+      {programs.length === 0 ? (
+        <p className="px-1 py-6 text-center text-sm text-[var(--text-muted)]">
+          No programs to activate.
+        </p>
+      ) : (
+        <ul className="m-0 flex list-none flex-col gap-2 p-0">
+          {programs.map((p) => {
+            const selected = p.id === activeId;
+            return (
+              <li key={p.id}>
+                <button
+                  type="button"
+                  onClick={() => onSelect(p.id)}
+                  aria-pressed={selected}
+                  className={`rk-squircle-corners flex w-full items-center justify-between gap-3 rounded-[var(--radius-md)] border px-4 py-3.5 text-left ${
+                    selected
+                      ? "border-transparent bg-[var(--accent)]"
+                      : "border-[var(--border)] bg-[var(--surface)]"
+                  }`}
+                >
+                  <span className="min-w-0">
+                    <span
+                      className="block truncate font-bold"
+                      style={{ color: selected ? "var(--text-on-accent)" : "var(--text)" }}
+                    >
+                      {p.name}
+                    </span>
+                    {p.meta && (
+                      <span
+                        className="block truncate text-sm"
+                        style={
+                          selected
+                            ? { color: "var(--text-on-accent)", opacity: 0.85 }
+                            : { color: "var(--text-muted)" }
+                        }
+                      >
+                        {p.meta}
+                      </span>
+                    )}
+                  </span>
+                  {selected && (
+                    <span
+                      className="shrink-0 text-sm font-bold"
+                      style={{ color: "var(--text-on-accent)" }}
+                    >
+                      Active
+                    </span>
+                  )}
+                </button>
+              </li>
+            );
+          })}
+        </ul>
+      )}
+    </BottomSheet>
+  );
+}
diff --git a/apps/web/src/components/AdvancedSelect.tsx b/apps/web/src/components/AdvancedSelect.tsx
new file mode 100644
index 0000000..ae0e8c4
--- /dev/null
+++ b/apps/web/src/components/AdvancedSelect.tsx
@@ -0,0 +1,99 @@
+"use client";
+
+import { useEffect, useRef } from "react";
+
+export interface SelectOption {
+  value: string;
+  label: string;
+}
+
+type PrelineWindow = Window & {
+  HSStaticMethods?: { autoInit: (collection?: string | string[]) => void };
+};
+
+/**
+ * React wrapper around Preline's advanced select (data-hs-select).
+ *
+ * Preline 4 exposes only `window.HSStaticMethods` (not `HSSelect`), so we
+ * enhance via `autoInit("select")` once the options have rendered. Preline
+ * mirrors the choice onto the underlying native <select> and dispatches a
+ * native `change`, which our onChange picks up — no Preline instance needed.
+ */
+export function AdvancedSelect({
+  value,
+  options,
+  onChange,
+  placeholder = "Select…",
+}: {
+  value: string;
+  options: SelectOption[];
+  onChange: (value: string) => void;
+  placeholder?: string;
+}) {
+  const ref = useRef<HTMLSelectElement>(null);
+  const optKey = options.map((o) => o.value).join("|");
+
+  useEffect(() => {
+    if (!ref.current || options.length === 0) return;
+    let cancelled = false;
+    (async () => {
+      await import("preline");
+      if (cancelled) return;
+      requestAnimationFrame(() => {
+        (window as PrelineWindow).HSStaticMethods?.autoInit("select");
+      });
+    })();
+    return () => {
+      cancelled = true;
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [optKey]);
+
+  const config = {
+    placeholder,
+    toggleTag: '<button type="button" aria-expanded="false"></button>',
+    toggleClasses:
+      "hs-select-disabled:pointer-events-none hs-select-disabled:opacity-50 relative py-3 ps-4 pe-9 flex gap-x-2 text-nowrap w-full cursor-pointer bg-[var(--surface)] border border-[var(--border)] rounded-[var(--radius-sm)] text-start text-base text-[var(--text)] focus:outline-hidden focus:ring-2 focus:ring-[var(--accent)]",
+    dropdownClasses:
+      "mt-2 z-50 w-full max-h-72 p-1 space-y-0.5 bg-[var(--surface)] border border-[var(--border)] rounded-[var(--radius-sm)] overflow-hidden overflow-y-auto",
+    optionClasses:
+      "py-2 px-4 w-full text-base text-[var(--text)] cursor-pointer hover:bg-[var(--surface-2)] rounded-[var(--radius-sm)] focus:outline-hidden focus:bg-[var(--surface-2)]",
+    optionTemplate:
+      '<div class="flex justify-between items-center w-full"><span data-title></span><span class="hidden hs-selected:block"><svg class="shrink-0 size-4 text-[var(--accent)]" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></div>',
+  };
+
+  return (
+    <div className="relative">
+      <select
+        ref={ref}
+        data-hs-select={JSON.stringify(config)}
+        defaultValue={value}
+        onChange={(e) => onChange(e.target.value)}
+        className="hidden"
+      >
+        {options.map((o) => (
+          <option key={o.value} value={o.value}>
+            {o.label}
+          </option>
+        ))}
+      </select>
+      {/* Preline doesn't inject a chevron — overlay one (clicks pass through). */}
+      <div className="absolute top-1/2 end-3 -translate-y-1/2 pointer-events-none">
+        <svg
+          className="shrink-0 size-4 text-[var(--text-muted)]"
+          xmlns="http://www.w3.org/2000/svg"
+          width="24"
+          height="24"
+          viewBox="0 0 24 24"
+          fill="none"
+          stroke="currentColor"
+          strokeWidth="2"
+          strokeLinecap="round"
+          strokeLinejoin="round"
+        >
+          <path d="m6 9 6 6 6-6" />
+        </svg>
+      </div>
+    </div>
+  );
+}
diff --git a/apps/web/src/components/Avatar.tsx b/apps/web/src/components/Avatar.tsx
