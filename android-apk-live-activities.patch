@@ -0,0 +1,19 @@
+import { fileURLToPath } from "node:url";
+import { dirname, resolve } from "node:path";
+
+/** Local ingest cache dir (gitignored): packages/db/.cache/ingest/. */
+const here = dirname(fileURLToPath(import.meta.url));
+export const CACHE_DIR = resolve(here, "../../.cache/ingest");
+
+/** Where each source's raw dataset is cached after `ingest:fetch`. */
+export const SOURCE_FILES: Record<string, string> = {
+  "free-exercise-db": resolve(CACHE_DIR, "free-exercise-db.json"),
+};
+
+/** Cache path for a source, or throw if the source is unknown. */
+export function sourceFile(source: string): string {
+  const f = SOURCE_FILES[source];
+  if (!f)
+    throw new Error(`Unknown source "${source}". Known: ${Object.keys(SOURCE_FILES).join(", ")}`);
+  return f;
+}
diff --git a/packages/db/src/ingest/seed-exercises.ts b/packages/db/src/ingest/seed-exercises.ts
new file mode 100644
index 0000000..273ae76
--- /dev/null
+++ b/packages/db/src/ingest/seed-exercises.ts
@@ -0,0 +1,156 @@
+import { readFile } from "node:fs/promises";
+import { and, eq, inArray, sql } from "drizzle-orm";
+import {
+  normalizeFreeExercise,
+  type FreeExerciseRecord,
+  type NormalizedExercise,
+} from "@rackd/core";
+import { db } from "../db";
+import { exercises, exerciseMuscles, exerciseMedia } from "../schema";
+import { sourceFile } from "./paths";
+
+/**
+ * Normalize free-exercise-db records (cached by ingest:fetch) into our canonical
+ * model and upsert them. Idempotent: re-running updates rows + replaces the
+ * exercise's muscle/media child rows. Library exercises from the original seed
+ * (ids `ex_*`, source `rackd`) are untouched — these get slugified source ids.
+ *
+ *   pnpm --filter @rackd/db ingest:exercises [-- --limit=50 --dry-run]
+ */
+
+const chunk = <T>(arr: T[], size: number): T[][] => {
+  const out: T[][] = [];
+  for (let i = 0; i < arr.length; i += size) out.push(arr.slice(i, i + size));
+  return out;
+};
+
+export async function seedExercisesFromSource(
+  opts: { limit?: number; dryRun?: boolean } = {},
+): Promise<void> {
+  const raw = await readFile(sourceFile("free-exercise-db"), "utf8").catch(() => {
+    throw new Error("Source not cached. Run `pnpm --filter @rackd/db ingest:fetch` first.");
+  });
+  let records = JSON.parse(raw) as FreeExerciseRecord[];
+  if (opts.limit) records = records.slice(0, opts.limit);
+
+  const normalized: NormalizedExercise[] = [];
+  const unmapped = new Map<string, number>();
+  for (const rec of records) {
+    const { exercise, unmappedMuscles } = normalizeFreeExercise(rec);
+    normalized.push(exercise);
+    for (const m of unmappedMuscles) unmapped.set(m, (unmapped.get(m) ?? 0) + 1);
+  }
+
+  console.log(`[exercises] normalized ${normalized.length} records`);
+  if (unmapped.size) {
+    console.warn(
+      "[exercises] unmapped muscles (add to SOURCE_MUSCLE_MAP):",
+      [...unmapped.entries()].map(([m, n]) => `${m}×${n}`).join(", "),
+    );
+  }
+  if (opts.dryRun) {
+    console.log("[exercises] dry run — sample:", JSON.stringify(normalized[0], null, 2));
+    return;
+  }
+
+  const exerciseRows = normalized.map((e) => ({
+    id: e.id,
+    name: e.name,
+    slug: e.slug,
+    source: e.source,
+    sourceId: e.sourceId,
+    primaryMuscle: e.primaryMuscle,
+    secondaryMuscles: e.secondaryMuscles,
+    equipment: e.equipment,
+    category: e.category,
+    instructions: e.instructions,
+    force: e.force ?? null,
+    level: e.level ?? null,
+    mechanic: e.mechanic ?? null,
+    movementPattern: e.movementPattern ?? null,
+    isUnilateral: e.isUnilateral,
+    bodyPart: e.bodyPart,
+    thumbnailUrl: e.images[0] ?? null,
+    mediaSource: "library",
+    isCustom: false,
+  }));
+
+  for (const batch of chunk(exerciseRows, 250)) {
+    await db
+      .insert(exercises)
+      .values(batch)
+      .onConflictDoUpdate({
+        target: exercises.id,
+        set: {
+          name: sql`excluded.name`,
+          slug: sql`excluded.slug`,
+          source: sql`excluded.source`,
+          sourceId: sql`excluded.source_id`,
+          primaryMuscle: sql`excluded.primary_muscle`,
+          secondaryMuscles: sql`excluded.secondary_muscles`,
+          equipment: sql`excluded.equipment`,
+          category: sql`excluded.category`,
+          instructions: sql`excluded.instructions`,
+          force: sql`excluded.force`,
+          level: sql`excluded.level`,
+          mechanic: sql`excluded.mechanic`,
+          movementPattern: sql`excluded.movement_pattern`,
+          isUnilateral: sql`excluded.is_unilateral`,
+          bodyPart: sql`excluded.body_part`,
+          thumbnailUrl: sql`excluded.thumbnail_url`,
+        },
+      });
+  }
+
+  // Replace child rows for these exercises (idempotent re-seed).
+  const ids = normalized.map((e) => e.id);
+  for (const batch of chunk(ids, 200)) {
+    await db.delete(exerciseMuscles).where(inArray(exerciseMuscles.exerciseId, batch));
+  }
+  const muscleRows = normalized.flatMap((e) =>
+    e.muscles.map((m) => ({
+      exerciseId: e.id,
+      muscleId: m.muscleId,
+      role: m.role,
+      activation: m.activation,
+    })),
+  );
+  for (const batch of chunk(muscleRows, 1000)) {
+    if (batch.length) await db.insert(exerciseMuscles).values(batch).onConflictDoNothing();
+  }
+
+  for (const batch of chunk(ids, 200)) {
+    await db
+      .delete(exerciseMedia)
+      .where(and(inArray(exerciseMedia.exerciseId, batch), eq(exerciseMedia.kind, "image")));
+  }
+  const mediaRows = normalized.flatMap((e) =>
+    e.images.map((url, i) => ({
+      id: `${e.id}-img-${i}`,
+      exerciseId: e.id,
+      kind: "image",
+      url, // hotlinked source URL for now; download-media mirrors to our CDN later
+      originalUrl: url,
+      order: i,
+    })),
+  );
+  for (const batch of chunk(mediaRows, 1000)) {
+    if (batch.length) await db.insert(exerciseMedia).values(batch).onConflictDoNothing();
+  }
+
+  console.log(
+    `[exercises] upserted ${exerciseRows.length} exercises, ${muscleRows.length} muscle links, ${mediaRows.length} media`,
+  );
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const limit =
+    Number(process.argv.find((a) => a.startsWith("--limit="))?.split("=")[1]) || undefined;
+  const dryRun = process.argv.includes("--dry-run");
+  seedExercisesFromSource({ limit, dryRun })
+    .then(() => process.exit(0))
+    .catch((e) => {
+      console.error("[exercises] failed", e);
+      process.exit(1);
+    });
+}
diff --git a/packages/db/src/ingest/seed-taxonomy.ts b/packages/db/src/ingest/seed-taxonomy.ts
new file mode 100644
index 0000000..11649b5
--- /dev/null
+++ b/packages/db/src/ingest/seed-taxonomy.ts
@@ -0,0 +1,72 @@
+import { sql } from "drizzle-orm";
+import { MUSCLE_TAXONOMY, SOURCE_MUSCLE_MAP, SOURCE_EQUIPMENT_MAP } from "@rackd/core";
+import { db } from "../db";
+import { muscles, muscleMap, equipmentMap } from "../schema";
+
+/**
+ * Seed the fine-grained muscle taxonomy + the source→canonical reconciliation
+ * maps from the @rackd/core constants (single source of truth). Idempotent:
+ * re-running updates rows in place. Run before seed-exercises.
+ *
+ *   pnpm --filter @rackd/db ingest:taxonomy
+ */
+export async function seedTaxonomy(): Promise<void> {
+  const muscleRows = MUSCLE_TAXONOMY.map((m) => ({
+    id: m.id,
+    name: m.name,
+    canonicalGroup: m.canonicalGroup,
+    region: m.region ?? null,
+    svgRegion: m.svgRegion ?? null,
+    recoveryHours: m.recoveryHours,
+  }));
+  await db
+    .insert(muscles)
+    .values(muscleRows)
+    .onConflictDoUpdate({
+      target: muscles.id,
+      set: {
+        name: sql`excluded.name`,
+        canonicalGroup: sql`excluded.canonical_group`,
+        region: sql`excluded.region`,
+        svgRegion: sql`excluded.svg_region`,
+        recoveryHours: sql`excluded.recovery_hours`,
+      },
+    });
+
+  const muscleMapRows = Object.entries(SOURCE_MUSCLE_MAP).map(([sourceValue, muscleId]) => ({
+    sourceValue,
+    muscleId,
+  }));
+  await db
+    .insert(muscleMap)
+    .values(muscleMapRows)
+    .onConflictDoUpdate({
+      target: muscleMap.sourceValue,
+      set: { muscleId: sql`excluded.muscle_id` },
+    });
+
+  const equipmentMapRows = Object.entries(SOURCE_EQUIPMENT_MAP).map(([sourceValue, canonical]) => ({
+    sourceValue,
+    canonical,
+  }));
+  await db
+    .insert(equipmentMap)
+    .values(equipmentMapRows)
+    .onConflictDoUpdate({
+      target: equipmentMap.sourceValue,
+      set: { canonical: sql`excluded.canonical` },
+    });
+
+  console.log(
+    `[taxonomy] ${muscleRows.length} muscles, ${muscleMapRows.length} muscle maps, ${equipmentMapRows.length} equipment maps`,
+  );
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  seedTaxonomy()
+    .then(() => process.exit(0))
+    .catch((e) => {
+      console.error("[taxonomy] failed", e);
+      process.exit(1);
+    });
+}
diff --git a/packages/db/src/s3.ts b/packages/db/src/s3.ts
new file mode 100644
index 0000000..efe7a63
--- /dev/null
+++ b/packages/db/src/s3.ts
@@ -0,0 +1,105 @@
+import { createHash, createHmac } from "node:crypto";
+
+/**
+ * Minimal S3 PutObject via AWS SigV4 — server-only, zero extra deps. Signs with
+ * Node crypto and PUTs bytes with path-style addressing (`{endpoint}/{bucket}/
+ * {key}`). Works with MinIO (local dev) and Tigris (Fly prod) alike. Binaries
+ * live in the object store; only the resulting public URL is ever persisted
+ * (media rule). Used by the web profile-photo route and the exercise media
+ * mirror (ingest:media).
+ */
+
+export interface S3Config {
+  endpoint: string; // server-side, e.g. https://fly.storage.tigris.dev
+  publicUrl: string; // browser-facing base incl. bucket
+  bucket: string;
+  region: string;
+  accessKey: string;
+  secretKey: string;
+}
+
+/** Read + validate S3 env at call time (server runtime, not build). */
+export function getS3Config(): S3Config {
+  const endpoint = process.env.S3_ENDPOINT;
+  const publicUrl = process.env.S3_PUBLIC_URL;
+  const bucket = process.env.S3_BUCKET;
+  const accessKey = process.env.S3_ACCESS_KEY;
+  const secretKey = process.env.S3_SECRET_KEY;
+  if (!endpoint || !publicUrl || !bucket || !accessKey || !secretKey) {
+    throw new Error("S3 storage is not configured");
+  }
+  return {
+    endpoint: endpoint.replace(/\/+$/, ""),
+    publicUrl: publicUrl.replace(/\/+$/, ""),
+    bucket,
+    region: process.env.S3_REGION || "us-east-1",
+    accessKey,
+    secretKey,
+  };
+}
+
+const hex = (b: Buffer | string) => createHash("sha256").update(b).digest("hex");
+const hmac = (key: Buffer | string, data: string) =>
+  createHmac("sha256", key).update(data, "utf8").digest();
+
+/** Upload bytes and return the public URL. `key` is the object path in the bucket. */
+export async function putObject(
+  cfg: S3Config,
+  key: string,
+  body: Buffer,
+  contentType: string,
+): Promise<string> {
+  const url = new URL(`${cfg.endpoint}/${cfg.bucket}/${key}`);
+  const now = new Date();
+  const amzDate = now.toISOString().replace(/[:-]|\.\d{3}/g, ""); // YYYYMMDDTHHMMSSZ
+  const dateStamp = amzDate.slice(0, 8);
+  const payloadHash = hex(body);
+
+  // Canonical request. SignedHeaders must be sorted by lowercase name.
+  const headers: Record<string, string> = {
+    host: url.host,
+    "content-type": contentType,
+    "x-amz-content-sha256": payloadHash,
+    "x-amz-date": amzDate,
+  };
+  const signedHeaders = Object.keys(headers).sort().join(";");
+  const canonicalHeaders = Object.keys(headers)
+    .sort()
+    .map((h) => `${h}:${headers[h]}\n`)
+    .join("");
+  const canonicalRequest = [
+    "PUT",
+    url.pathname,
+    "", // no query
+    canonicalHeaders,
+    signedHeaders,
+    payloadHash,
+  ].join("\n");
+
+  const scope = `${dateStamp}/${cfg.region}/s3/aws4_request`;
+  const stringToSign = ["AWS4-HMAC-SHA256", amzDate, scope, hex(canonicalRequest)].join("\n");
+
+  const kDate = hmac(`AWS4${cfg.secretKey}`, dateStamp);
+  const kRegion = hmac(kDate, cfg.region);
+  const kService = hmac(kRegion, "s3");
+  const kSigning = hmac(kService, "aws4_request");
+  const signature = createHmac("sha256", kSigning).update(stringToSign, "utf8").digest("hex");
+
+  const authorization =
+    `AWS4-HMAC-SHA256 Credential=${cfg.accessKey}/${scope}, ` +
+    `SignedHeaders=${signedHeaders}, Signature=${signature}`;
+
+  const res = await fetch(url, {
+    method: "PUT",
+    headers: { ...headers, Authorization: authorization },
+    // A plain Uint8Array is an accepted fetch body across both the DOM and node
+    // (undici) typings — avoids naming BodyInit, which isn't a global in every
+    // package's lib (db/push have no DOM lib).
+    body: Uint8Array.from(body),
+  });
+  if (!res.ok) {
+    const detail = await res.text().catch(() => "");
+    throw new Error(`S3 upload failed (${res.status}) ${detail.slice(0, 200)}`);
+  }
+  return `${cfg.publicUrl}/${key}`;
+}
diff --git a/packages/db/src/schema.ts b/packages/db/src/schema.ts
new file mode 100644
index 0000000..3610575
--- /dev/null
+++ b/packages/db/src/schema.ts
@@ -0,0 +1,438 @@
+import {
+  pgTable,
+  text,
+  integer,
+  doublePrecision,
+  boolean,
+  bigint,
+  primaryKey,
+} from "drizzle-orm/pg-core";
+
+/**
+ * Drizzle/Postgres schema — the persisted source of truth (replaces Triplit).
+ * Domain TYPES live in @rackd/core; this maps them to storage.
+ *
+ * Conventions:
+ * - `id` is a TEXT primary key, app-generated (uuidv7) — never DB-generated.
+ * - `ownerId` (= Supabase `auth.users.id`) scopes every owner-owned row; API
+ *   routes add `WHERE owner_id = …`. The exercise + sharedRoutines libraries are
+ *   the public exceptions (world-readable, owner-writable).
+ * - Epoch-millisecond timestamps are BIGINT (they overflow int4); weights/loads
+ *   are DOUBLE PRECISION (2.5 kg increments); counts/orders are INTEGER.
+ * - Parent→child deletes CASCADE at the DB level so API routes don't re-walk
+ *   the tree by hand. `routineId` back-references SET NULL (history/plan-day
+ *   slots survive their routine being deleted).
+ * - JS property names stay camelCase (DB columns snake_case) so row shapes match
+ *   the @rackd/core domain types the UI already consumes.
+ */
+
+export const exercises = pgTable("exercises", {
+  id: text("id").primaryKey(),
+  name: text("name").notNull(),
+  primaryMuscle: text("primary_muscle").notNull(),
+  secondaryMuscles: text("secondary_muscles").array().notNull().default([]),
+  equipment: text("equipment").notNull(),
+  category: text("category").notNull(),
+  instructions: text("instructions").notNull().default(""),
+  /** Short coaching cues shown as a checklist on the exercise detail. */
+  formCues: text("form_cues").array().notNull().default([]),
+  thumbnailUrl: text("thumbnail_url"),
+  clipUrl: text("clip_url"),
+  clipUrlWebm: text("clip_url_webm"),
+  mediaSource: text("media_source").notNull().default("library"),
+  isCustom: boolean("is_custom").notNull().default(false),
+  ownerId: text("owner_id"),
+  // --- Exercise data platform (see docs/specs/exercise-data-platform.md) ---
+  // Dataset provenance; (source, sourceId) is the ingest upsert key.
+  source: text("source").notNull().default("rackd"),
+  sourceId: text("source_id"),
+  slug: text("slug").unique(),
+  force: text("force"),
+  level: text("level"),
+  mechanic: text("mechanic"),
+  // DERIVED at ingest.
+  movementPattern: text("movement_pattern"),
+  isUnilateral: boolean("is_unilateral").notNull().default(false),
+  bodyPart: text("body_part"),
+  aliases: text("aliases").array().notNull().default([]),
+  popularity: integer("popularity").notNull().default(0),
+});
+
+/**
+ * Fine-grained muscle taxonomy. `canonicalGroup` maps each muscle back to the
+ * coarse MuscleGroup the app UI/stats use; `svgRegion` keys the self-owned
+ * MuscleMap SVG path; `recoveryHours` is the fatigue-engine baseline.
+ */
+export const muscles = pgTable("muscles", {
+  id: text("id").primaryKey(),
+  name: text("name").notNull(),
+  canonicalGroup: text("canonical_group").notNull(),
+  region: text("region"),
+  svgRegion: text("svg_region"),
+  recoveryHours: integer("recovery_hours").notNull().default(48),
+});
+
+/** Exercise ↔ muscle join with DERIVED activation weight (0..1). */
+export const exerciseMuscles = pgTable(
+  "exercise_muscles",
+  {
+    exerciseId: text("exercise_id")
+      .notNull()
+      .references(() => exercises.id, { onDelete: "cascade" }),
+    muscleId: text("muscle_id")
+      .notNull()
+      .references(() => muscles.id),
+    role: text("role").notNull(),
+    activation: doublePrecision("activation").notNull(),
+  },
+  (t) => ({ pk: primaryKey({ columns: [t.exerciseId, t.muscleId] }) }),
+);
+
+/** Media rows — our CDN URL + source provenance. Never binary in the DB. */
+export const exerciseMedia = pgTable("exercise_media", {
+  id: text("id").primaryKey(),
+  exerciseId: text("exercise_id")
+    .notNull()
+    .references(() => exercises.id, { onDelete: "cascade" }),
+  kind: text("kind").notNull(),
+  url: text("url").notNull(),
+  originalUrl: text("original_url"),
+  width: integer("width"),
+  height: integer("height"),
+  order: integer("order").notNull().default(0),
+  lang: text("lang"),
+});
+
+/** Similarity / substitution graph edges. */
+export const exerciseRelations = pgTable(
+  "exercise_relations",
+  {
+    exerciseId: text("exercise_id")
+      .notNull()
+      .references(() => exercises.id, { onDelete: "cascade" }),
+    relatedId: text("related_id")
+      .notNull()
+      .references(() => exercises.id, { onDelete: "cascade" }),
+    kind: text("kind").notNull(),
+    score: doublePrecision("score").notNull(),
+    reason: text("reason"),
+  },
+  (t) => ({ pk: primaryKey({ columns: [t.exerciseId, t.relatedId, t.kind] }) }),
+);
+
+/** Source equipment string → canonical Equipment enum value. */
+export const equipmentMap = pgTable("equipment_map", {
+  sourceValue: text("source_value").primaryKey(),
+  canonical: text("canonical").notNull(),
+});
+
+/** Source muscle string → our muscle id (taxonomy reconciliation). */
+export const muscleMap = pgTable("muscle_map", {
+  sourceValue: text("source_value").primaryKey(),
+  muscleId: text("muscle_id")
+    .notNull()
+    .references(() => muscles.id),
+});
+
+/**
+ * Bundled, public plan template (PPL, 5/3/1, …) — the read-only library users
+ * clone into their own `routines`. Distinct from the user-scoped `programs`.
+ */
+export const programTemplates = pgTable("program_templates", {
+  id: text("id").primaryKey(),
+  slug: text("slug").notNull().unique(),
+  name: text("name").notNull(),
+  description: text("description"),
+  goal: text("goal"),
+  level: text("level"),
+  methodology: text("methodology"),
+  daysPerWeek: integer("days_per_week"),
+  durationWeeks: integer("duration_weeks"),
+  equipmentNeeded: text("equipment_needed").array().notNull().default([]),
+  source: text("source"),
+  attribution: text("attribution"),
+  isPublic: boolean("is_public").notNull().default(true),
+});
+
+export const programTemplateDays = pgTable("program_template_days", {
+  id: text("id").primaryKey(),
+  programTemplateId: text("program_template_id")
+    .notNull()
+    .references(() => programTemplates.id, { onDelete: "cascade" }),
+  weekIndex: integer("week_index"),
+  dayIndex: integer("day_index").notNull(),
+  label: text("label").notNull(),
+});
+
+export const programTemplateExercises = pgTable("program_template_exercises", {
+  id: text("id").primaryKey(),
+  dayId: text("day_id")
+    .notNull()
+    .references(() => programTemplateDays.id, { onDelete: "cascade" }),
+  // Null while only `sourceName` is known (unresolved import).
+  exerciseId: text("exercise_id").references(() => exercises.id),
+  order: integer("order").notNull(),
+  sets: integer("sets"),
+  repScheme: text("rep_scheme"),
+  restSeconds: integer("rest_seconds"),
+  intensity: text("intensity"),
+  notes: text("notes"),
+  sourceName: text("source_name"),
+});
+
+/**
+ * Per-user, per-muscle fatigue. `accumulatedLoad` decays on read (wall-clock,
+ * like the rest timer); `lastTrainedAt` is epoch ms. Owner-scoped.
+ */
+export const muscleFatigue = pgTable(
+  "muscle_fatigue",
+  {
+    ownerId: text("owner_id").notNull(),
+    muscleId: text("muscle_id")
+      .notNull()
+      .references(() => muscles.id),
+    accumulatedLoad: doublePrecision("accumulated_load").notNull().default(0),
+    lastTrainedAt: bigint("last_trained_at", { mode: "number" }),
+  },
+  (t) => ({ pk: primaryKey({ columns: [t.ownerId, t.muscleId] }) }),
+);
+
+export const routines = pgTable("routines", {
+  id: text("id").primaryKey(),
+  ownerId: text("owner_id").notNull(),
+  name: text("name").notNull(),
+  folderId: text("folder_id"),
+  notes: text("notes"),
+  order: integer("order").notNull().default(0),
+  category: text("category"),
+  // Weekdays (0=Sun … 6=Sat) this routine is scheduled for; null = unscheduled.
+  scheduledDays: integer("scheduled_days").array(),
+});
+
+export const routineExercises = pgTable("routine_exercises", {
+  id: text("id").primaryKey(),
+  ownerId: text("owner_id").notNull().default(""),
+  routineId: text("routine_id")
+    .notNull()
+    .references(() => routines.id, { onDelete: "cascade" }),
+  exerciseId: text("exercise_id")
+    .notNull()
+    .references(() => exercises.id),
+  order: integer("order").notNull(),
+  supersetGroup: integer("superset_group"),
+  restSec: integer("rest_sec").notNull().default(120),
+  notes: text("notes"),
+  // Bar used for plate math (BarType in @rackd/core); only meaningful for
+  // barbell exercises. Default "standard" so existing rows behave as today.
+  barType: text("bar_type").notNull().default("standard"),
+});
+
+export const routineSets = pgTable("routine_sets", {
+  id: text("id").primaryKey(),
+  ownerId: text("owner_id").notNull().default(""),
+  routineExerciseId: text("routine_exercise_id")
+    .notNull()
+    .references(() => routineExercises.id, { onDelete: "cascade" }),
+  order: integer("order").notNull(),
+  type: text("type").notNull().default("normal"),
+  targetReps: integer("target_reps"),
+  targetWeight: doublePrecision("target_weight"),
+  targetRpe: doublePrecision("target_rpe"),
+  tempo: text("tempo"),
+});
+
+export const sessions = pgTable("sessions", {
+  id: text("id").primaryKey(),
+  ownerId: text("owner_id").notNull(),
+  // Source routine (if any). SET NULL on routine delete — the session is history
+  // and must outlive its plan.
+  routineId: text("routine_id").references(() => routines.id, {
+    onDelete: "set null",
+  }),
+  // Program this workout was started under (if any). Stamped at start time and
+  // never rewritten, so day/week progress survives a routine being forked or
+  // re-pointed by save-back. SET NULL on program delete — history outlives the
+  // plan. Progress counting joins on this, not routineId (which can churn).
+  programId: text("program_id").references(() => programs.id, {
+    onDelete: "set null",
+  }),
+  name: text("name").notNull(),
+  startedAt: bigint("started_at", { mode: "number" }).notNull(),
+  endedAt: bigint("ended_at", { mode: "number" }),
+  notes: text("notes"),
+  bodyweight: doublePrecision("bodyweight"),
+});
+
+export const sessionExercises = pgTable("session_exercises", {
+  id: text("id").primaryKey(),
+  ownerId: text("owner_id").notNull().default(""),
+  sessionId: text("session_id")
+    .notNull()
+    .references(() => sessions.id, { onDelete: "cascade" }),
+  exerciseId: text("exercise_id")
+    .notNull()
+    .references(() => exercises.id),
+  order: integer("order").notNull(),
+  supersetGroup: integer("superset_group"),
+  restSec: integer("rest_sec").notNull().default(120),
+  // Copied from the routine exercise at session start (see startSessionFromRoutine).
+  barType: text("bar_type").notNull().default("standard"),
+});
+
+export const setLogs = pgTable("set_logs", {
+  id: text("id").primaryKey(),
+  ownerId: text("owner_id").notNull().default(""),
+  sessionExerciseId: text("session_exercise_id")
+    .notNull()
+    .references(() => sessionExercises.id, { onDelete: "cascade" }),
+  order: integer("order").notNull(),
+  type: text("type").notNull().default("normal"),
+  weight: doublePrecision("weight").notNull().default(0),
+  reps: integer("reps").notNull().default(0),
+  rpe: doublePrecision("rpe"),
+  completed: boolean("completed").notNull().default(false),
+  restTakenSec: integer("rest_taken_sec"),
+  isPr: boolean("is_pr").notNull().default(false),
+});
+
+export const personalRecords = pgTable("personal_records", {
+  id: text("id").primaryKey(),
+  ownerId: text("owner_id").notNull(),
+  exerciseId: text("exercise_id")
+    .notNull()
+    .references(() => exercises.id),
+  type: text("type").notNull(),
+  value: doublePrecision("value").notNull(),
+  sessionId: text("session_id").notNull(),
+  achievedAt: bigint("achieved_at", { mode: "number" }).notNull(),
+});
+
+export const bodyMetrics = pgTable("body_metrics", {
+  id: text("id").primaryKey(),
+  ownerId: text("owner_id").notNull(),
+  date: bigint("date", { mode: "number" }).notNull(),
+  weightKg: doublePrecision("weight_kg").notNull(),
+  note: text("note"),
+});
+
+export const bodyWeightLogs = pgTable("body_weight_logs", {
+  id: text("id").primaryKey(),
+  ownerId: text("owner_id").notNull(),
+  weightKg: doublePrecision("weight_kg").notNull(),
+  loggedAt: bigint("logged_at", { mode: "number" }).notNull(),
+});
+
+export const programs = pgTable("programs", {
+  id: text("id").primaryKey(),
+  ownerId: text("owner_id").notNull(),
+  name: text("name").notNull(),
+  notes: text("notes"),
+  order: integer("order").notNull().default(0),
+  blockWeeks: integer("block_weeks"),
+  active: boolean("active"),
+  scheduleMode: text("schedule_mode"),
+  rotationCursor: integer("rotation_cursor"),
+  // When the program last became active — anchors "week 1, day 1" for the
+  // dashboard's week-block progress bar. Reset each time it's re-activated.
+  activatedAt: bigint("activated_at", { mode: "number" }),
+  // Last explicit nudge of the rotation ("Skip"). A rotation restarts itself at
+  // day 1 after LAYOFF_RESTART_DAYS away, measured from the later of this and
+  // the last finished workout — so skipping during a layoff sticks instead of
+  // being re-restarted on the next render.
+  rotationTouchedAt: bigint("rotation_touched_at", { mode: "number" }),
+});
+
+export const programDays = pgTable("program_days", {
+  id: text("id").primaryKey(),
+  ownerId: text("owner_id").notNull().default(""),
+  programId: text("program_id")
+    .notNull()
+    .references(() => programs.id, { onDelete: "cascade" }),
+  order: integer("order").notNull(),
+  name: text("name").notNull().default("Day"),
+  // SET NULL on routine delete → the day becomes a Rest slot, structure intact.
+  routineId: text("routine_id").references(() => routines.id, {
+    onDelete: "set null",
+  }),
+  weekday: integer("weekday"),
+});
+
+export const sharedRoutines = pgTable("shared_routines", {
+  id: text("id").primaryKey(),
+  ownerId: text("owner_id").notNull(),
+  authorName: text("author_name").notNull().default("Someone"),
+  name: text("name").notNull(),
+  // Self-contained snapshot, stored as a JSON string (app stringifies/parses) so
+  // the row shape stays a string — not Postgres jsonb.
+  exercisesJson: text("exercises_json").notNull(),
+  exerciseCount: integer("exercise_count").notNull().default(0),
+  createdAt: bigint("created_at", { mode: "number" }).notNull(),
+});
+
+export const userProfile = pgTable("user_profiles", {
+  id: text("id").primaryKey(),
+  ownerId: text("owner_id").notNull(),
+  displayName: text("display_name"),
+  photoUrl: text("photo_url"),
+  heightCm: doublePrecision("height_cm"),
+  currentWeightKg: doublePrecision("current_weight_kg"),
+  goalWeightKg: doublePrecision("goal_weight_kg"),
+  trainingGoal: text("training_goal"),
+  unitPreference: text("unit_preference").notNull().default("metric"),
+  defaultRestSec: integer("default_rest_sec").notNull().default(120),
+  defaultSets: integer("default_sets").notNull().default(3),
+  defaultReps: integer("default_reps").notNull().default(10),
+});
+
+export const pushSubscriptions = pgTable("push_subscriptions", {
+  id: text("id").primaryKey(),
+  ownerId: text("owner_id").notNull(),
+  endpoint: text("endpoint").notNull(),
+  p256dh: text("p256dh").notNull(),
+  auth: text("auth").notNull(),
+  userAgent: text("user_agent"),
+  createdAt: bigint("created_at", { mode: "number" }).notNull(),
+});
+
+export const scheduledPushes = pgTable("scheduled_pushes", {
+  id: text("id").primaryKey(),
+  ownerId: text("owner_id").notNull(),
+  subscriptionId: text("subscription_id")
+    .notNull()
+    .references(() => pushSubscriptions.id, { onDelete: "cascade" }),
+  fireAt: bigint("fire_at", { mode: "number" }).notNull(),
+  title: text("title").notNull().default("Rest over"),
+  body: text("body").notNull().default("Time for your next set."),
+  status: text("status").notNull().default("pending"),
+  createdAt: bigint("created_at", { mode: "number" }).notNull(),
+});
+
+/** All tables, for `drizzle(pool, { schema })` relational queries. */
+export const schema = {
+  exercises,
+  muscles,
+  exerciseMuscles,
+  exerciseMedia,
+  exerciseRelations,
+  equipmentMap,
+  muscleMap,
+  routines,
+  routineExercises,
+  routineSets,
+  sessions,
+  sessionExercises,
+  setLogs,
+  personalRecords,
+  bodyMetrics,
+  bodyWeightLogs,
+  programs,
+  programDays,
+  programTemplates,
+  programTemplateDays,
+  programTemplateExercises,
+  muscleFatigue,
+  sharedRoutines,
+  userProfile,
+  pushSubscriptions,
+  scheduledPushes,
+};
diff --git a/packages/db/src/seed-demo.ts b/packages/db/src/seed-demo.ts
new file mode 100644
index 0000000..11aec4d
--- /dev/null
+++ b/packages/db/src/seed-demo.ts
@@ -0,0 +1,307 @@
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { dirname, join } from "node:path";
+import { randomUUID } from "node:crypto";
+import { eq, sql } from "drizzle-orm";
+
+/**
+ * Demo data seeder — populates one account with a realistic, screenshot-ready
+ * home dashboard: an active Push/Pull/Legs program (today = Push Day), a few
+ * finished sessions with logged sets (for streak + weekly volume), PRs on a
+ * couple of them (for the "N PR" badges), and body-weight history.
+ *
+ * Idempotent: it wipes the target owner's app data first, then re-inserts, so
+ * it's safe to run repeatedly. The library exercises it references must already
+ * be seeded (`pnpm --filter @rackd/db seed`).
+ *
+ * Run against the LOCAL Supabase stack:
+ *   pnpm --filter @rackd/db db:seed-demo
+ * (auto-loads apps/web/.env.local for DATABASE_URL / DATABASE_SSL). Override the
+ * account with DEMO_EMAIL=someone@example.com.
+ */
+
+// --- env: load apps/web/.env.local so a bare `pnpm db:seed-demo` just works ---
+function loadLocalEnv(): void {
+  if (process.env.DATABASE_URL) return;
+  const here = dirname(fileURLToPath(import.meta.url)); // packages/db/src
+  const envPath = join(here, "../../../apps/web/.env.local");
+  try {
+    for (const line of readFileSync(envPath, "utf8").split("\n")) {
+      const m = line.match(/^\s*([A-Z0-9_]+)\s*=\s*(.*)\s*$/);
+      const key = m?.[1];
+      const raw = m?.[2];
+      if (key === undefined || raw === undefined) continue;
+      const val = raw.replace(/^["']|["']$/g, "");
+      if (process.env[key] === undefined) process.env[key] = val;
+    }
+  } catch {
+    // No env file (e.g. CI) — rely on the ambient environment instead.
+  }
+}
+loadLocalEnv();
+
+const DAY = 86_400_000;
+const DEMO_EMAIL = process.env.DEMO_EMAIL ?? "demo@rackd.test";
+
+interface PlannedExercise {
+  exerciseId: string;
+  sets: number;
+  reps: number;
+  weight: number; // kg, 0 = bodyweight
+  rest: number; // seconds
+}
+interface PlannedRoutine {
+  key: string;
+  name: string;
+  exercises: PlannedExercise[];
+}
+
+const ROUTINES: PlannedRoutine[] = [
+  {
+    key: "push",
+    name: "Push Day",
+    exercises: [
+      { exerciseId: "ex_bench_press", sets: 4, reps: 5, weight: 80, rest: 180 },
+      { exerciseId: "ex_ohp", sets: 3, reps: 8, weight: 45, rest: 120 },
+      { exerciseId: "ex_incline_db_press", sets: 3, reps: 10, weight: 28, rest: 90 },
+      { exerciseId: "ex_lateral_raise", sets: 3, reps: 15, weight: 10, rest: 60 },
+      { exerciseId: "ex_tricep_pushdown", sets: 3, reps: 12, weight: 25, rest: 60 },
+    ],
+  },
+  {
+    key: "pull",
+    name: "Pull Day",
+    exercises: [
+      { exerciseId: "ex_deadlift", sets: 3, reps: 5, weight: 120, rest: 180 },
+      { exerciseId: "ex_pullup", sets: 4, reps: 8, weight: 0, rest: 120 },
+      { exerciseId: "ex_bb_row", sets: 3, reps: 10, weight: 70, rest: 90 },
+      { exerciseId: "ex_bb_curl", sets: 3, reps: 12, weight: 30, rest: 60 },
+      { exerciseId: "ex_face_pull", sets: 3, reps: 15, weight: 20, rest: 60 },
+    ],
+  },
+  {
+    key: "legs",
+    name: "Leg Day",
+    exercises: [
+      { exerciseId: "ex_squat", sets: 4, reps: 5, weight: 100, rest: 180 },
+      { exerciseId: "ex_rdl", sets: 3, reps: 8, weight: 90, rest: 120 },
+      { exerciseId: "ex_leg_press", sets: 3, reps: 12, weight: 160, rest: 90 },
+      { exerciseId: "ex_leg_curl", sets: 3, reps: 12, weight: 45, rest: 60 },
+      { exerciseId: "ex_calf_raise", sets: 4, reps: 15, weight: 60, rest: 45 },
+    ],
+  },
+];
+
+interface PlannedPR {
+  exerciseId: string;
+  type: "1rm" | "weight";
+  value: number;
+}
+interface PlannedSession {
+  routineKey: string;
+  daysAgo: number;
+  prs: PlannedPR[];
+}
+
+// Finished workouts, newest first. None today → the hero stays on "Today's
+// workout: Push Day" instead of flipping to the done state. Streak = 3
+// (yesterday, -2, -3 are consecutive; -5 sits behind a gap).
+const SESSIONS: PlannedSession[] = [
+  {
+    routineKey: "pull",
+    daysAgo: 1,
+    prs: [{ exerciseId: "ex_deadlift", type: "weight", value: 122.5 }],
+  },
+  { routineKey: "legs", daysAgo: 2, prs: [] },
+  {
+    routineKey: "push",
+    daysAgo: 3,
+    prs: [
+      { exerciseId: "ex_bench_press", type: "1rm", value: 95 },
+      { exerciseId: "ex_ohp", type: "weight", value: 47.5 },
+    ],
+  },
+  { routineKey: "pull", daysAgo: 5, prs: [] },
+];
+
+export async function seedDemo(email = DEMO_EMAIL): Promise<void> {
+  // Imported after env load so the pool picks up DATABASE_URL/DATABASE_SSL.
+  const { db } = await import("./db");
+  const s = await import("./schema");
+
+  // Resolve the owner id (= Supabase auth user id) by email.
+  const found = await db.execute<{ id: string }>(
+    sql`select id::text as id from auth.users where email = ${email} limit 1`,
+  );
+  const ownerId = found.rows[0]?.id;
+  if (!ownerId) {
+    throw new Error(`No auth user for ${email}. Sign up in the app first, then re-run.`);
+  }
+
+  const now = Date.now();
+
+  // --- wipe this owner's app data (child→parent), so re-runs are clean -------
+  await db.delete(s.setLogs).where(eq(s.setLogs.ownerId, ownerId));
+  await db.delete(s.sessionExercises).where(eq(s.sessionExercises.ownerId, ownerId));
+  await db.delete(s.sessions).where(eq(s.sessions.ownerId, ownerId));
+  await db.delete(s.personalRecords).where(eq(s.personalRecords.ownerId, ownerId));
+  await db.delete(s.routineSets).where(eq(s.routineSets.ownerId, ownerId));
+  await db.delete(s.routineExercises).where(eq(s.routineExercises.ownerId, ownerId));
+  await db.delete(s.programDays).where(eq(s.programDays.ownerId, ownerId));
+  await db.delete(s.sessions).where(eq(s.sessions.ownerId, ownerId)); // (no-op safety)
+  await db.delete(s.routines).where(eq(s.routines.ownerId, ownerId));
+  await db.delete(s.programs).where(eq(s.programs.ownerId, ownerId));
+  await db.delete(s.bodyWeightLogs).where(eq(s.bodyWeightLogs.ownerId, ownerId));
+  await db.delete(s.userProfile).where(eq(s.userProfile.ownerId, ownerId));
+
+  // --- routines (the plan tree) ---------------------------------------------
+  const routineIdByKey = new Map<string, string>();
+  for (const [i, r] of ROUTINES.entries()) {
+    const routineId = randomUUID();
+    routineIdByKey.set(r.key, routineId);
+    await db.insert(s.routines).values({
+      id: routineId,
+      ownerId,
+      name: r.name,
+      order: i,
+      category: "strength",
+    });
+    for (const [j, ex] of r.exercises.entries()) {
+      const reId = randomUUID();
+      await db.insert(s.routineExercises).values({
+        id: reId,
+        ownerId,
+        routineId,
+        exerciseId: ex.exerciseId,
+        order: j,
+        restSec: ex.rest,
+      });
+      await db.insert(s.routineSets).values(
+        Array.from({ length: ex.sets }, (_, k) => ({
+          id: randomUUID(),
+          ownerId,
+          routineExerciseId: reId,
+          order: k,
+          type: "normal",
+          targetReps: ex.reps,
+          targetWeight: ex.weight,
+        })),
+      );
+    }
+  }
+
+  // --- active Push/Pull/Legs program (rotation, today = Push) ----------------
+  const programId = randomUUID();
+  await db.insert(s.programs).values({
+    id: programId,
+    ownerId,
+    name: "Push / Pull / Legs",
+    order: 0,
+    blockWeeks: 4,
+    active: true,
+    scheduleMode: "rotation",
+    rotationCursor: 0, // ordered day 0 → Push Day is today's slot
+    activatedAt: now - 6 * DAY,
+  });
+  await db.insert(s.programDays).values(
+    ROUTINES.map((r, i) => ({
+      id: randomUUID(),
+      ownerId,
+      programId,
+      order: i,
+      name: r.name,
+      routineId: routineIdByKey.get(r.key)!,
+    })),
+  );
+
+  // --- finished sessions with logged sets, PRs ------------------------------
+  for (const plan of SESSIONS) {
+    const routine = ROUTINES.find((r) => r.key === plan.routineKey)!;
+    const endedAt = now - plan.daysAgo * DAY;
+    const startedAt = endedAt - 55 * 60_000; // ~55 min workout
+    const sessionId = randomUUID();
+    await db.insert(s.sessions).values({
+      id: sessionId,
+      ownerId,
+      routineId: routineIdByKey.get(routine.key)!,
+      programId,
+      name: routine.name,
+      startedAt,
+      endedAt,
+    });
+    for (const [j, ex] of routine.exercises.entries()) {
+      const seId = randomUUID();
+      await db.insert(s.sessionExercises).values({
+        id: seId,
+        ownerId,
+        sessionId,
+        exerciseId: ex.exerciseId,
+        order: j,
+        restSec: ex.rest,
+      });
+      await db.insert(s.setLogs).values(
+        Array.from({ length: ex.sets }, (_, k) => ({
+          id: randomUUID(),
+          ownerId,
+          sessionExerciseId: seId,
+          order: k,
+          type: "normal",
+          weight: ex.weight,
+          reps: ex.reps,
+          completed: true,
+        })),
+      );
+    }
+    if (plan.prs.length > 0) {
+      await db.insert(s.personalRecords).values(
+        plan.prs.map((pr) => ({
+          id: randomUUID(),
+          ownerId,
+          exerciseId: pr.exerciseId,
+          type: pr.type,
+          value: pr.value,
+          sessionId,
+          achievedAt: endedAt,
+        })),
+      );
+    }
+  }
+
+  // --- profile + body-weight trend (for the Weight progress card) -----------
+  await db.insert(s.userProfile).values({
+    id: randomUUID(),
+    ownerId,
+    displayName: "Demo Lifter",
+    currentWeightKg: 80.5,
+    goalWeightKg: 75,
+    unitPreference: "metric",
+  });
+  await db.insert(s.bodyWeightLogs).values(
+    [
+      { daysAgo: 30, weightKg: 83 },
+      { daysAgo: 21, weightKg: 82.4 },
+      { daysAgo: 14, weightKg: 81.6 },
+      { daysAgo: 7, weightKg: 80.9 },
+      { daysAgo: 1, weightKg: 80.5 },
+    ].map((b) => ({
+      id: randomUUID(),
+      ownerId,
+      weightKg: b.weightKg,
+      loggedAt: now - b.daysAgo * DAY,
+    })),
+  );
+
+  console.log(
+    `[seed-demo] ${email} (${ownerId}): 1 program, ${ROUTINES.length} routines, ${SESSIONS.length} sessions seeded.`,
+  );
+}
+
+// Allow running as a standalone script: `tsx src/seed-demo.ts`
+if (import.meta.url === `file://${process.argv[1]}`) {
+  seedDemo()
+    .then(() => process.exit(0))
+    .catch((e) => {
+      console.error("[seed-demo] failed", e);
+      process.exit(1);
+    });
+}
