+}
+
+/** Queue a push for `fireAt`. Returns the row so the caller can reschedule/cancel it. */
+export async function schedulePush(args: {
+  ownerId: string;
+  subscriptionId: string;
+  fireAt: number;
+  title: string;
+  body: string;
+  now: number;
+}) {
+  return insertRow(t.scheduledPushes, {
+    ownerId: args.ownerId,
+    subscriptionId: args.subscriptionId,
+    fireAt: args.fireAt,
+    title: args.title,
+    body: args.body,
+    status: "pending",
+    createdAt: args.now,
+  });
+}
+
+/** Move a still-pending scheduled push to a new fire time (rest +/- time). */
+export async function reschedulePush(id: string, fireAt: number) {
+  await db
+    .update(t.scheduledPushes)
+    .set({ fireAt })
+    .where(and(eq(t.scheduledPushes.id, id), eq(t.scheduledPushes.status, "pending")));
+}
+
+/** Cancel a scheduled push (rest skipped, or fired locally in the foreground). */
+export async function cancelScheduledPush(id: string) {
+  await db.delete(t.scheduledPushes).where(eq(t.scheduledPushes.id, id));
+}
+
+/** A pending scheduled push with its target subscription resolved. */
+export interface PendingPushRow extends ScheduledPush {
+  subscription: PushSubscriptionRecord | null;
+}
+
+/**
+ * Every pending push (across all owners), each with its target `subscription`
+ * joined so the sender has endpoint+keys in one read. The server-side sender
+ * (apps/push) polls this; it decides *when* to deliver by comparing `fireAt` to
+ * the wall clock. One-shot — replaces the old Triplit live subscription.
+ */
+export async function getPendingPushes(): Promise<PendingPushRow[]> {
+  const rows = await db
+    .select()
+    .from(t.scheduledPushes)
+    .leftJoin(t.pushSubscriptions, eq(t.scheduledPushes.subscriptionId, t.pushSubscriptions.id))
+    .where(eq(t.scheduledPushes.status, "pending"));
+  return rows.map((r) => ({
+    ...(r.scheduled_pushes as unknown as ScheduledPush),
+    subscription: (r.push_subscriptions as unknown as PushSubscriptionRecord | null) ?? null,
+  }));
+}
+
+/** Mark a scheduled push delivered so the sender never sends it twice. */
+export async function markPushSent(id: string) {
+  await db.update(t.scheduledPushes).set({ status: "sent" }).where(eq(t.scheduledPushes.id, id));
+}
+
+/* ---------------------------------------------------------------------------
+ * Account deletion
+ * ------------------------------------------------------------------------- */
+
+/**
+ * Permanently delete everything an owner owns — the data half of account
+ * deletion. Runs in ONE transaction (all-or-nothing). DB cascades take care of
+ * the child trees (sessions→sessionExercises→setLogs, routines→routineExercises
+ * →routineSets, programs→programDays, pushSubscriptions→scheduledPushes), so we
+ * only delete the roots, then the standalone owner-scoped tables.
+ *
+ * Two deliberate exceptions:
+ *  - `sharedRoutines` are LEFT in place — they're self-contained public snapshots
+ *    that should survive the author leaving (caller's product choice).
+ *  - Custom `exercises` are removed only when NO routine/session still references
+ *    them. Importing a shared routine reuses the author's `exerciseId`
+ *    (see `importShared`), so another user may point at this owner's custom
+ *    exercise; deleting it would orphan their plan, so we keep referenced ones.
+ *
+ * The Supabase auth user itself is deleted separately by the caller (needs the
+ * service-role admin API, which lives in the web app, not here).
+ */
+export async function deleteAccountData(ownerId: string) {
+  await db.transaction(async (tx) => {
+    // Roots first — cascades clear their owned child rows.
+    await tx.delete(t.sessions).where(eq(t.sessions.ownerId, ownerId));
+    await tx.delete(t.routines).where(eq(t.routines.ownerId, ownerId));
+    await tx.delete(t.programs).where(eq(t.programs.ownerId, ownerId));
+    await tx.delete(t.pushSubscriptions).where(eq(t.pushSubscriptions.ownerId, ownerId));
+    // Standalone owner-scoped tables (no cascade parent).
+    await tx.delete(t.personalRecords).where(eq(t.personalRecords.ownerId, ownerId));
+    await tx.delete(t.bodyMetrics).where(eq(t.bodyMetrics.ownerId, ownerId));
+    await tx.delete(t.bodyWeightLogs).where(eq(t.bodyWeightLogs.ownerId, ownerId));
+    await tx.delete(t.userProfile).where(eq(t.userProfile.ownerId, ownerId));
+    // Custom exercises — only those no surviving routine/session references.
+    await tx.delete(t.exercises).where(
+      and(
+        eq(t.exercises.ownerId, ownerId),
+        eq(t.exercises.isCustom, true),
+        notExists(
+          tx
+            .select({ one: sql`1` })
+            .from(t.routineExercises)
+            .where(eq(t.routineExercises.exerciseId, t.exercises.id)),
+        ),
+        notExists(
+          tx
+            .select({ one: sql`1` })
+            .from(t.sessionExercises)
+            .where(eq(t.sessionExercises.exerciseId, t.exercises.id)),
+        ),
+      ),
+    );
+  });
+}
diff --git a/packages/db/src/ingest/dedup-legacy-exercises.ts b/packages/db/src/ingest/dedup-legacy-exercises.ts
new file mode 100644
index 0000000..83de115
--- /dev/null
+++ b/packages/db/src/ingest/dedup-legacy-exercises.ts
@@ -0,0 +1,179 @@
+import { and, eq, inArray, ne, sql } from "drizzle-orm";
+import {
+  isApplicable,
+  matchLegacyExercise,
+  type LegacyMatch,
+  type MatchExercise,
+} from "@rackd/core";
+import { db } from "../db";
+import {
+  exercises,
+  personalRecords,
+  programTemplateExercises,
+  routineExercises,
+  sessionExercises,
+} from "../schema";
+
+/**
+ * Dedup the original hand-written seed (ids `ex_*`, source `rackd`) against the
+ * imported free-exercise-db library. For each legacy exercise we find the
+ * imported row that should absorb it (same primary muscle + matching name),
+ * repoint every reference (routine/session/PR/template) onto the import, then
+ * delete the now-unreferenced legacy row.
+ *
+ * Safety:
+ * - Custom user exercises (isCustom=true) are never touched — only the seed.
+ * - A legacy row is deleted ONLY when it has an applicable match AND zero
+ *   references remain after repointing. Anything weak/unmatched is left in
+ *   place and reported for an operator to resolve via LEGACY_OVERRIDES.
+ * - Everything runs in one transaction; --dry-run writes nothing.
+ *
+ *   pnpm --filter @rackd/db ingest:dedup-legacy [-- --dry-run]
+ */
+
+/** The four tables that hold a foreign key onto exercises.id. */
+const REF_TABLES = [
+  {
+    name: "routine_exercises",
+    table: routineExercises,
+    col: routineExercises.exerciseId,
+  },
+  {
+    name: "session_exercises",
+    table: sessionExercises,
+    col: sessionExercises.exerciseId,
+  },
+  {
+    name: "personal_records",
+    table: personalRecords,
+    col: personalRecords.exerciseId,
+  },
+  {
+    name: "program_template_exercises",
+    table: programTemplateExercises,
+    col: programTemplateExercises.exerciseId,
+  },
+] as const;
+
+type RefCounts = Record<string, number>;
+
+async function referenceCounts(legacyIds: string[]): Promise<Map<string, RefCounts>> {
+  const counts = new Map<string, RefCounts>();
+  for (const id of legacyIds) counts.set(id, {});
+  if (legacyIds.length === 0) return counts;
+
+  for (const { name, table, col } of REF_TABLES) {
+    const rows = await db
+      .select({ exerciseId: col, n: sql<number>`count(*)::int` })
+      .from(table)
+      .where(inArray(col, legacyIds))
+      .groupBy(col);
+    for (const r of rows) {
+      const id = r.exerciseId as string;
+      if (id) counts.get(id)![name] = r.n;
+    }
+  }
+  return counts;
+}
+
+const totalRefs = (c: RefCounts): number => Object.values(c).reduce((a, b) => a + b, 0);
+
+export async function dedupLegacyExercises(opts: { dryRun?: boolean } = {}): Promise<void> {
+  // Legacy seed = source 'rackd', non-custom. Custom user exercises share the
+  // default source but are isCustom=true, so they're excluded here.
+  const legacy = (await db
+    .select({
+      id: exercises.id,
+      name: exercises.name,
+      primaryMuscle: exercises.primaryMuscle,
+      source: exercises.source,
+    })
+    .from(exercises)
+    .where(and(eq(exercises.source, "rackd"), eq(exercises.isCustom, false)))) as MatchExercise[];
+
+  const candidates = (await db
+    .select({
+      id: exercises.id,
+      name: exercises.name,
+      primaryMuscle: exercises.primaryMuscle,
+      source: exercises.source,
+    })
+    .from(exercises)
+    .where(ne(exercises.source, "rackd"))) as MatchExercise[];
+
+  console.log(`[dedup] ${legacy.length} legacy exercises, ${candidates.length} import candidates`);
+  if (legacy.length === 0) {
+    console.log("[dedup] nothing to do — no legacy rows.");
+    return;
+  }
+
+  const matches: LegacyMatch[] = legacy.map((l) => matchLegacyExercise(l, candidates));
+  const refs = await referenceCounts(legacy.map((l) => l.id));
+  const nameById = new Map(legacy.map((l) => [l.id, l.name]));
+
+  // Report table — every legacy row, sorted unresolved-first.
+  const ordered = [...matches].sort((a, b) => Number(isApplicable(a)) - Number(isApplicable(b)));
+  console.log("\n[dedup] match report:");
+  for (const m of ordered) {
+    const tag = isApplicable(m) ? "APPLY" : "SKIP ";
+    const r = totalRefs(refs.get(m.legacyId) ?? {});
+    console.log(
+      `  ${tag} ${m.legacyId} (${nameById.get(m.legacyId)})` +
+        `  →  ${m.targetId ?? "—"}${m.targetName ? ` (${m.targetName})` : ""}` +
+        `  [${m.confidence} ${m.score.toFixed(2)} via ${m.via}, ${r} refs]`,
+    );
+  }
+
+  const applicable = matches.filter(isApplicable);
+  const skipped = matches.length - applicable.length;
+  console.log(
+    `\n[dedup] ${applicable.length} applicable, ${skipped} left in place (weak/unmatched).`,
+  );
+
+  if (opts.dryRun) {
+    console.log("[dedup] dry run — no changes written.");
+    return;
+  }
+  if (applicable.length === 0) {
+    console.log("[dedup] no applicable matches — nothing written.");
+    return;
+  }
+
+  let repointed = 0;
+  let deleted = 0;
+  await db.transaction(async (tx) => {
+    for (const m of applicable) {
+      const target = m.targetId!;
+      for (const { table, col } of REF_TABLES) {
+        await tx.update(table).set({ exerciseId: target }).where(eq(col, m.legacyId));
+      }
+      repointed++;
+    }
+
+    // Re-count after repointing; delete only fully-dereferenced legacy rows.
+    const after = await referenceCounts(applicable.map((m) => m.legacyId));
+    const deletable = applicable
+      .map((m) => m.legacyId)
+      .filter((id) => totalRefs(after.get(id) ?? {}) === 0);
+    const stillReferenced = applicable.length - deletable.length;
+    if (stillReferenced > 0) {
+      console.warn(`[dedup] ${stillReferenced} legacy rows still referenced post-repoint — kept.`);
+    }
+    if (deletable.length) {
+      await tx.delete(exercises).where(inArray(exercises.id, deletable));
+      deleted = deletable.length;
+    }
+  });
+
+  console.log(`[dedup] repointed ${repointed} legacy exercises, deleted ${deleted} rows.`);
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const dryRun = process.argv.includes("--dry-run");
+  dedupLegacyExercises({ dryRun })
+    .then(() => process.exit(0))
+    .catch((e) => {
+      console.error("[dedup] failed", e);
+      process.exit(1);
+    });
+}
diff --git a/packages/db/src/ingest/download-media.ts b/packages/db/src/ingest/download-media.ts
new file mode 100644
index 0000000..792f258
--- /dev/null
+++ b/packages/db/src/ingest/download-media.ts
@@ -0,0 +1,110 @@
+import { eq, like } from "drizzle-orm";
+import { db } from "../db";
+import { exerciseMedia, exercises } from "../schema";
+import { getS3Config, putObject } from "../s3";
+
+/**
+ * Mirror source exercise images to our own object store (Tigris on Fly, MinIO in
+ * dev) and rewrite exercise_media.url to the mirrored URL. Decouples us from the
+ * source CDN + enables offline caching. Idempotent + resumable: only rows still
+ * pointing at the source host are processed, so re-runs skip mirrored media.
+ *
+ *   pnpm --filter @rackd/db ingest:media [-- --limit=100 --dry-run]
+ */
+
+const SOURCE_HOST = "raw.githubusercontent.com";
+const CONCURRENCY = 6;
+
+const CONTENT_TYPE: Record<string, string> = {
+  jpg: "image/jpeg",
+  jpeg: "image/jpeg",
+  png: "image/png",
+  webp: "image/webp",
+  gif: "image/gif",
+};
+
+function extOf(url: string): string {
+  const m = url.split("?")[0]?.match(/\.([a-z0-9]+)$/i);
+  return (m?.[1] ?? "jpg").toLowerCase();
+}
+
+/** Run `worker` over `items` with bounded concurrency. */
+async function pool<T>(
+  items: T[],
+  limit: number,
+  worker: (item: T) => Promise<void>,
+): Promise<void> {
+  let i = 0;
+  const runners = Array.from({ length: Math.min(limit, items.length) }, async () => {
+    while (i < items.length) {
+      const idx = i++;
+      await worker(items[idx]!);
+    }
+  });
+  await Promise.all(runners);
+}
+
+export async function downloadMedia(
+  opts: { limit?: number; dryRun?: boolean } = {},
+): Promise<void> {
+  const cfg = getS3Config(); // throws early if storage isn't configured
+
+  let rows = await db
+    .select({
+      id: exerciseMedia.id,
+      exerciseId: exerciseMedia.exerciseId,
+      url: exerciseMedia.url,
+      originalUrl: exerciseMedia.originalUrl,
+      order: exerciseMedia.order,
+    })
+    .from(exerciseMedia)
+    .where(like(exerciseMedia.url, `%${SOURCE_HOST}%`));
+  if (opts.limit) rows = rows.slice(0, opts.limit);
+
+  console.log(`[media] ${rows.length} image(s) to mirror`);
+  if (opts.dryRun) {
+    console.log("[media] dry run — sample:", rows.slice(0, 3));
+    return;
+  }
+
+  let done = 0;
+  let failed = 0;
+  await pool(rows, CONCURRENCY, async (row) => {
+    const src = row.originalUrl ?? row.url;
+    try {
+      const res = await fetch(src);
+      if (!res.ok) throw new Error(`GET ${src} → HTTP ${res.status}`);
+      const ext = extOf(src);
+      const body = Buffer.from(await res.arrayBuffer());
+      const key = `exercises/${row.exerciseId}/${row.order}.${ext}`;
+      const publicUrl = await putObject(cfg, key, body, CONTENT_TYPE[ext] ?? "image/jpeg");
+
+      await db.update(exerciseMedia).set({ url: publicUrl }).where(eq(exerciseMedia.id, row.id));
+      // Repoint the exercise thumbnail if it still references the source URL.
+      await db
+        .update(exercises)
+        .set({ thumbnailUrl: publicUrl })
+        .where(eq(exercises.thumbnailUrl, row.url));
+
+      done++;
+      if (done % 100 === 0) console.log(`[media] ${done}/${rows.length} mirrored`);
+    } catch (e) {
+      failed++;
+      console.warn(`[media] failed ${row.id}: ${(e as Error).message}`);
+    }
+  });
+
+  console.log(`[media] done — ${done} mirrored, ${failed} failed`);
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const limit =
+    Number(process.argv.find((a) => a.startsWith("--limit="))?.split("=")[1]) || undefined;
+  const dryRun = process.argv.includes("--dry-run");
+  downloadMedia({ limit, dryRun })
+    .then(() => process.exit(0))
+    .catch((e) => {
+      console.error("[media] failed", e);
+      process.exit(1);
+    });
+}
