+    if (routineId === undefined) {
+      if (existing) await api(`/api/program-days/${existing.id}`, { method: "DELETE" });
+    } else if (existing) {
+      await api(`/api/program-days/${existing.id}`, {
+        method: "PUT",
+        body: JSON.stringify({ routineId }),
