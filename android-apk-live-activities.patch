+
+  function closeSheet() {
+    setOpenDayId(null);
+    setOpenWeekday(null);
+  }
+
+  async function addDay() {
+    if (days.length >= 7) return;
+    await api(`/api/programs/${programId}/days`, {
+      method: "POST",
+      body: JSON.stringify({ order: days.length + 1 }),
