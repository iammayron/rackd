@@ -0,0 +1,73 @@
+"use client";
+
+import * as React from "react";
+
+export interface StatTileProps extends React.HTMLAttributes<HTMLDivElement> {
+  label?: React.ReactNode;
+  value: React.ReactNode;
+  unit?: React.ReactNode;
+  caption?: React.ReactNode;
+  /** Big number color. @default "accent" */
+  tone?: "accent" | "plain";
+}
+
+/**
+ * Dashboard stat tile: an eyebrow label over a big tabular number with an
+ * optional unit + caption. The number rides coral by default (accent), or
+ * inherits text color when `tone="plain"`.
+ */
+export function StatTile({
+  label,
+  value,
+  unit,
+  caption,
+  tone = "accent",
+  style,
+  ...rest
+}: StatTileProps) {
+  return (
+    <div style={{ fontFamily: "var(--font-sans)", ...style }} {...rest}>
+      {label && (
+        <div
+          style={{
+            fontSize: "var(--text-xs)",
+            fontWeight: 600,
+            textTransform: "uppercase",
+            letterSpacing: "var(--tracking-eyebrow)",
+            color: "var(--text-muted)",
+            marginBottom: 4,
+            whiteSpace: "nowrap",
+          }}
+        >
+          {label}
+        </div>
+      )}
+      <div style={{ display: "flex", alignItems: "baseline", gap: 6, whiteSpace: "nowrap" }}>
+        <span
+          style={{
+            fontSize: "var(--text-2xl)",
+            fontWeight: 800,
+            lineHeight: 1,
+            letterSpacing: "-0.01em",
+            color: tone === "accent" ? "var(--accent)" : "var(--text)",
+            fontVariantNumeric: "tabular-nums lining-nums",
+          }}
+        >
+          {value}
+        </span>
+        {unit && (
+          <span
+            style={{ fontSize: "var(--text-base)", fontWeight: 600, color: "var(--text-muted)" }}
+          >
+            {unit}
+          </span>
+        )}
+      </div>
+      {caption && (
+        <div style={{ fontSize: "var(--text-sm)", color: "var(--text-muted)", marginTop: 2 }}>
+          {caption}
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/packages/ui/src/components/TabBar.tsx b/packages/ui/src/components/TabBar.tsx
new file mode 100644
index 0000000..cce90c9
--- /dev/null
+++ b/packages/ui/src/components/TabBar.tsx
@@ -0,0 +1,67 @@
+"use client";
+
+import * as React from "react";
+
+export type TabItem = string | { key?: string; label: React.ReactNode };
+
+export interface TabBarProps extends Omit<React.HTMLAttributes<HTMLElement>, "onSelect"> {
+  items?: TabItem[];
+  /** Key of the active tab. */
+  active?: string;
+  onSelect?: (key: string) => void;
+}
+
+/**
+ * Bottom tab bar — thumb-zone navigation across the main sections. Active tab
+ * rides coral + bold. Sits sticky at the bottom; clears the home indicator.
+ */
+export function TabBar({ items = [], active, onSelect, style, ...rest }: TabBarProps) {
+  return (
+    <nav
+      style={{
+        position: "sticky",
+        bottom: 0,
+        display: "flex",
+        borderTop: "1px solid var(--border)",
+        background: "var(--bg)",
+        gap: 4,
+        padding: "10px 10px",
+        paddingBottom: "calc(12px + env(safe-area-inset-bottom))",
+        fontFamily: "var(--font-sans)",
+        ...style,
+      }}
+      {...rest}
+    >
+      {items.map((it) => {
+        const key = typeof it === "string" ? it : (it.key ?? String(it.label));
+        const label = typeof it === "string" ? it : it.label;
+        const isActive = key === active;
+        return (
+          <button
+            key={key}
+            type="button"
+            onClick={() => onSelect?.(key)}
+            style={{
+              flex: 1,
+              minHeight: 56,
+              padding: "10px 6px",
+              borderRadius: 14,
+              border: "none",
+              background: isActive ? "var(--accent-wash)" : "transparent",
+              cursor: "pointer",
+              fontFamily: "inherit",
+              fontSize: 13,
+              letterSpacing: "0.01em",
+              lineHeight: 1,
+              fontWeight: isActive ? 700 : 500,
+              color: isActive ? "var(--accent)" : "var(--text-muted)",
+              transition: "color var(--dur) var(--ease-out), background var(--dur) var(--ease-out)",
+            }}
+          >
+            {label}
+          </button>
+        );
+      })}
+    </nav>
+  );
+}
