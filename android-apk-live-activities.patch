@@ -0,0 +1,69 @@
+"use client";
+
+import { RestTimerRing, Button, mmss } from "@rackd/ui";
+import { useTimerStore } from "./timer-store";
+import { useLiveActivity } from "./live-activity";
+
+/**
+ * Rest dock: the signature RestTimerRing as a bare progress dial with the
+ * countdown beside it. Controlled by the wall-clock timer store.
+ */
+export function RestTimerBar() {
+  useLiveActivity();
+  const state = useTimerStore((s) => s.state);
+  const fired = useTimerStore((s) => s.fired);
+  // subscribe to `now` so the dial re-renders each tick
+  useTimerStore((s) => s.now);
+  const remaining = useTimerStore((s) => s.remaining());
+  const add = useTimerStore((s) => s.add);
+  const skip = useTimerStore((s) => s.skip);
+
+  if (state.status === "idle") return null;
+
+  const total = (state.durationMs || 1) / 1000;
+
+  return (
+    <div
+      role="region"
+      aria-label="Rest timer"
+      className="sticky bottom-0 z-40 border-t border-[var(--border)] bg-[var(--surface)] shadow-[var(--shadow-lg)] rk-sheet-up"
+    >
+      {/* flex-wrap is a safety valve: on a very narrow phone the controls drop
+          to a second row instead of crowding the countdown or overflowing. */}
+      <div className="mx-auto flex max-w-[440px] flex-wrap items-center gap-y-2 gap-x-3 px-4 pt-3 pb-[calc(12px+var(--safe-bottom))]">
+        <RestTimerRing
+          remaining={Math.ceil(remaining / 1000)}
+          total={total}
+          fired={fired}
+          showLabel={false}
+          size={38}
+          strokeWidth={5}
+        />
+        <div className="flex min-w-0 flex-col leading-none">
+          <span
+            className={`text-[10px] font-bold uppercase tracking-[0.08em] ${
+              fired ? "text-[var(--success)]" : "text-[var(--text-muted)]"
+            }`}
+          >
+            {fired ? "Rest over" : "Rest"}
+          </span>
+          <span className="mt-1 text-xl font-extrabold leading-none tabular-nums text-[var(--text)]">
+            {fired ? "0:00" : mmss(remaining)}
+          </span>
+        </div>
+
+        <div className="ms-auto flex shrink-0 items-center gap-2 ps-2">
+          <Button variant="secondary" size="sm" onClick={() => add(-15)} disabled={fired}>
+            −15s
+          </Button>
+          <Button variant="secondary" size="sm" onClick={() => add(15)} disabled={fired}>
+            +15s
+          </Button>
+          <Button variant="ghost" size="sm" onClick={skip}>
+            {fired ? "Dismiss" : "Skip"}
+          </Button>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/apps/web/src/features/active-workout/RpeSheet.tsx b/apps/web/src/features/active-workout/RpeSheet.tsx
new file mode 100644
index 0000000..10cba40
--- /dev/null
+++ b/apps/web/src/features/active-workout/RpeSheet.tsx
@@ -0,0 +1,189 @@
+"use client";
+
+import { useState } from "react";
+import { BottomSheet } from "@/components/BottomSheet";
+
+type Tier = {
+  /** Canonical 1–6 value persisted via onChoose — history/progress stay numeric. */
+  level: number;
+  headline: string;
+  description: string;
+  /** Easy→hard color. Warm/green end uses semantic tokens; cool low end is inline (no blue token yet). */
+  color: string;
+};
+
+/**
+ * Six perceived-exertion (breathing/talking) levels, easiest → hardest, on a
+ * clean 1–6 scale. We persist the single level number; {@link tierForValue}
+ * maps any stored value back onto its level, clamping legacy out-of-range logs.
+ */
+const TIERS: Tier[] = [
+  {
+    level: 1,
+    headline: "Very light",
+    description: "Hardly any exertion, but more than sleeping, slow walk, etc.",
+    color: "#3b82f6",
+  },
+  {
+    level: 2,
+    headline: "Light",
+    description: "Feels like you can maintain for hours. Easy to breathe and carry a conversation.",
+    color: "#06b6d4",
+  },
+  {
+    level: 3,
+    headline: "Moderate",
+    description:
+      "Breathing heavily, can hold a short conversation. Still somewhat comfortable, but becoming noticeably more challenging.",
+    color: "var(--success)",
+  },
+  {
+    level: 4,
+    headline: "Vigorous",
+    description: "Borderline uncomfortable. Short of breath, can speak a sentence.",
+    color: "var(--warning)",
+  },
+  {
+    level: 5,
+    headline: "Very hard",
+    description:
+      "Very difficult to maintain exercise intensity. Can barely breathe and speak only a few words.",
+    color: "color-mix(in srgb, var(--danger) 50%, var(--warning))",
+  },
+  {
+    level: 6,
+    headline: "Max effort",
+    description:
+      "Feels almost impossible to keep going. Completely out of breath, unable to talk. Cannot maintain for more than a very short time.",
+    color: "var(--danger)",
+  },
+];
+
+/** The level a stored value falls on (clamped to 1–6 so legacy logs still resolve). */
+function tierForValue(v: number | undefined): Tier | null {
+  if (v == null) return null;
+  const i = Math.min(TIERS.length, Math.max(1, Math.round(v))) - 1;
+  return TIERS[i] ?? null;
+}
+
+/**
+ * The selected-fill color the sheet uses for a given rpe value (reuses
+ * {@link tierForValue} / the canonical {@link TIERS} list — no color duplication).
+ * Returns null when there's no value, so callers can fall back to a neutral look.
+ */
+export function rpeColor(v: number | undefined): string | null {
+  return tierForValue(v)?.color ?? null;
+}
+
+/**
+ * RPE picker rendered inside the reusable {@link BottomSheet}: a single row of
+ * six color-coded level chips with a live headline + description below. Picking
+ * a level persists it (the caller's `onChoose`) but keeps the sheet open so the
+ * label stays readable; dismissal is explicit (Done / None / backdrop). Pure UI
+ * — persistence and the open flag live with the caller.
+ */
+export function RpeSheet({
+  open,
+  value,
+  onChoose,
+  onClose,
+}: {
+  open: boolean;
+  value: number | undefined;
+  onChoose: (v: number | undefined) => void;
+  onClose: () => void;
+}) {
+  // The tier whose meaning is shown below the row: the one under the pointer/
+  // focus (preview), else the current selection. Drives the live description.
+  const [preview, setPreview] = useState<Tier | null>(null);
+  const selected = tierForValue(value);
+  const shown = preview ?? selected ?? null;
+
+  return (
+    <BottomSheet
+      open={open}
+      onClose={onClose}
+      title="Effort · RPE"
+      subtitle="How hard was that set?"
+    >
+      <div onPointerLeave={() => setPreview(null)}>
+        {/* Six levels on one row — equal-width chips that shrink to fit. */}
+        <div className="flex gap-1">
+          {TIERS.map((tier) => {
+            const on = selected === tier;
+            return (
+              <button
+                key={tier.level}
+                type="button"
+                onClick={() => onChoose(tier.level)}
+                onPointerEnter={() => setPreview(tier)}
+                onFocus={() => setPreview(tier)}
+                onBlur={() => setPreview(null)}
+                aria-pressed={on}
+                aria-label={`RPE ${tier.level} — ${tier.headline}`}
+                className="flex-1 min-w-0 inline-flex items-center justify-center min-h-12 rounded-[var(--radius-sm)] border text-[15px] font-extrabold tabular-nums"
+                style={{
+                  color: on ? "var(--text-on-accent)" : tier.color,
+                  background: on
+                    ? tier.color
+                    : `color-mix(in srgb, ${tier.color} 12%, transparent)`,
+                  borderColor: on
+                    ? tier.color
+                    : `color-mix(in srgb, ${tier.color} 35%, transparent)`,
+                }}
+              >
+                {tier.level}
+              </button>
+            );
+          })}
+        </div>
+
+        {/* Live headline + description of the highlighted level, or a neutral hint. */}
+        <div className="mt-3 min-h-12 flex flex-col items-center justify-center gap-1 text-center">
+          {shown ? (
+            <>
+              <div className="flex items-center justify-center gap-2 text-[15px] font-semibold">
+                <span className="tabular-nums" style={{ color: shown.color }}>
+                  {shown.level}
+                </span>
+                <span className="text-[var(--text-muted)]">·</span>
+                <span style={{ color: shown.color }}>{shown.headline}</span>
+              </div>
+              <p className="max-w-[42ch] text-[13px] leading-snug text-[var(--text-muted)]">
+                {shown.description}
+              </p>
+            </>
+          ) : (
+            <span className="text-[15px] font-semibold text-[var(--text-muted)]">
+              Tap to rate effort
+            </span>
+          )}
+        </div>
+
+        {/* Picking a level keeps the sheet open (so the label reads); these are
+            the explicit exits — None clears, Done confirms and closes. */}
+        <div className="mt-3 flex gap-2">
+          <button
+            type="button"
+            onClick={() => onChoose(undefined)}
+            aria-pressed={value == null}
+            className={`flex-1 min-h-11 rounded-[var(--radius-md)] border text-[15px] font-semibold ${
+              value == null
+                ? "bg-[var(--surface-2)] text-[var(--text)] border-[var(--border)]"
+                : "bg-transparent text-[var(--text-muted)] border-[var(--border)]"
+            }`}
+          >
+            None
+          </button>
+          <button
+            type="button"
+            onClick={onClose}
+            className="flex-1 min-h-11 rounded-[var(--radius-md)] bg-[var(--accent)] text-[var(--text-on-accent)] text-[15px] font-bold focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
+          >
+            Done
+          </button>
+        </div>
+      </div>
+    </BottomSheet>
+  );
+}
diff --git a/apps/web/src/features/active-workout/SaveBackSheet.tsx b/apps/web/src/features/active-workout/SaveBackSheet.tsx
new file mode 100644
index 0000000..33ab473
--- /dev/null
+++ b/apps/web/src/features/active-workout/SaveBackSheet.tsx
@@ -0,0 +1,144 @@
+"use client";
+
+import { useState } from "react";
+import { Button, SegmentedControl } from "@rackd/ui";
+import type { SessionDiff } from "@rackd/core";
+
+export type SaveBackMode = "numbers" | "exercises" | "everything";
+export type SaveBackTarget = "here" | "everywhere";
+
+/**
+ * Save-back sheet (#3). Shown after finishing only when the session diverged
+ * from the routine's prescription. Lets the user push changes back — reps &
+ * weights, the new exercise lineup, or everything — and (when the routine is in
+ * the active program) choose whether it applies to just this program or
+ * everywhere. "Just log it" skips straight to the summary.
+ */
+export function SaveBackSheet({
+  diff,
+  routineName,
+  programName,
+  onSkip,
+  onSave,
+}: {
+  diff: SessionDiff;
+  routineName: string;
+  /** Active-program name when the routine is scheduled in it; enables the target toggle. */
+  programName?: string | null;
+  onSkip: () => void;
+  onSave: (mode: SaveBackMode, target: SaveBackTarget) => void;
+}) {
+  const both = diff.exercisesChanged && diff.numbersChanged;
+  const [mode, setMode] = useState<SaveBackMode>(
+    both ? "everything" : diff.exercisesChanged ? "exercises" : "numbers",
+  );
+  const [target, setTarget] = useState<SaveBackTarget>(programName ? "here" : "everywhere");
+  const [saving, setSaving] = useState(false);
+
+  const options: { v: SaveBackMode; t: string; d: string }[] = [];
+  if (diff.numbersChanged)
+    options.push({
+      v: "numbers",
+      t: "Update reps & weights",
+      d: "Keep the same exercises — save the loads you actually hit as the new targets.",
+    });
+  if (diff.exercisesChanged)
+    options.push({
+      v: "exercises",
+      t: "Save exercise changes",
+      d: "Adopt the exercises you added or swapped; keep the prescribed numbers.",
+    });
+  options.push({
+    v: "everything",
+    t: "Update everything",
+    d: "Save the exercises and the numbers exactly as performed.",
+  });
+
+  function save() {
+    if (saving) return;
+    setSaving(true);
+    onSave(mode, programName ? target : "everywhere");
+  }
+
+  return (
+    <div className="fixed inset-0 z-[90] flex items-end justify-center">
+      <div onClick={onSkip} aria-hidden="true" className="absolute inset-0 bg-black/50" />
+      <div
+        role="dialog"
+        aria-label="Save changes"
+        className="relative w-[min(440px,100%)] max-h-[92vh] flex flex-col overflow-hidden bg-[var(--bg)] rounded-t-[var(--radius-lg)] shadow-[var(--shadow-lg)]"
+      >
+        <div className="pt-2.5 pb-1 flex justify-center shrink-0">
+          <span className="w-[38px] h-[5px] rounded-full bg-[var(--border)]" />
+        </div>
+        <div className="overflow-y-auto px-5 pt-2 pb-[calc(20px+env(safe-area-inset-bottom))]">
+          <h2 className="mt-1 mb-0.5 text-[19px] font-extrabold">Save changes to {routineName}?</h2>
+          <p className="mt-0 mb-4 text-[13.5px] text-[var(--text-muted)] leading-snug">
+            You changed this workout from its plan. Choose what to keep — or just log it as a
+            one-off.
+          </p>
+
+          <div className="flex flex-col gap-2.5 mb-[18px]">
+            {options.map((o) => {
+              const on = mode === o.v;
+              return (
+                <button
+                  key={o.v}
+                  type="button"
+                  onClick={() => setMode(o.v)}
+                  className={`flex gap-3 items-start text-left p-3.5 rounded-[var(--radius-md)] cursor-pointer ${
+                    on
+                      ? "bg-[var(--accent-wash)] border border-[var(--accent)]"
+                      : "bg-[var(--surface)] border border-[var(--border)]"
+                  }`}
+                >
+                  <span
+                    aria-hidden="true"
+                    className="mt-px shrink-0 w-5 h-5 rounded-full bg-[var(--surface)] box-border"
+                    style={{ border: on ? "6px solid var(--accent)" : "2px solid var(--border)" }}
+                  />
+                  <span className="min-w-0">
+                    <span className="block font-bold text-[15px]">{o.t}</span>
+                    <span className="block text-[13px] text-[var(--text-muted)] mt-0.5 leading-snug">
+                      {o.d}
+                    </span>
+                  </span>
+                </button>
+              );
+            })}
+          </div>
+
+          {programName && (
+            <div className="mb-[18px]">
+              <div className="text-xs font-bold uppercase tracking-[0.05em] text-[var(--text-muted)] mb-2">
+                Apply to
+              </div>
+              <SegmentedControl
+                options={[
+                  { value: "here", label: "This program" },
+                  { value: "everywhere", label: "Everywhere" },
+                ]}
+                value={target}
+                onChange={(v) => setTarget(v as SaveBackTarget)}
+                size="sm"
+                style={{ display: "flex", width: "100%" }}
+              />
+              <p className="mt-2 mx-0.5 text-[12.5px] text-[var(--text-muted)] leading-snug">
+                {target === "here"
+                  ? `Only ${programName} changes — it gets its own copy of the routine. The shared routine and other programs stay as they are.`
+                  : "Every program that uses this routine gets the change."}
+              </p>
+            </div>
+          )}
+
+          <Button variant="primary" size="lg" fullWidth disabled={saving} onClick={save}>
+            {saving ? "Saving…" : "Save changes"}
+          </Button>
+          <Button variant="ghost" fullWidth onClick={onSkip} style={{ marginTop: 8 }}>
+            Just log it
+          </Button>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/apps/web/src/features/active-workout/SetRow.tsx b/apps/web/src/features/active-workout/SetRow.tsx
new file mode 100644
index 0000000..3eba933
--- /dev/null
+++ b/apps/web/src/features/active-workout/SetRow.tsx
@@ -0,0 +1,329 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import { estimate1RM } from "@rackd/core";
+import { api } from "@/lib/api";
+import { queryClient, qk } from "@/lib/query";
+import { useUnit } from "@/lib/units-store";
+import { useTimerStore } from "./timer-store";
+import { useConfirm } from "@/components/ConfirmDialog";
+import { RpeSheet, rpeColor } from "./RpeSheet";
+import { SetValueSheet } from "./SetValueSheet";
+
+export interface SetRowData {
+  id: string;
+  order: number;
+  weight: number;
+  reps: number;
+  completed: boolean;
+  rpe?: number;
+}
+
+/** Weight/reps display cell — a tap target that opens the slide-up editor. */
+const CELL =
+  "w-full min-w-0 overflow-hidden inline-flex items-center justify-center min-h-11 text-center bg-[var(--surface-2)] text-[var(--text)] border border-[var(--border)] rounded-[var(--radius-sm)] text-[15px] tabular-nums px-0.5 @[20rem]:text-lg focus:outline-none focus:ring-2 focus:ring-[var(--accent)]";
+
+/**
+ * The set line: #, previous, weight, reps, RPE, complete, delete.
+ * Fixed tracks stay tappable; the two value tracks share whatever width is
+ * left so the row fits a phone instead of spilling past the card.
+ */
+export const SET_LINE =
+  "grid w-full min-w-0 items-center gap-x-1 [grid-template-columns:1.25rem_minmax(0,3.25rem)_minmax(0,1fr)_minmax(0,1fr)_2.5rem_2.75rem_1.5rem]";
+
+/**
+ * One set row: weight, reps, complete toggle. Completing a set starts the
+ * global rest timer (the core interaction of the whole app). Weight and reps
+ * are tap targets — tapping opens {@link SetValueSheet} to edit/step the value.
+ */
+export function SetRow({
+  data,
+  sessionId,
+  restSec,
+  prevLabel,
+  startsRest = true,
+  onCompleted,
+}: {
+  data: SetRowData;
+  /** Owning session — used to invalidate its tree after a write. */
+  sessionId: string;
+  restSec: number;
+  prevLabel?: string;
+  /** false for a supersetted exercise that isn't last in its group — go straight to the partner. */
+  startsRest?: boolean;
+  /** Called after a set is successfully marked complete (not on un-complete). */
+  onCompleted?: (set: SetRowData) => void;
+}) {
+  const confirm = useConfirm();
+  const startTimer = useTimerStore((s) => s.start);
+  const { unit, display, toKg } = useUnit();
+  const [weight, setWeight] = useState(data.weight ? String(display(data.weight)) : "");
+  const [reps, setReps] = useState(String(data.reps || ""));
+  const [rpe, setRpe] = useState<number | undefined>(data.rpe);
+  const [rpeOpen, setRpeOpen] = useState(false);
+  // Which value's editor is open (one shared sheet serves both).
+  const [editing, setEditing] = useState<"weight" | "reps" | null>(null);
+
+  // Keep the exercise we just edited in view (#18). Opening the value sheet
+  // pops the keyboard, which on mobile can drift the page; when the sheet
+  // closes we re-anchor the owning card. `block: "nearest"` is a no-op if it
+  // never moved, so this only corrects an actual drift.
+  const rowRef = useRef<HTMLDivElement>(null);
+  const wasEditing = useRef(false);
+  useEffect(() => {
+    if (editing) {
+      wasEditing.current = true;
+    } else if (wasEditing.current) {
+      wasEditing.current = false;
+      const card = rowRef.current?.closest<HTMLElement>("[data-sex]");
+      if (card) {
+        requestAnimationFrame(() => card.scrollIntoView({ behavior: "smooth", block: "nearest" }));
+      }
+    }
+  }, [editing]);
+
+  // Off-screen input focused synchronously inside the open tap (below). Mobile
+  // browsers only raise the soft keyboard for a focus() that happens within a
+  // user gesture; the sheet's real input mounts a tick later, too late to
+  // qualify. Warming the keyboard here lets SetValueSheet hand focus to the
+  // real field without the keyboard ever closing.
+  const warmupRef = useRef<HTMLInputElement>(null);
+
+  /** Open a value editor, keeping the mobile keyboard up across the sheet mount. */
+  function openEditor(field: "weight" | "reps") {
+    const warm = warmupRef.current;
+    if (warm) {
+      warm.inputMode = field === "weight" ? "decimal" : "numeric";
+      warm.focus({ preventScroll: true });
+    }
+    setEditing(field);
+  }
+
+  // While our own write is in flight we don't overwrite local state from the
+  // query — otherwise the echo (our write coming back through the subscription)
+  // could clobber the value we just committed (write→subscribe loop).
+  const weightWriting = useRef(false);
+  const repsWriting = useRef(false);
+
+  // Resync local state when the persisted value changes, but only when no write
+  // of ours is pending. Keeps the canonical-kg → display conversion at the edge.
+  useEffect(() => {
+    if (!weightWriting.current) setWeight(data.weight ? String(display(data.weight)) : "");
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [data.weight, unit]);
+  useEffect(() => {
+    if (!repsWriting.current) setReps(String(data.reps || ""));
+  }, [data.reps]);
+  useEffect(() => {
+    setRpe(data.rpe);
+  }, [data.rpe]);
+
+  /** Commit an edited weight (display units): optimistic local update + persist. */
+  async function commitWeight(value: number) {
+    setWeight(value ? String(value) : "");
+    weightWriting.current = true;
+    try {
+      await api(`/api/set-logs/${data.id}`, {
+        method: "PUT",
+        body: JSON.stringify({ weight: value ? toKg(value) : 0 }),
+      });
+      queryClient.invalidateQueries({ queryKey: qk.session(sessionId) });
+    } finally {
+      weightWriting.current = false;
+    }
+  }
+  async function commitReps(value: number) {
+    setReps(value ? String(value) : "");
+    repsWriting.current = true;
+    try {
+      await api(`/api/set-logs/${data.id}`, {
+        method: "PUT",
+        body: JSON.stringify({ reps: value }),
+      });
+      queryClient.invalidateQueries({ queryKey: qk.session(sessionId) });
+    } finally {
+      repsWriting.current = false;
+    }
+  }
+
+  /**
+   * Pick effort from the sheet. Tapping the already-selected value clears it.
+   * Persists (incl. clearing — `updateSet` honours `rpe: undefined`) but leaves
+   * the sheet open so the selected level's label stays readable; the sheet's
+   * own Done/None/backdrop dismiss it.
+   */
+  async function chooseRpe(v: number | undefined) {
+    const next = rpe === v ? undefined : v;
+    setRpe(next);
+    // Send explicit null to clear — `undefined` would be dropped by JSON.stringify
+    // and the route keys off `"rpe" in body` to distinguish clear from untouched.
+    await api(`/api/set-logs/${data.id}`, {
+      method: "PUT",
+      body: JSON.stringify({ rpe: next ?? null }),
+    });
+    queryClient.invalidateQueries({ queryKey: qk.session(sessionId) });
+  }
+
+  async function toggle() {
+    const next = !data.completed;
+    const kg = weight ? toKg(Number(weight)) : 0;
+    const repCount = Number(reps) || 0;
+
+    // Only write weight/reps when they actually changed. Edits already persist
+    // through commitWeight/commitReps, so re-sending them here is redundant —
+    // and harmful: the local value is seeded from `display(kg)`, which rounds to
+    // one decimal, so kg → display → kg is lossy in lb (42.5 kg shows as 93.7 lb
+    // and converts back to 42.5019). Ticking a set would silently drift its
+    // stored weight, leaving sets that read identically on screen holding
+    // different numbers — which is what kept the "copy to remaining sets?"
+    // prompt firing for sets the lifter had already matched up.
+    const weightChanged = display(kg) !== display(data.weight);
+    const repsChanged = repCount !== data.reps;
+    const effectiveKg = weightChanged ? kg : data.weight;
+    const effectiveReps = repsChanged ? repCount : data.reps;
+
+    await api(`/api/set-logs/${data.id}`, {
+      method: "PUT",
+      body: JSON.stringify({
+        completed: next,
+        ...(weightChanged ? { weight: kg } : {}),
+        ...(repsChanged ? { reps: repCount } : {}),
+      }),
+    });
+    queryClient.invalidateQueries({ queryKey: qk.session(sessionId) });
+    if (next && startsRest) startTimer(restSec);
+    if (next)
+      onCompleted?.({
+        ...data,
+        weight: effectiveKg,
+        reps: effectiveReps,
+        completed: true,
+      });
+  }
+
+  return (
+    <div ref={rowRef} className={data.completed ? "opacity-70" : undefined}>
+      <div className={`${SET_LINE} py-2`}>
+        <span className="min-w-0 text-center font-semibold text-[var(--text-muted)]">
+          {data.order}
+        </span>
+        <span className="min-w-0 truncate text-sm text-[var(--text-muted)]">
+          {prevLabel ?? "—"}
+        </span>
+
+        <button
+          type="button"
+          onClick={() => openEditor("weight")}
+          aria-label={`Set ${data.order} weight${weight ? ` ${weight} ${unit}` : ""}, tap to edit`}
+          aria-haspopup="dialog"
+          className={CELL}
+        >
+          {weight ? weight : <span className="text-[var(--text-muted)]">{unit}</span>}
+        </button>
+
+        <button
+          type="button"
+          onClick={() => openEditor("reps")}
+          aria-label={`Set ${data.order} reps${reps ? ` ${reps}` : ""}, tap to edit`}
+          aria-haspopup="dialog"
+          className={CELL}
+        >
+          {reps ? reps : <span className="text-[var(--text-muted)]">reps</span>}
+        </button>
+
+        {/* RPE — inline after reps; tap opens the bottom-sheet picker. The chip's
+          fill matches the sheet's selected tier color for the same value. */}
+        <button
+          type="button"
+          onClick={() => setRpeOpen(true)}
+          aria-label={`Set ${data.order} effort (RPE)`}
+          aria-haspopup="dialog"
+          className={`w-full min-w-0 inline-flex items-center justify-center min-h-11 rounded-[var(--radius-sm)] border font-bold focus:outline-none focus:ring-2 focus:ring-[var(--accent)] ${
+            rpe != null
+              ? "text-[var(--text-on-accent)] border-transparent text-[15px] tabular-nums @[20rem]:text-lg"
+              : "bg-[var(--surface-2)] text-[var(--text-muted)] border-[var(--border)] text-xs"
+          }`}
+          style={rpe != null ? { background: rpeColor(rpe) ?? "var(--accent)" } : undefined}
+        >
+          {rpe != null ? rpe : "RPE"}
+        </button>
+
+        <button
+          type="button"
+          onClick={toggle}
+          aria-label={data.completed ? "Mark set incomplete" : "Complete set"}
+          title={
+            weight && reps
+              ? `est 1RM ${Math.round(estimate1RM(Number(weight), Number(reps)))} ${unit}`
+              : undefined
+          }
+          className={`w-full min-w-0 inline-flex items-center justify-center min-h-11 rounded-[var(--radius-sm)] border border-[var(--border)] text-lg font-bold ${
+            data.completed
+              ? "bg-[var(--success)] text-[#06231a]"
+              : "bg-[var(--surface-2)] text-[var(--text)]"
+          }`}
+        >
+          ✓
+        </button>
+        <button
+          type="button"
+          onClick={async () => {
+            // An untouched, empty row has nothing to lose — deleting a set you
+            // just added by mistake shouldn't cost two taps mid-workout. Once
+            // it carries numbers or a tick, confirm before it's gone.
+            const hasData = data.completed || data.weight > 0 || data.reps > 0;
+            if (hasData) {
+              const ok = await confirm({
+                title: `Remove set ${data.order}?`,
+                message: "The weight, reps and effort logged on it are deleted.",
+                confirmLabel: "Remove set",
+              });
+              if (!ok) return;
+            }
+            await api(`/api/set-logs/${data.id}`, { method: "DELETE" });
+            queryClient.invalidateQueries({ queryKey: qk.session(sessionId) });
+          }}
+          aria-label="Delete set"
+          className="min-h-11 w-full min-w-0 bg-transparent border-none text-lg text-[var(--text-muted)]"
+        >
+          ×
+        </button>
+      </div>
+
+      {/* Hidden keyboard primer — see openEditor. Off-screen + non-interactive,
+          focused only programmatically to keep the soft keyboard up on mobile.
+          Kept out of the set grid so it can't steal a column. */}
+      <input
+        ref={warmupRef}
+        tabIndex={-1}
+        aria-hidden="true"
+        inputMode="decimal"
+        className="pointer-events-none fixed top-0 left-0 h-px w-px opacity-0"
+        style={{ fontSize: 16 }}
+      />
+
+      <SetValueSheet
+        open={editing === "weight"}
+        title={`Weight (${unit})`}
+        initial={Number(weight) || 0}
+        step={unit === "kg" ? 2.5 : 5}
+        suffix={unit}
+        inputMode="decimal"
+        onCommit={commitWeight}
+        onClose={() => setEditing(null)}
+      />
+      <SetValueSheet
+        open={editing === "reps"}
+        title="Reps"
+        initial={Number(reps) || 0}
+        step={1}
+        integer
+        inputMode="numeric"
+        onCommit={commitReps}
+        onClose={() => setEditing(null)}
+      />
+
+      <RpeSheet open={rpeOpen} value={rpe} onChoose={chooseRpe} onClose={() => setRpeOpen(false)} />
+    </div>
+  );
+}
diff --git a/apps/web/src/features/active-workout/SetValueSheet.tsx b/apps/web/src/features/active-workout/SetValueSheet.tsx
new file mode 100644
index 0000000..209f1d3
--- /dev/null
+++ b/apps/web/src/features/active-workout/SetValueSheet.tsx
@@ -0,0 +1,171 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { BottomSheet } from "@/components/BottomSheet";
+
+const round2 = (n: number) => Math.round(n * 100) / 100;
+
+/**
+ * Shared slide-up editor for a single numeric set value (weight OR reps),
+ * parameterized so one component serves both. Renders inside the reusable
+ * {@link BottomSheet}: a big [−][input][＋] cluster plus Done.
+ *
+ * Works in DISPLAY units (the caller converts to canonical kg on commit). The
+ * field is a real input (type directly); −/＋ step it. Opening or focusing the
+ * field selects all, since users usually type a fresh value. Any dismissal
+ * (Done / backdrop / Escape / drag-down) commits the final value.
+ */
+export function SetValueSheet({
+  open,
+  title,
+  initial,
+  step,
+  min = 0,
+  integer = false,
+  suffix,
+  inputMode,
+  onClose,
+  onCommit,
+}: {
+  open: boolean;
+  title: string;
+  /** Current value in display units, used to seed the field on open. */
+  initial: number;
+  /** Amount the −/＋ buttons add or subtract. */
+  step: number;
+  min?: number;
+  /** Reps are integers; weight is decimal. Controls rounding + keypad. */
+  integer?: boolean;
+  /** Unit label shown after the value (e.g. "kg" / "lb"); omit for reps. */
+  suffix?: string;
+  inputMode: "decimal" | "numeric";
+  onClose: () => void;
+  /** Final value in display units, called once on confirm/close. */
+  onCommit: (value: number) => void;
+}) {
+  const [text, setText] = useState("");
+  const inputRef = useRef<HTMLInputElement>(null);
+
+  // Latest values mirrored into refs so the stable commit callback (below) can
+  // read them without changing identity — and so seeding reads the value as of
+  // the moment the sheet opened, never re-seeding mid-typing.
+  const textRef = useRef(text);
+  textRef.current = text;
+  const initialRef = useRef(initial);
+  initialRef.current = initial;
+  const onCommitRef = useRef(onCommit);
+  onCommitRef.current = onCommit;
+  const onCloseRef = useRef(onClose);
+  onCloseRef.current = onClose;
+
+  // Seed the field + focus and select-all — ONCE per open. Depending only on
+  // `open` means typing (which updates `text`) can never re-run this and
+  // re-select, and a query echo changing `initial` can't clobber what's typed.
+  useEffect(() => {
+    if (!open) return;
+    setText(initialRef.current ? String(initialRef.current) : "");
+    // Focus synchronously: a deferred focus (rAF/timeout) lands outside the tap
+    // that opened the sheet, so mobile browsers focus the field but never raise
+    // the keyboard. SetRow's warm-up input keeps the keyboard up across the
+    // mount; this just hands focus to the real field. Select-all is deferred a
+    // frame so the seeded value (set above, not yet painted) is what highlights.
+    inputRef.current?.focus({ preventScroll: true });
+    // setSelectionRange (not .select(), which iOS Safari ignores) so the first
+    // keystroke replaces the value. Deferred a frame so the seeded value is
+    // painted before we select it.
+    const id = requestAnimationFrame(() => {
+      const el = inputRef.current;
+      if (el) el.setSelectionRange(0, el.value.length);
+    });
+    return () => cancelAnimationFrame(id);
+  }, [open]);
+
+  function clamp(v: number): number {
+    if (!Number.isFinite(v)) return min;
+    return Math.max(min, integer ? Math.round(v) : round2(v));
+  }
+  function nudge(dir: 1 | -1) {
+    setText(String(clamp(clamp(Number(text)) + dir * step)));
+  }
+  // Stable identity (only `min`/`integer` matter, both constant per field) so
+  // BottomSheet's `[open, onClose]` focus effect doesn't re-fire on every
+  // keystroke and steal focus back into a select-all loop.
+  const commitAndClose = useCallback(() => {
+    onCommitRef.current(clamp(Number(textRef.current)));
+    onCloseRef.current();
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [min, integer]);
+
+  return (
+    <BottomSheet open={open} onClose={commitAndClose} title={title}>
+      <div className="flex flex-col gap-4 pt-1 pb-1">
+        <div className="flex items-stretch gap-3">
+          <button
+            type="button"
+            onClick={() => nudge(-1)}
+            aria-label={`Decrease ${title}`}
+            className="h-16 w-16 shrink-0 inline-flex items-center justify-center rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--surface-2)] text-[var(--text)] select-none focus:outline-none focus:ring-2 focus:ring-[var(--accent)] active:bg-[var(--surface)]"
+          >
+            {/* SVG glyph (not a text "−"): the text minus sits high in the line
+                box; an SVG centers exactly and matches the + weight. */}
+            <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
+              <path
+                d="M5 12h14"
+                fill="none"
+                stroke="currentColor"
+                strokeWidth="2.5"
+                strokeLinecap="round"
+              />
+            </svg>
+          </button>
+
+          <div className="flex flex-1 min-w-0 items-center justify-center gap-1 px-3 rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--surface-2)] focus-within:ring-2 focus-within:ring-[var(--accent)]">
+            <input
+              ref={inputRef}
+              inputMode={inputMode}
+              enterKeyHint="done"
+              value={text}
+              onChange={(e) => setText(e.target.value)}
+              onFocus={(e) => e.currentTarget.setSelectionRange(0, e.currentTarget.value.length)}
+              onKeyDown={(e) => {
+                // Keyboard's Done/checkmark (or Enter) commits, like the button.
+                if (e.key === "Enter") {
+                  e.preventDefault();
+                  commitAndClose();
+                }
+              }}
+              aria-label={title}
+              className="min-w-0 w-full text-center bg-transparent text-[var(--text)] text-4xl font-bold tabular-nums py-3 focus:outline-none"
+            />
+            {suffix && <span className="shrink-0 text-lg text-[var(--text-muted)]">{suffix}</span>}
+          </div>
+
+          <button
+            type="button"
+            onClick={() => nudge(1)}
+            aria-label={`Increase ${title}`}
+            className="h-16 w-16 shrink-0 inline-flex items-center justify-center rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--surface-2)] text-[var(--text)] select-none focus:outline-none focus:ring-2 focus:ring-[var(--accent)] active:bg-[var(--surface)]"
+          >
+            <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
+              <path
+                d="M12 5v14M5 12h14"
+                fill="none"
+                stroke="currentColor"
+                strokeWidth="2.5"
+                strokeLinecap="round"
+              />
+            </svg>
+          </button>
+        </div>
+
+        <button
+          type="button"
+          onClick={commitAndClose}
+          className="w-full min-h-12 rounded-[var(--radius-md)] bg-[var(--accent)] text-[var(--text-on-accent)] text-base font-bold focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
+        >
+          Done
+        </button>
+      </div>
+    </BottomSheet>
+  );
+}
diff --git a/apps/web/src/features/active-workout/copy-targets.ts b/apps/web/src/features/active-workout/copy-targets.ts
new file mode 100644
index 0000000..92994d2
--- /dev/null
+++ b/apps/web/src/features/active-workout/copy-targets.ts
@@ -0,0 +1,35 @@
+/** The fields `copyTargets` needs from a set — structural, so SetRowData fits. */
+export interface CopyCandidate {
+  order: number;
+  /** Canonical kg. */
+  weight: number;
+  reps: number;
+  completed: boolean;
+}
+
+/**
+ * Which later sets the "copy weight & reps to remaining sets?" prompt should
+ * offer to overwrite: sets after `from` that aren't done yet and don't already
+ * show the same numbers.
+ *
+ * `display` is the caller's kg → display-unit rounding, and comparing through it
+ * is the whole point. Storage is canonical kg while the lifter reads a value
+ * rounded to one decimal, so two sets can differ far below what's shown — 42.5
+ * kg and 42.5019 kg both read "93.7 lb". Comparing raw kg made the prompt fire
+ * for sets the lifter had already matched up, which reads as a bug.
+ *
+ * Returns [] when there's nothing worth prompting about; the caller shows no
+ * toast in that case.
+ */
+export function copyTargets<T extends CopyCandidate>(
+  sets: readonly T[],
+  from: CopyCandidate,
+  display: (kg: number) => number,
+): T[] {
+  return sets.filter(
+    (s) =>
+      s.order > from.order &&
+      !s.completed &&
+      (display(s.weight) !== display(from.weight) || s.reps !== from.reps),
+  );
+}
diff --git a/apps/web/src/features/active-workout/live-activity.ts b/apps/web/src/features/active-workout/live-activity.ts
new file mode 100644
index 0000000..d784560
--- /dev/null
+++ b/apps/web/src/features/active-workout/live-activity.ts
@@ -0,0 +1,92 @@
+"use client";
+
+import { useEffect, useRef } from "react";
+import { useTimerStore } from "./timer-store";
+
+/**
+ * Android Lock Screen "Live Activity" controller.
+ *
+ * Uses the Web MediaSession API backed by an inaudible looping audio element.
+ * On Android, this displays a persistent, ongoing controller on the lock screen
+ * and in the notification shade, allowing lifters to see their remaining rest
+ * and tap "Skip" or "+30s" directly from their lock screen!
+ */
+export function useLiveActivity(activeExerciseName?: string, currentSetInfo?: string) {
+  const { state, remaining, add, skip } = useTimerStore();
+  const audioRef = useRef<HTMLAudioElement | null>(null);
+
+  useEffect(() => {
+    if (typeof window === "undefined" || !("mediaSession" in navigator)) return;
+
+    // Create an ambient silent audio element to anchor the media session on Android
+    if (!audioRef.current) {
+      // 1-second silent WAV base64
+      const silentWav =
+        "data:audio/wav;base64,UklGRigAAABXQVZFZm10IBIAAAABAAEARKwAAIhYAQACABAAAABkYXRhAgAAAAEA";
+      const audio = new Audio(silentWav);
+      audio.loop = true;
+      audioRef.current = audio;
+    }
+
+    const audio = audioRef.current;
+    const isRunning = state.status === "running";
+
+    if (isRunning) {
+      audio.play().catch(() => {
+        // Autoplay may need user gesture
+      });
+
+      const ms = remaining();
+      const totalSec = Math.max(0, Math.ceil(ms / 1000));
+      const mins = Math.floor(totalSec / 60);
+      const secs = totalSec % 60;
+      const formatted = `${mins}:${secs.toString().padStart(2, "0")}`;
+
+      navigator.mediaSession.metadata = new MediaMetadata({
+        title: `Rest: ${formatted}`,
+        artist: activeExerciseName || "Rackd Workout",
+        album: currentSetInfo || "Resting between sets",
+        artwork: [
+          { src: "/icons/icon-192.png", sizes: "192x192", type: "image/png" },
+          { src: "/icons/icon-512.png", sizes: "512x512", type: "image/png" },
+        ],
+      });
+
+      navigator.mediaSession.setActionHandler("previoustrack", () => {
+        add(30);
+      });
+
+      navigator.mediaSession.setActionHandler("nexttrack", () => {
+        skip();
+      });
+
+      navigator.mediaSession.setActionHandler("pause", () => {
+        skip();
+      });
+
+      navigator.mediaSession.setActionHandler("play", () => {
+        audio.play().catch(() => {});
+      });
+    } else {
+      if (audio) {
+        audio.pause();
+      }
+      if (activeExerciseName) {
+        navigator.mediaSession.metadata = new MediaMetadata({
+          title: activeExerciseName,
+          artist: "Rackd Workout",
+          album: currentSetInfo || "Workout in progress",
+          artwork: [
+            { src: "/icons/icon-192.png", sizes: "192x192", type: "image/png" },
+          ],
+        });
+      }
+    }
+
+    return () => {
+      if (audio) {
+        audio.pause();
+      }
+    };
+  }, [state.status, state.endAt, remaining, add, skip, activeExerciseName, currentSetInfo]);
+}
diff --git a/apps/web/src/features/active-workout/timer-store.ts b/apps/web/src/features/active-workout/timer-store.ts
new file mode 100644
index 0000000..5b56c1d
--- /dev/null
+++ b/apps/web/src/features/active-workout/timer-store.ts
@@ -0,0 +1,120 @@
+"use client";
+
+import { create } from "zustand";
+import { idleTimer, startTimer, addTime, remainingMs, isFired, type TimerState } from "@rackd/core";
+import {
+  requestNotifyPermission,
+  showLocalNotification,
+  scheduleRestPush,
+  rescheduleRestPush,
+  cancelRestPush,
+} from "@/lib/push";
+import { playRestChime, unlockAudio } from "@/lib/sound";
+
+/**
+ * Global rest timer — one instance for the whole app, survives navigation.
+ * Wall-clock based (core FSM); a single interval ticks `now` for re-renders.
+ * On fire: play audio chime + strong vibration + high priority notification.
+ */
+
+/** How long the green "Rest over" state lingers before auto-dismissing. */
+const FIRED_AUTOCLOSE_MS = 2500;
+
+interface TimerStore {
+  state: TimerState;
+  now: number;
+  fired: boolean;
+  start: (durationSec: number) => void;
+  add: (deltaSec: number) => void;
+  skip: () => void;
+  remaining: () => number;
+}
+
+let intervalId: ReturnType<typeof setInterval> | null = null;
+let fireTimeoutId: ReturnType<typeof setTimeout> | null = null;
+
+function clearTimers() {
+  if (intervalId) {
+    clearInterval(intervalId);
+    intervalId = null;
+  }
+  if (fireTimeoutId) {
+    clearTimeout(fireTimeoutId);
+    fireTimeoutId = null;
+  }
+}
+
+function fireEffects() {
+  // Strong gym vibration pattern (loud buzz on hard gym surface or in pocket)
+  if (typeof navigator !== "undefined" && "vibrate" in navigator) {
+    navigator.vibrate([400, 150, 400, 150, 600]);
+  }
+  // Play synthesized gym timer beeps through speaker
+  playRestChime();
+
+  // High priority notification with sound & vibration
+  void showLocalNotification("Rest over", {
+    body: "Time for your next set.",
+    tag: "rest-timer",
+    renotify: true,
+    silent: false,
+    requireInteraction: true,
+    vibrate: [400, 150, 400, 150, 600],
+  });
+}
+
+export const useTimerStore = create<TimerStore>((set, get) => ({
+  state: idleTimer(),
+  now: 0,
+  fired: false,
+
+  start: (durationSec) => {
+    void requestNotifyPermission();
+    unlockAudio();
+    clearTimers();
+    const now = Date.now();
+    const state = startTimer(durationSec, now);
+    set({ state, now, fired: false });
+    // Queue a server-side push for endAt so a backgrounded/locked phone still
+    // gets alerted (its JS is suspended and can't fire the local notif below).
+    if (state.endAt !== undefined) void scheduleRestPush(state.endAt);
+
+    intervalId = setInterval(() => {
+      const now = Date.now();
+      const { state, fired } = get();
+      if (!fired && isFired(state, now)) {
+        fireEffects();
+        void cancelRestPush();
+        set({ now, fired: true });
+        if (intervalId) clearInterval(intervalId);
+        intervalId = null;
+        // Linger on the green "rest over" state, then auto-dismiss.
+        fireTimeoutId = setTimeout(() => {
+          fireTimeoutId = null;
+          get().skip();
+        }, FIRED_AUTOCLOSE_MS);
+        return;
+      }
+      set({ now });
+    }, 250);
+  },
+
+  add: (deltaSec) => {
+    set((s) => ({ state: addTime(s.state, deltaSec) }));
+    const { state } = get();
+    if (state.status === "running" && state.endAt !== undefined) {
+      void rescheduleRestPush(state.endAt);
+    }
+  },
+
+  skip: () => {
+    clearTimers();
+    void cancelRestPush();
+    set({ state: idleTimer(), fired: false });
+  },
+
+  remaining: () => {
+    const { state, now } = get();
+    return remainingMs(state, now);
+  },
+}));
