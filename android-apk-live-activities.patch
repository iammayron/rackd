diff --git a/packages/ui/src/components/MuscleMap.tsx b/packages/ui/src/components/MuscleMap.tsx
new file mode 100644
index 0000000..41d51f3
--- /dev/null
+++ b/packages/ui/src/components/MuscleMap.tsx
@@ -0,0 +1,100 @@
+"use client";
+
+import * as React from "react";
+import { muscleHue } from "./MuscleVisualizer";
+import { ANTERIOR, POSTERIOR, type MusclePolygons } from "./muscle-map-paths";
+
+/**
+ * Self-owned anatomical muscle map — front + back figures whose muscle regions
+ * highlight by @rackd/core MuscleGroup. No external API, no runtime dependency:
+ * SVG polygons (vendored from react-body-highlighter, MIT — see
+ * muscle-map-paths.ts) tinted by our highlight logic. Themeable + offline.
+ *
+ * Each worked region is tinted by its own muscle hue (matching the bars in
+ * MuscleVisualizer): primary at full intensity, secondary at reduced opacity,
+ * everything else a faint neutral so the body still reads as a body.
+ */
+
+type Role = "primary" | "secondary" | "none";
+
+/** Faint body fill for muscles this exercise doesn't work. */
+const BASE_FILL = "color-mix(in oklch, var(--text-muted) 22%, transparent)";
+
+/**
+ * Source muscle key → our coarse MuscleGroup. Keys not present here (neck, head,
+ * knees, abductors/adductor) never highlight — they only draw the silhouette.
+ */
+const RBH_TO_GROUP: Record<string, string> = {
+  chest: "chest",
+  obliques: "abs",
+  abs: "abs",
+  biceps: "biceps",
+  triceps: "triceps",
+  "front-deltoids": "shoulders",
+  "back-deltoids": "shoulders",
+  quadriceps: "quads",
+  calves: "calves",
+  forearm: "forearms",
+  trapezius: "traps",
+  "upper-back": "back",
+  "lower-back": "back",
+  gluteal: "glutes",
+  hamstring: "hamstrings",
+  "left-soleus": "calves",
+  "right-soleus": "calves",
+};
+
+export interface MuscleMapProps extends Omit<React.SVGProps<SVGSVGElement>, "primary"> {
+  /** Primary mover (full-intensity highlight). */
+  primary: string;
+  /** Assisting groups (reduced-intensity highlight). */
+  secondary?: string[];
+  /** Pixel height; width scales to the 2-figure aspect. */
+  size?: number;
+}
+
+export function MuscleMap({ primary, secondary = [], size = 104, style, ...rest }: MuscleMapProps) {
+  const p = (primary ?? "").toLowerCase();
+  const sec = new Set(secondary.filter(Boolean).map((m) => m.toLowerCase()));
+  const full = p === "fullbody";
+
+  const roleFor = (group: string | undefined): Role => {
+    if (!group) return "none";
+    if (full) return "primary";
+    if (group === p) return "primary";
+    if (sec.has(group)) return "secondary";
+    return "none";
+  };
+
+  const renderFigure = (data: MusclePolygons[], offsetX: number) => (
+    <g transform={`translate(${offsetX} 0)`}>
+      {data.map((region) => {
+        const group = RBH_TO_GROUP[region.muscle];
+        const role = roleFor(group);
+        const fill = role === "none" ? BASE_FILL : `oklch(0.64 0.15 ${muscleHue(group!)})`;
+        const opacity = role === "secondary" ? 0.55 : 1;
+        return (
+          <g key={region.muscle} fill={fill} fillOpacity={opacity}>
+            {region.points.map((pts, i) => (
+              <polygon key={i} points={pts} />
+            ))}
+          </g>
+        );
+      })}
+    </g>
+  );
+
+  return (
+    <svg
+      viewBox="0 0 210 220"
+      height={size}
+      role="img"
+      aria-label="Muscles worked"
+      style={{ flexShrink: 0, ...style }}
+      {...rest}
+    >
+      {renderFigure(ANTERIOR, 0)}
+      {renderFigure(POSTERIOR, 110)}
+    </svg>
+  );
+}
diff --git a/packages/ui/src/components/MuscleVisualizer.tsx b/packages/ui/src/components/MuscleVisualizer.tsx
new file mode 100644
index 0000000..edf6f9a
--- /dev/null
+++ b/packages/ui/src/components/MuscleVisualizer.tsx
@@ -0,0 +1,191 @@
+"use client";
+
+import * as React from "react";
+import { MuscleMap } from "./MuscleMap";
+
+/**
+ * Muscle → accent hue (OKLCH), driving placeholder media + the visualizer bars.
+ * Keyed by the @rackd/core MuscleGroup values (lowercase); tolerant of any case.
+ */
+const HUE: Record<string, number> = {
+  chest: 8,
+  back: 212,
+  shoulders: 270,
+  biceps: 50,
+  triceps: 32,
+  forearms: 38,
+  quads: 150,
+  hamstrings: 175,
+  glutes: 330,
+  calves: 160,
+  abs: 192,
+  traps: 230,
+  fullbody: 220,
+  other: 220,
+};
+
+export function muscleHue(muscle: string): number {
+  return HUE[(muscle ?? "").toLowerCase()] ?? 220;
+}
+
+/**
+ * Deterministic tinted gradient keyed off a muscle's hue — the placeholder for
+ * exercise media until real photos/clips ship (use the real thumbnailUrl/clipUrl
+ * when present, this when not).
+ */
+export function exerciseGradient(muscle: string): string {
+  const h = muscleHue(muscle);
+  return `linear-gradient(135deg, oklch(0.62 0.13 ${h}) 0%, oklch(0.48 0.15 ${h + 18}) 100%)`;
+}
+
+function label(m: string): string {
+  if (!m) return m;
+  if (m.toLowerCase() === "fullbody") return "Full body";
+  return m.charAt(0).toUpperCase() + m.slice(1);
+}
+
+/** Fine-grained muscle involvement (from the exercise detail API). */
+export interface MuscleInvolvementView {
+  /** Display name, e.g. "Lats". */
+  name: string;
+  /** Coarse MuscleGroup the muscle rolls up to — drives hue + the map region. */
+  canonicalGroup: string;
+  role: string;
+  /** 0..1 — drives bar width. */
+  activation: number;
+}
+
+export interface MuscleVisualizerProps extends Omit<React.HTMLAttributes<HTMLDivElement>, "title"> {
+  /** Primary mover (rendered at full intensity). */
+  primary: string;
+  /** Assisting groups (rendered at reduced intensity). */
+  secondary?: string[];
+  /**
+   * Fine-grained involvement (optional). When present, the bars show the real
+   * muscle names + activation weights; the map still highlights by coarse group.
+   * Falls back to primary/secondary when absent.
+   */
+  muscles?: MuscleInvolvementView[];
+  /** Show the anatomical map beside the bars. */
+  showBody?: boolean;
+}
+
+interface Bar {
+  key: string;
+  label: string;
+  level: number;
+  role: string;
+  hue: number;
+}
+
+/**
+ * Muscles-worked visualizer: a self-owned anatomical MuscleMap (front + back,
+ * worked regions highlighted) beside per-muscle intensity bars. With fine
+ * `muscles` data the bars show real muscle names + activation; otherwise they
+ * fall back to the coarse primary/secondary groups.
+ */
+export function MuscleVisualizer({
+  primary,
+  secondary = [],
+  muscles,
+  showBody = true,
+  style,
+  ...rest
+}: MuscleVisualizerProps) {
+  const fine = muscles && muscles.length > 0 ? muscles : null;
+
+  const bars: Bar[] = fine
+    ? fine.map((m, i) => ({
+        key: `${m.name}-${i}`,
+        label: m.name,
+        level: m.activation,
+        role: label(m.role),
+        hue: muscleHue(m.canonicalGroup),
+      }))
+    : [{ muscle: primary, level: 1, role: "Primary" }]
+        .concat(
+          secondary.filter(Boolean).map((m) => ({ muscle: m, level: 0.55, role: "Secondary" })),
+        )
+        .map((w) => ({
+          key: `${w.role}-${w.muscle}`,
+          label: label(w.muscle),
+          level: w.level,
+          role: w.role,
+          hue: muscleHue(w.muscle),
+        }));
+
+  // Map highlights by coarse group — derive from fine data when present.
+  const mapPrimary = fine
+    ? (fine.find((m) => m.role.toLowerCase() === "primary")?.canonicalGroup ??
+      fine[0]!.canonicalGroup)
+    : primary;
+  const mapSecondary = fine
+    ? Array.from(new Set(fine.map((m) => m.canonicalGroup))).filter((g) => g !== mapPrimary)
+    : secondary;
+
+  return (
+    <div style={{ display: "flex", gap: 14, alignItems: "center", ...style }} {...rest}>
+      {showBody && (
+        <MuscleMap
+          primary={mapPrimary}
+          secondary={mapSecondary}
+          size={104}
+          style={{
+            borderRadius: "var(--radius)",
+            background: "var(--surface-2)",
+            border: "1px solid var(--border)",
+            padding: "8px 6px",
+          }}
+        />
+      )}
+      <div
+        style={{
+          flex: 1,
+          minWidth: 0,
+          display: "flex",
+          flexDirection: "column",
+          gap: 10,
+          justifyContent: "center",
+        }}
+      >
+        {bars.map((b) => (
+          <div key={b.key}>
+            <div style={{ display: "flex", alignItems: "baseline", gap: 8, marginBottom: 4 }}>
+              <span style={{ fontWeight: 700, fontSize: 14 }}>{b.label}</span>
+              <span
+                style={{
+                  marginLeft: "auto",
+                  fontSize: 11,
+                  fontWeight: 700,
+                  color: "var(--text-muted)",
+                  textTransform: "uppercase",
+                  letterSpacing: "0.04em",
+                  whiteSpace: "nowrap",
+                }}
+              >
+                {b.role}
+              </span>
+            </div>
+            <div
+              style={{
+                height: 7,
+                borderRadius: 999,
+                background: "var(--surface-2)",
+                overflow: "hidden",
+              }}
+            >
+              <div
+                style={{
+                  width: `${Math.round(b.level * 100)}%`,
+                  height: "100%",
+                  borderRadius: 999,
+                  background: `oklch(0.62 0.14 ${b.hue})`,
+                }}
+              />
+            </div>
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+}
