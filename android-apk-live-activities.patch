+import { describe, it, expect } from "vitest";
+import {
+  createRoutine,
+  addRoutineExercise,
+  addRoutineSet,
+  startSessionFromRoutine,
+  startSession,
+  addSessionExercise,
+  logSet,
+  deleteRoutine,
+  createProgram,
+  addProgramDay,
+  setProgramActive,
+  getSaveBackContext,
+} from "../src/index";
+import { OWNER_A } from "./factories";
+
+/** Build a routine with one bench exercise + two prescribed sets. */
+async function benchRoutine() {
+  const routine = await createRoutine({ ownerId: OWNER_A, name: "Bench Day" });
+  const re = await addRoutineExercise({ routineId: routine.id, exerciseId: "ex_bench", order: 1 });
+  await addRoutineSet({ routineExerciseId: re.id, order: 1, targetReps: 5, targetWeight: 100 });
+  await addRoutineSet({ routineExerciseId: re.id, order: 2, targetReps: 5, targetWeight: 100 });
+  return routine;
+}
+
+describe("getSaveBackContext", () => {
+  it("returns null when the session has no routineId", async () => {
+    const session = await startSession({ ownerId: OWNER_A, name: "Ad-hoc", now: 1000 });
+    expect(await getSaveBackContext(session.id)).toBeNull();
+  });
+
+  it("returns null when the source routine was deleted", async () => {
+    const routine = await benchRoutine();
+    const session = await startSessionFromRoutine({
+      routineId: routine.id,
+      ownerId: OWNER_A,
+      now: 1000,
+    });
+    await deleteRoutine(routine.id); // session.routineId is SET NULL by the FK
+    expect(await getSaveBackContext(session.id)).toBeNull();
+  });
+
+  it("returns prescription and performed DiffExercise shapes", async () => {
+    const routine = await benchRoutine();
+    const session = await startSessionFromRoutine({
+      routineId: routine.id,
+      ownerId: OWNER_A,
+      now: 1000,
+    });
+    // Re-perform with different numbers via a manual session exercise + logs.
+    const se = await addSessionExercise({
+      sessionId: session.id,
+      exerciseId: "ex_squat",
+      order: 2,
+    });
+    await logSet({ sessionExerciseId: se.id, order: 1, weight: 140, reps: 3 });
+
+    const ctx = await getSaveBackContext(session.id);
+    expect(ctx).not.toBeNull();
+    expect(ctx!.routineId).toBe(routine.id);
+    expect(ctx!.routineName).toBe("Bench Day");
+    // Prescription mirrors the routine: one bench exercise, two sets at 100x5.
+    expect(ctx!.prescription).toEqual([
+      {
+        exerciseId: "ex_bench",
+        sets: [
+          { weight: 100, reps: 5 },
+          { weight: 100, reps: 5 },
+        ],
+      },
+    ]);
+    // Performed: the copied bench (two sets at 100x5, uncompleted but still logged
+    // values) followed by the ad-hoc squat set.
+    expect(ctx!.performed).toEqual([
+      {
+        exerciseId: "ex_bench",
+        sets: [
+          { weight: 100, reps: 5 },
+          { weight: 100, reps: 5 },
+        ],
+      },
+      { exerciseId: "ex_squat", sets: [{ weight: 140, reps: 3 }] },
+    ]);
+  });
+
+  it("populates program when the routine is a day in the owner's active program", async () => {
+    const routine = await benchRoutine();
+    const session = await startSessionFromRoutine({
+      routineId: routine.id,
+      ownerId: OWNER_A,
+      now: 1000,
+    });
+    const program = await createProgram({ ownerId: OWNER_A, name: "PPL" }); // first => auto-active
+    const day = await addProgramDay({ programId: program.id, order: 1, routineId: routine.id });
+
+    const ctx = await getSaveBackContext(session.id);
+    expect(ctx!.program).toEqual({ programDayId: day.id, programName: "PPL" });
+  });
+
+  it("returns null program when the matching program is inactive", async () => {
+    const routine = await benchRoutine();
+    const session = await startSessionFromRoutine({
+      routineId: routine.id,
+      ownerId: OWNER_A,
+      now: 1000,
+    });
+    // First program (auto-active) maps the routine; a second program is made
+    // active instead, deactivating the first.
+    const programA = await createProgram({ ownerId: OWNER_A, name: "Block A" });
+    await addProgramDay({ programId: programA.id, order: 1, routineId: routine.id });
+    const programB = await createProgram({ ownerId: OWNER_A, name: "Block B" });
+    await setProgramActive({ programId: programB.id, ownerId: OWNER_A });
+
+    const ctx = await getSaveBackContext(session.id);
+    expect(ctx!.program).toBeNull();
+  });
+});
diff --git a/packages/db/test/ownerDerivation.test.ts b/packages/db/test/ownerDerivation.test.ts
new file mode 100644
index 0000000..c943c8b
--- /dev/null
+++ b/packages/db/test/ownerDerivation.test.ts
@@ -0,0 +1,76 @@
+import { describe, it, expect } from "vitest";
+import {
+  startSession,
+  addSessionExercise,
+  addSet,
+  logSet,
+  createRoutine,
+  addRoutineExercise,
+  addRoutineSet,
+  createProgram,
+  addProgramDay,
+} from "../src/index";
+import { OWNER_B } from "./factories";
+
+/**
+ * The internal `ownerOf` helper derives a child row's ownerId from its parent.
+ * We assert it through the child-insert repo functions: build the parent owned
+ * by OWNER_B, then confirm the inserted child carries OWNER_B.
+ *
+ * The missing-parent edge is current behavior: with no parent row to read,
+ * `ownerOf` returns "" and the child is inserted with ownerId === "". Asserted
+ * here so a future change to that behavior is caught.
+ */
+
+describe("ownerId derivation from parent (via child-insert repo fns)", () => {
+  it("session children (sessionExercise → setLog) inherit the session's owner", async () => {
+    const session = await startSession({ ownerId: OWNER_B, name: "W", now: 1000 });
+
+    const se = await addSessionExercise({
+      sessionId: session.id,
+      exerciseId: "ex_bench",
+      order: 1,
+    });
+    expect(se.ownerId).toBe(OWNER_B);
+
+    const empty = await addSet({ sessionExerciseId: se.id, order: 1 });
+    expect(empty.ownerId).toBe(OWNER_B);
+
+    const logged = await logSet({ sessionExerciseId: se.id, order: 2, weight: 100, reps: 5 });
+    expect(logged.ownerId).toBe(OWNER_B);
+  });
+
+  it("routine children (routineExercise → routineSet) inherit the routine's owner", async () => {
+    const routine = await createRoutine({ ownerId: OWNER_B, name: "R" });
+
+    const re = await addRoutineExercise({
+      routineId: routine.id,
+      exerciseId: "ex_bench",
+      order: 1,
+    });
+    expect(re.ownerId).toBe(OWNER_B);
+
+    const rs = await addRoutineSet({ routineExerciseId: re.id, order: 1, targetReps: 5 });
+    expect(rs.ownerId).toBe(OWNER_B);
+  });
+
+  it("program children (programDay) inherit the program's owner", async () => {
+    const program = await createProgram({ ownerId: OWNER_B, name: "P" });
+    const day = await addProgramDay({ programId: program.id, order: 1 });
+    expect(day.ownerId).toBe(OWNER_B);
+  });
+
+  // `ownerOf` returns "" for a missing parent, but the child insert never lands:
+  // the FK constraint rejects it, so an orphaned/empty-owner row can't exist.
+  it("child insert of a non-existent parent is rejected by the FK (no orphan row)", async () => {
+    await expect(
+      addSessionExercise({ sessionId: "no-such-session", exerciseId: "ex_bench", order: 1 }),
+    ).rejects.toThrow();
+  });
+
+  it("routineSet of a non-existent routine exercise is rejected by the FK", async () => {
+    await expect(
+      addRoutineSet({ routineExerciseId: "no-such-routine-exercise", order: 1, targetReps: 5 }),
+    ).rejects.toThrow();
+  });
+});
diff --git a/packages/db/test/programRotation.test.ts b/packages/db/test/programRotation.test.ts
new file mode 100644
index 0000000..1943784
--- /dev/null
+++ b/packages/db/test/programRotation.test.ts
@@ -0,0 +1,159 @@
+import { describe, it, expect } from "vitest";
+import { eq } from "drizzle-orm";
+import { db } from "../src/db";
+import * as t from "../src/schema";
+import { createProgram, addProgramDay, setProgramSchedule, finishSession } from "../src/index";
+import { makeRoutine, makeSessionWithSets, OWNER_A } from "./factories";
+
+const cursorOf = async (programId: string) => {
+  const [row] = await db.select().from(t.programs).where(eq(t.programs.id, programId));
+  return row!.rotationCursor ?? 0;
+};
+
+/**
+ * Finishing a scheduled workout advances the active rotation program's cursor so
+ * the next day becomes "today" (it previously only moved on an explicit Skip).
+ */
+describe("finishSession — rotation cursor advance", () => {
+  it("advances to the day after the one just finished", async () => {
+    const push = await makeRoutine({ name: "Push" });
+    const pull = await makeRoutine({ name: "Pull" });
+    const legs = await makeRoutine({ name: "Legs" });
+    const program = await createProgram({ ownerId: OWNER_A, name: "PPL" }); // auto-active
+    await addProgramDay({
+      programId: program.id,
+      order: 1,
+      routineId: push.routineId,
+    });
+    await addProgramDay({
+      programId: program.id,
+      order: 2,
+      routineId: pull.routineId,
+    });
+    await addProgramDay({
+      programId: program.id,
+      order: 3,
+      routineId: legs.routineId,
+    });
+
+    // Cursor starts at 0 (Push). Finishing Push → cursor 1 (Pull).
+    const { sessionId } = await makeSessionWithSets({
+      routineId: push.routineId,
+      sets: [{ weight: 100, reps: 5 }],
+    });
+    await finishSession(sessionId, 1000);
+
+    expect(await cursorOf(program.id)).toBe(1);
+  });
+
+  it("wraps to 0 after finishing the last day", async () => {
+    const a = await makeRoutine({ name: "A" });
+    const b = await makeRoutine({ name: "B" });
+    const program = await createProgram({ ownerId: OWNER_A, name: "AB" });
+    await addProgramDay({
+      programId: program.id,
+      order: 1,
+      routineId: a.routineId,
+    });
+    await addProgramDay({
+      programId: program.id,
+      order: 2,
+      routineId: b.routineId,
+    });
+    await setProgramSchedule(program.id, { rotationCursor: 1 }); // parked on B
+
+    const { sessionId } = await makeSessionWithSets({
+      routineId: b.routineId,
+      sets: [{ weight: 50, reps: 5 }],
+    });
+    await finishSession(sessionId, 2000);
+
+    expect(await cursorOf(program.id)).toBe(0);
+  });
+
+  it("moves to the day after one finished out of order (e.g. Home 'Train next')", async () => {
+    const a = await makeRoutine({ name: "A" });
+    const b = await makeRoutine({ name: "B" });
+    const c = await makeRoutine({ name: "C" });
+    const program = await createProgram({ ownerId: OWNER_A, name: "ABC" });
+    await addProgramDay({
+      programId: program.id,
+      order: 1,
+      routineId: a.routineId,
+    });
+    await addProgramDay({
+      programId: program.id,
+      order: 2,
+      routineId: b.routineId,
+    });
+    await addProgramDay({
+      programId: program.id,
+      order: 3,
+      routineId: c.routineId,
+    });
+    // Cursor is on A (0), but the user trains C. Finishing C (index 2) → cursor 0.
+    const { sessionId } = await makeSessionWithSets({
+      routineId: c.routineId,
+      sets: [{ weight: 60, reps: 5 }],
+    });
+    await finishSession(sessionId, 3000);
+
+    expect(await cursorOf(program.id)).toBe(0);
+  });
+
+  it("does not advance for a quick (routine-less) session", async () => {
+    const a = await makeRoutine({ name: "A" });
+    const program = await createProgram({ ownerId: OWNER_A, name: "P" });
+    await addProgramDay({
+      programId: program.id,
+      order: 1,
+      routineId: a.routineId,
+    });
+
+    const { sessionId } = await makeSessionWithSets({
+      sets: [{ weight: 40, reps: 5 }],
+    }); // no routineId → quick workout
+    await finishSession(sessionId, 4000);
+
+    expect(await cursorOf(program.id)).toBe(0);
+  });
+
+  it("does not advance a weekly-mode program", async () => {
+    const a = await makeRoutine({ name: "A" });
+    const program = await createProgram({ ownerId: OWNER_A, name: "P" });
+    await addProgramDay({
+      programId: program.id,
+      order: 1,
+      routineId: a.routineId,
+      weekday: 1,
+    });
+    await setProgramSchedule(program.id, { scheduleMode: "weekly" });
+
+    const { sessionId } = await makeSessionWithSets({
+      routineId: a.routineId,
+      sets: [{ weight: 70, reps: 5 }],
+    });
+    await finishSession(sessionId, 5000);
+
+    expect(await cursorOf(program.id)).toBe(0);
+  });
+
+  it("does not advance when the finished routine isn't in the active program", async () => {
+    const inProgram = await makeRoutine({ name: "In" });
+    const other = await makeRoutine({ name: "Other" });
+    const program = await createProgram({ ownerId: OWNER_A, name: "P" });
+    await addProgramDay({
+      programId: program.id,
+      order: 1,
+      routineId: inProgram.routineId,
+    });
+
+    const { sessionId } = await makeSessionWithSets({
+      routineId: other.routineId,
+      sets: [{ weight: 80, reps: 5 }],
+    });
+    await finishSession(sessionId, 6000);
+
+    expect(await cursorOf(program.id)).toBe(0);
+  });
+});
diff --git a/packages/db/test/programs.test.ts b/packages/db/test/programs.test.ts
new file mode 100644
index 0000000..828d911
--- /dev/null
+++ b/packages/db/test/programs.test.ts
@@ -0,0 +1,118 @@
+import { describe, it, expect } from "vitest";
+import { eq } from "drizzle-orm";
+import { db } from "../src/db";
+import * as t from "../src/schema";
+import { createProgram, setProgramActive } from "../src/index";
+import { OWNER_A, OWNER_B } from "./factories";
+
+const persistedActive = async (id: string) => {
+  const [row] = await db.select().from(t.programs).where(eq(t.programs.id, id));
+  return row!.active;
+};
+
+const persistedActivatedAt = async (id: string) => {
+  const [row] = await db.select().from(t.programs).where(eq(t.programs.id, id));
+  return row!.activatedAt;
+};
+
+describe("programs — auto-activate + single-active", () => {
+  it("auto-activates the FIRST program for an owner", async () => {
+    const first = await createProgram({ ownerId: OWNER_A, name: "P1" });
+    expect(first.active).toBe(true);
+    expect(await persistedActive(first.id)).toBe(true);
+  });
+
+  it("does NOT auto-activate a second program for the same owner", async () => {
+    await createProgram({ ownerId: OWNER_A, name: "P1" });
+    const second = await createProgram({ ownerId: OWNER_A, name: "P2" });
+    // Returned object's active matches what's persisted.
+    expect(second.active).toBeFalsy();
+    expect(await persistedActive(second.id)).toBeFalsy();
+  });
+
+  it("auto-activate is owner-scoped", async () => {
+    // Owner A already has programs; owner B's first still activates.
+    await createProgram({ ownerId: OWNER_A, name: "A1" });
+    await createProgram({ ownerId: OWNER_A, name: "A2" });
+    const bFirst = await createProgram({ ownerId: OWNER_B, name: "B1" });
+    expect(bFirst.active).toBe(true);
+    expect(await persistedActive(bFirst.id)).toBe(true);
+  });
+
+  it("setProgramActive enforces single-active within an owner", async () => {
+    const p1 = await createProgram({ ownerId: OWNER_A, name: "P1" }); // auto-active
+    const p2 = await createProgram({ ownerId: OWNER_A, name: "P2" });
+    const p3 = await createProgram({ ownerId: OWNER_A, name: "P3" });
+
+    await setProgramActive({ programId: p2.id, ownerId: OWNER_A });
+
+    expect(await persistedActive(p1.id)).toBeFalsy();
+    expect(await persistedActive(p2.id)).toBe(true);
+    expect(await persistedActive(p3.id)).toBeFalsy();
+  });
+
+  it("setProgramActive does not touch another owner's active program", async () => {
+    const a1 = await createProgram({ ownerId: OWNER_A, name: "A1" }); // A's active
+    const b1 = await createProgram({ ownerId: OWNER_B, name: "B1" }); // B's active
+    const b2 = await createProgram({ ownerId: OWNER_B, name: "B2" });
+
+    await setProgramActive({ programId: b2.id, ownerId: OWNER_B });
+
+    // A's program untouched; B's flipped to b2.
+    expect(await persistedActive(a1.id)).toBe(true);
+    expect(await persistedActive(b1.id)).toBeFalsy();
+    expect(await persistedActive(b2.id)).toBe(true);
+  });
+
+  it("re-activating the already-active program leaves it active", async () => {
+    const p1 = await createProgram({ ownerId: OWNER_A, name: "P1" });
+    await setProgramActive({ programId: p1.id, ownerId: OWNER_A });
+    expect(await persistedActive(p1.id)).toBe(true);
+  });
+});
+
+describe("programs — activatedAt anchors the week-block bar", () => {
+  it("stamps activatedAt when the first program auto-activates", async () => {
+    const before = Date.now();
+    const first = await createProgram({ ownerId: OWNER_A, name: "P1" });
+    const stamped = await persistedActivatedAt(first.id);
+    expect(stamped).not.toBeNull();
+    expect(stamped!).toBeGreaterThanOrEqual(before);
+    expect(stamped!).toBeLessThanOrEqual(Date.now());
+    // Returned object mirrors the persisted stamp.
+    expect(first.activatedAt).toBe(stamped);
+  });
+
+  it("leaves activatedAt null for a non-auto-activated program", async () => {
+    await createProgram({ ownerId: OWNER_A, name: "P1" });
+    const second = await createProgram({ ownerId: OWNER_A, name: "P2" });
+    expect(await persistedActivatedAt(second.id)).toBeNull();
+  });
+
+  it("stamps activatedAt on the program turned active", async () => {
+    await createProgram({ ownerId: OWNER_A, name: "P1" }); // auto-active
+    const p2 = await createProgram({ ownerId: OWNER_A, name: "P2" });
+    expect(await persistedActivatedAt(p2.id)).toBeNull();
+
+    const at = 1_700_000_000_000;
+    await setProgramActive({ programId: p2.id, ownerId: OWNER_A, now: at });
+
+    expect(await persistedActive(p2.id)).toBe(true);
+    expect(await persistedActivatedAt(p2.id)).toBe(at);
+  });
+
+  it("does NOT re-stamp activatedAt when re-activating an already-active program", async () => {
+    const p1 = await createProgram({ ownerId: OWNER_A, name: "P1" }); // auto-active
+    const original = await persistedActivatedAt(p1.id);
+    expect(original).not.toBeNull();
+
+    // Re-activating the live program is a no-op — the week-1 anchor must hold.
+    await setProgramActive({
+      programId: p1.id,
+      ownerId: OWNER_A,
+      now: original! + 999_999,
+    });
+
+    expect(await persistedActivatedAt(p1.id)).toBe(original);
+  });
+});
diff --git a/packages/db/test/setup.ts b/packages/db/test/setup.ts
new file mode 100644
index 0000000..1c5ed33
--- /dev/null
+++ b/packages/db/test/setup.ts
@@ -0,0 +1,74 @@
+import { sql } from "drizzle-orm";
+import { beforeEach } from "vitest";
+import { db } from "../src/db";
+import { exercises } from "../src/schema";
+
+/**
+ * Truncate every table before each test (RESTART IDENTITY CASCADE), then re-seed
+ * a tiny fixed exercise library — every routine/session/PR row FK-references
+ * `exercises`, so the fixtures must exist for factories to build trees.
+ *
+ * Truncate-per-test (not transaction rollback) is deliberate: the repo functions
+ * use a module-level `db`, so they can't run inside a per-test tx without a
+ * production refactor — and truncate genuinely exercises ON DELETE CASCADE /
+ * SET NULL, which is the whole point of the cascade tests.
+ */
+const TABLES = [
+  "set_logs",
+  "session_exercises",
+  "sessions",
+  "routine_sets",
+  "routine_exercises",
+  "program_days",
+  "programs",
+  "personal_records",
+  "body_metrics",
+  "body_weight_logs",
+  "shared_routines",
+  "user_profiles",
+  "scheduled_pushes",
+  "push_subscriptions",
+  "routines",
+  "exercises",
+];
+
+/** Fixed exercise library available to every test (stable ids). */
+export const SEED_EX = [
+  {
+    id: "ex_bench",
+    name: "Bench Press",
+    primaryMuscle: "chest",
+    equipment: "barbell",
+    category: "barbell",
+  },
+  {
+    id: "ex_squat",
+    name: "Back Squat",
+    primaryMuscle: "quads",
+    equipment: "barbell",
+    category: "barbell",
+  },
+  {
+    id: "ex_row",
+    name: "Barbell Row",
+    primaryMuscle: "back",
+    equipment: "barbell",
+    category: "barbell",
+  },
+] as const;
+
+beforeEach(async () => {
+  await db.execute(
+    sql.raw(`TRUNCATE TABLE ${TABLES.map((t) => `"${t}"`).join(", ")} RESTART IDENTITY CASCADE`),
+  );
+  await db.insert(exercises).values(
+    SEED_EX.map((e) => ({
+      id: e.id,
+      name: e.name,
+      primaryMuscle: e.primaryMuscle,
+      secondaryMuscles: [],
+      equipment: e.equipment,
+      category: e.category,
+    })),
+  );
+});
diff --git a/packages/db/test/startSessionFromRoutine.test.ts b/packages/db/test/startSessionFromRoutine.test.ts
