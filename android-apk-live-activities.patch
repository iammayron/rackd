+"use client";
+
+import { useRouter } from "next/navigation";
+
+/**
+ * The single source of truth for a page's "Back"/"Up" affordance — a 44×44
+ * chevron button matching the program editor header. Pass `href` for an
+ * intent-based destination (navigates with `router.replace`, since back/up
+ * actions replace rather than push), or `onClick` for custom behavior such as
+ * `router.back()`. Always renders the same chevron so back arrows stay
+ * visually consistent system-wide.
+ */
+export function BackButton({
+  href,
+  onClick,
+  ariaLabel = "Go back",
+  className,
+}: {
+  href?: string;
+  onClick?: () => void;
+  ariaLabel?: string;
+  className?: string;
+}) {
+  const router = useRouter();
+  return (
+    <button
+      type="button"
+      onClick={href ? () => router.replace(href) : onClick}
+      aria-label={ariaLabel}
+      className={`flex h-11 w-11 shrink-0 items-center justify-center rounded-[var(--radius)] text-[var(--text)] transition-colors hover:bg-[var(--surface)]${
+        className ? ` ${className}` : ""
+      }`}
+    >
+      <svg
+        width="24"
+        height="24"
+        viewBox="0 0 24 24"
+        fill="none"
+        stroke="currentColor"
+        strokeWidth="2"
+        strokeLinecap="round"
+        strokeLinejoin="round"
+        aria-hidden="true"
+      >
+        <path d="M15 18l-6-6 6-6" />
+      </svg>
+    </button>
+  );
+}
diff --git a/apps/web/src/components/BottomSheet.tsx b/apps/web/src/components/BottomSheet.tsx
new file mode 100644
index 0000000..c00b63f
--- /dev/null
+++ b/apps/web/src/components/BottomSheet.tsx
@@ -0,0 +1,210 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import type { PointerEvent, ReactNode } from "react";
+import { useBodyScrollLock } from "@/lib/scroll-lock";
+
+/**
+ * Generic bottom sheet: slides up from the bottom over a dim backdrop. Owns the
+ * animation, dismissal (backdrop tap / Escape / drag-down), focus management,
+ * aria, safe-area padding and z-index. Reduced-motion is handled globally in
+ * globals.css (durations collapse to ~0).
+ *
+ * Keep this API generic — feature-specific UI goes in `children`. Existing
+ * sheets/pickers (e.g. SaveBackSheet) are candidates to adopt this later.
+ *
+ * @example
+ * <BottomSheet open={open} onClose={() => setOpen(false)} title="Effort · RPE">
+ *   …content…
+ * </BottomSheet>
+ */
+export function BottomSheet({
+  open,
+  onClose,
+  title,
+  /** Optional secondary text shown next to the title. */
+  subtitle,
+  /**
+   * Optional non-scrolling header (title, search, close…) pinned below the drag
+   * handle and above the scroll area. Use this instead of a `sticky` header
+   * inside `children` — a sticky header sits *inside* the scrollport, so the
+   * first row can peek through the padding strip above it. This block is a
+   * sibling of the scroll area, so content is always clipped beneath it.
+   */
+  header,
+  children,
+}: {
+  open: boolean;
+  onClose: () => void;
+  title?: string;
+  subtitle?: string;
+  header?: ReactNode;
+  children: ReactNode;
+}) {
+  const panelRef = useRef<HTMLDivElement>(null);
+  const scrollRef = useRef<HTMLDivElement>(null);
+  const [dragY, setDragY] = useState(0);
+  const dragStart = useRef<number | null>(null);
+  // "pending" = a content gesture we haven't decided is a dismiss-drag vs a
+  // scroll; "dragging" = committed to dismissing; "none" = idle.
+  const dragMode = useRef<"none" | "pending" | "dragging">("none");
+  // Height the on-screen keyboard overlaps into the layout viewport, so the
+  // sheet can sit above it instead of being hidden behind it (see effect below).
+  const [kbInset, setKbInset] = useState(0);
+
+  // Accessible dialog: focus the sheet on open, close on Escape.
+  useEffect(() => {
+    if (!open) return;
+    // Pull focus into the dialog (a11y) only as a deferred fallback: if the
+    // content already focused something (e.g. an input), leave it — stealing
+    // focus to the panel here would blur the field and dismiss the mobile
+    // keyboard. Escape still works via the window listener regardless.
+    const id = requestAnimationFrame(() => {
+      const panel = panelRef.current;
+      if (panel && !panel.contains(document.activeElement)) {
+        panel.focus({ preventScroll: true });
+      }
+    });
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === "Escape") onClose();
+    };
+    window.addEventListener("keydown", onKey);
+    return () => {
+      cancelAnimationFrame(id);
+      window.removeEventListener("keydown", onKey);
+    };
+  }, [open, onClose]);
+
+  // Lift the sheet above the on-screen keyboard. A position:fixed sheet stays
+  // pinned to the layout viewport, so the keyboard covers it; the VisualViewport
+  // API reports how much the keyboard shrank the visible area, which we apply as
+  // a bottom offset on the panel.
+  useEffect(() => {
+    if (!open) return;
+    const vv = window.visualViewport;
+    if (!vv) return;
+    const update = () => setKbInset(Math.max(0, window.innerHeight - vv.height - vv.offsetTop));
+    update();
+    vv.addEventListener("resize", update);
+    vv.addEventListener("scroll", update);
+    return () => {
+      vv.removeEventListener("resize", update);
+      vv.removeEventListener("scroll", update);
+      setKbInset(0);
+    };
+  }, [open]);
+
+  // Reset drag offset whenever the sheet (re)opens.
+  useEffect(() => {
+    if (open) setDragY(0);
+  }, [open]);
+
+  // A sheet is `aria-modal` — the page behind it must not scroll. Beyond the
+  // obvious UX, scrolling the document under a position:fixed overlay is what
+  // drifts it out of place on iOS, where the visual viewport moves independently
+  // of the layout viewport the overlay is pinned to.
+  useBodyScrollLock(open);
+
+  if (!open) return null;
+
+  // Drag-down to dismiss. From the handle it always drags; from the scrolling
+  // content it only becomes a dismiss-drag when the list is already at the top
+  // and the finger moves down — otherwise it's left as a normal scroll.
+  function onHandleDown(e: PointerEvent) {
+    dragStart.current = e.clientY;
+    dragMode.current = "dragging";
+    e.currentTarget.setPointerCapture(e.pointerId);
+  }
+  function onContentDown(e: PointerEvent) {
+    dragStart.current = e.clientY;
+    dragMode.current = "pending";
+  }
+  function onPointerMove(e: PointerEvent) {
+    if (dragStart.current == null) return;
+    const dy = e.clientY - dragStart.current;
+    if (dragMode.current === "pending") {
+      const atTop = (scrollRef.current?.scrollTop ?? 0) <= 0;
+      if (dy > 6 && atTop) {
+        dragMode.current = "dragging";
+        e.currentTarget.setPointerCapture?.(e.pointerId);
+      } else if (dy > 6) {
+        // Content isn't at the top → it's a scroll, not a dismiss. Bail out.
+        dragStart.current = null;
+        dragMode.current = "none";
+        return;
+      } else {
+        return;
+      }
+    }
+    if (dragMode.current === "dragging") setDragY(Math.max(0, dy));
+  }
+  function onPointerUp() {
+    if (dragStart.current == null) return;
+    const dismissed = dragY > 90;
+    dragStart.current = null;
+    dragMode.current = "none";
+    if (dismissed) onClose();
+    else setDragY(0);
+  }
+  const dragging = dragY > 0 || dragStart.current != null;
+
+  return (
+    // `h-[100dvh]` rather than `inset-0`: on iOS a fixed element's bottom
+    // resolves against the *large* viewport (browser chrome hidden), so
+    // `items-end` would anchor the panel below the fold — pushing its top up
+    // under the status bar and clipping the content. The dynamic viewport unit
+    // tracks what is actually visible. Every other full-height surface in the
+    // app already uses dvh; this was the one holdout.
+    <div className="fixed inset-x-0 top-0 h-[100dvh] z-[100] flex items-end justify-center">
+      <div
+        onClick={onClose}
+        aria-hidden="true"
+        className="absolute inset-0 bg-black/50 rk-backdrop-in"
+      />
+      <div
+        ref={panelRef}
+        tabIndex={-1}
+        role="dialog"
+        aria-modal="true"
+        aria-label={title}
+        className="rk-squircle-corners relative w-[min(440px,100%)] max-h-[88dvh] flex flex-col overflow-hidden bg-[var(--bg)] rounded-t-[var(--radius-lg)] shadow-[var(--shadow-lg)] outline-none rk-sheet-up"
+        style={{
+          marginBottom: kbInset || undefined,
+          transform: dragY ? `translateY(${dragY}px)` : undefined,
+          transition: dragging
+            ? "none"
+            : "transform var(--dur) var(--ease-out), margin-bottom var(--dur) var(--ease-out)",
+        }}
+      >
+        <div
+          onPointerDown={onHandleDown}
+          onPointerMove={onPointerMove}
+          onPointerUp={onPointerUp}
+          onPointerCancel={onPointerUp}
+          className="shrink-0 cursor-grab touch-none pt-2.5 pb-1"
+        >
+          <span className="mx-auto block w-[38px] h-[5px] rounded-full bg-[var(--border)]" />
+          {(title || subtitle) && (
+            <div className="flex items-baseline justify-between gap-3 px-5 pt-2">
+              {title && <h2 className="text-[17px] font-extrabold">{title}</h2>}
+              {subtitle && <span className="text-[13px] text-[var(--text-muted)]">{subtitle}</span>}
+            </div>
+          )}
+        </div>
+
+        {header && <div className="shrink-0 px-4 pb-3">{header}</div>}
+
+        <div
+          ref={scrollRef}
+          onPointerDown={onContentDown}
+          onPointerMove={onPointerMove}
+          onPointerUp={onPointerUp}
+          onPointerCancel={onPointerUp}
+          className="overflow-y-auto px-4 pt-2 pb-[calc(16px+env(safe-area-inset-bottom))]"
+        >
+          {children}
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/apps/web/src/components/Chart.tsx b/apps/web/src/components/Chart.tsx
new file mode 100644
index 0000000..0c12aed
--- /dev/null
+++ b/apps/web/src/components/Chart.tsx
@@ -0,0 +1,98 @@
+"use client";
+
+const W = 320;
+const H = 120;
+const PAD = 8;
+
+function scaleY(v: number, min: number, max: number): number {
+  if (max === min) return H / 2;
+  const t = (v - min) / (max - min);
+  return H - PAD - t * (H - PAD * 2);
+}
+
+/** Minimal SVG line chart for a numeric series (e.g. est 1RM over time). */
+export function LineChart({ data, unit = "" }: { data: number[]; unit?: string }) {
+  if (data.length === 0) {
+    return <Empty />;
+  }
+  const min = Math.min(...data);
+  const max = Math.max(...data);
+  const step = data.length > 1 ? (W - PAD * 2) / (data.length - 1) : 0;
+  const pts = data.map((v, i) => [PAD + i * step, scaleY(v, min, max)] as const);
+  const path = pts
+    .map((p, i) => `${i === 0 ? "M" : "L"}${p[0].toFixed(1)},${p[1].toFixed(1)}`)
+    .join(" ");
+
+  return (
+    <svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-label="trend chart">
+      <path d={path} fill="none" stroke="var(--accent)" strokeWidth={2} strokeLinejoin="round" />
+      {pts.map((p, i) => (
+        <circle
+          key={i}
+          cx={p[0]}
+          cy={p[1]}
+          r={i === pts.length - 1 ? 4 : 2.5}
+          fill="var(--accent)"
+        />
+      ))}
+      <text x={PAD} y={12} fill="var(--text-muted)" fontSize={11}>
+        {max}
+        {unit}
+      </text>
+      <text x={PAD} y={H - 2} fill="var(--text-muted)" fontSize={11}>
+        {min}
+        {unit}
+      </text>
+    </svg>
+  );
+}
+
+/** Minimal SVG bar chart (e.g. volume per session). */
+export function BarChart({ data, unit = "" }: { data: number[]; unit?: string }) {
+  if (data.length === 0) {
+    return <Empty />;
+  }
+  const max = Math.max(...data, 1);
+  const gap = 3;
+  const bw = (W - PAD * 2 - gap * (data.length - 1)) / data.length;
+
+  return (
+    <svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-label="bar chart">
+      {data.map((v, i) => {
+        // Floor the height so empty/zero weeks read as a thin baseline rather
+        // than vanishing — keeps a sparse series legible as a trend.
+        const h = Math.max((v / max) * (H - PAD * 2), 1.5);
+        return (
+          <rect
+            key={i}
+            x={PAD + i * (bw + gap)}
+            y={H - PAD - h}
+            width={bw}
+            height={h}
+            rx={2}
+            fill="var(--accent)"
+            opacity={i === data.length - 1 ? 1 : 0.6}
+          />
+        );
+      })}
+      <text x={PAD} y={12} fill="var(--text-muted)" fontSize={11}>
+        {max}
+        {unit}
+      </text>
+    </svg>
+  );
+}
+
+function Empty() {
+  return (
+    <div
+      style={{
+        color: "var(--text-muted)",
+        fontSize: "var(--text-sm)",
+        padding: "var(--space-4) 0",
+      }}
+    >
+      Not enough data yet.
+    </div>
+  );
+}
diff --git a/apps/web/src/components/ConfirmDialog.tsx b/apps/web/src/components/ConfirmDialog.tsx
new file mode 100644
index 0000000..183c297
--- /dev/null
+++ b/apps/web/src/components/ConfirmDialog.tsx
@@ -0,0 +1,122 @@
+"use client";
+
+import { createContext, useCallback, useContext, useRef, useState } from "react";
+import { BottomSheet } from "@/components/BottomSheet";
+
+interface ConfirmOptions {
+  title: string;
+  /** Optional supporting copy under the title. */
+  message?: string;
+  /** Confirm button label (defaults to "Delete"). */
+  confirmLabel?: string;
+  cancelLabel?: string;
+}
+
+/**
+ * Reliable in-app confirmation built on {@link BottomSheet} — a drop-in
+ * replacement for `window.confirm`, which is unreliable in iOS standalone/PWA
+ * mode (it may silently no-op, so destructive actions fire with no prompt).
+ * Renders a danger confirm + cancel; BottomSheet handles focus, Esc, backdrop.
+ */
+export function ConfirmDialog({
+  open,
+  title,
+  message,
+  confirmLabel = "Delete",
+  cancelLabel = "Cancel",
+  onConfirm,
+  onCancel,
+}: {
+  open: boolean;
+  title: string;
+  message?: string;
+  confirmLabel?: string;
+  cancelLabel?: string;
+  onConfirm: () => void;
+  onCancel: () => void;
+}) {
+  return (
+    <BottomSheet open={open} onClose={onCancel} title={title}>
+      {message && <p className="px-1 pb-3 text-sm text-[var(--text-muted)]">{message}</p>}
+      <div className="flex flex-col gap-2">
+        <button
+          type="button"
+          autoFocus
+          onClick={onConfirm}
+          className="rk-squircle-corners w-full rounded-[var(--radius-md)] bg-[var(--danger)] py-3.5 text-center font-bold text-white"
+        >
+          {confirmLabel}
+        </button>
+        <button
+          type="button"
+          onClick={onCancel}
+          className="rk-squircle-corners w-full rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--surface)] py-3.5 text-center font-bold text-[var(--text)]"
+        >
+          {cancelLabel}
+        </button>
+      </div>
+    </BottomSheet>
+  );
+}
+
+/**
+ * App-wide confirmation. Mount `<ConfirmProvider>` once near the root, then any
+ * client component can do:
+ *
+ *   const confirm = useConfirm();
+ *   if (await confirm({ title, message })) { …destructive… }
+ *
+ * A single dialog is shared by the whole tree, so per-row components (every
+ * SetRow, every ExerciseCard) can ask for confirmation without each mounting a
+ * sheet of their own. Resolves true on confirm, false on cancel/dismiss.
+ */
+type ConfirmFn = (opts: ConfirmOptions) => Promise<boolean>;
+
+const ConfirmContext = createContext<ConfirmFn | null>(null);
+
+export function ConfirmProvider({ children }: { children: React.ReactNode }) {
+  const [state, setState] = useState<ConfirmOptions & { open: boolean }>({
+    open: false,
+    title: "",
+  });
+  const resolverRef = useRef<((value: boolean) => void) | null>(null);
+
+  const confirm = useCallback<ConfirmFn>(
+    (opts) =>
+      new Promise<boolean>((resolve) => {
+        // A second request while one is open would strand the first promise —
+        // settle it as cancelled so no caller is left awaiting forever.
+        resolverRef.current?.(false);
+        resolverRef.current = resolve;
+        setState({ ...opts, open: true });
+      }),
+    [],
+  );
+
+  const settle = useCallback((value: boolean) => {
+    resolverRef.current?.(value);
+    resolverRef.current = null;
+    setState((s) => ({ ...s, open: false }));
+  }, []);
+
+  return (
+    <ConfirmContext.Provider value={confirm}>
+      {children}
+      <ConfirmDialog
+        open={state.open}
+        title={state.title}
+        message={state.message}
+        confirmLabel={state.confirmLabel}
+        cancelLabel={state.cancelLabel}
+        onConfirm={() => settle(true)}
+        onCancel={() => settle(false)}
+      />
+    </ConfirmContext.Provider>
+  );
+}
+
+export function useConfirm(): ConfirmFn {
+  const ctx = useContext(ConfirmContext);
+  if (!ctx) throw new Error("useConfirm must be used within <ConfirmProvider>");
+  return ctx;
+}
diff --git a/apps/web/src/components/ExerciseFilters.tsx b/apps/web/src/components/ExerciseFilters.tsx
new file mode 100644
index 0000000..0ed8a3c
--- /dev/null
+++ b/apps/web/src/components/ExerciseFilters.tsx
@@ -0,0 +1,83 @@
+"use client";
+
+import { useMemo } from "react";
+
+const cap = (s: string) =>
+  !s ? s : s.toLowerCase() === "fullbody" ? "Full body" : s.charAt(0).toUpperCase() + s.slice(1);
+
+function Chip({
+  active,
+  onClick,
+  children,
+}: {
+  active: boolean;
+  onClick: () => void;
+  children: React.ReactNode;
+}) {
+  return (
+    <button
+      type="button"
+      onClick={onClick}
+      className={`shrink-0 min-h-9 px-3 rounded-full border text-sm font-semibold whitespace-nowrap ${
+        active
+          ? "bg-[var(--accent-wash)] text-[var(--accent)] border-[var(--accent)]"
+          : "bg-[var(--surface)] text-[var(--text-muted)] border-[var(--border)]"
+      }`}
+    >
+      {children}
+    </button>
+  );
+}
+
+/**
+ * Muscle + equipment filter chips, derived from whatever exercises are passed
+ * in. Controlled: the parent owns the `muscle`/`equipment` selection. Shared by
+ * the Add and Replace pickers (same chips as the standalone library page).
+ */
+export function ExerciseFilters({
+  exercises,
+  muscle,
+  equipment,
+  onMuscle,
+  onEquipment,
+}: {
+  exercises: { primaryMuscle: string; equipment: string }[];
+  muscle: string | null;
+  equipment: string | null;
+  onMuscle: (m: string | null) => void;
+  onEquipment: (e: string | null) => void;
+}) {
+  const muscles = useMemo(
+    () => [...new Set(exercises.map((e) => e.primaryMuscle).filter(Boolean))].sort(),
+    [exercises],
+  );
+  const equipments = useMemo(
+    () => [...new Set(exercises.map((e) => e.equipment).filter(Boolean))].sort(),
+    [exercises],
+  );
+
+  return (
+    <>
+      <div className="mt-3 flex gap-2 overflow-x-auto pb-1">
+        <Chip active={!muscle} onClick={() => onMuscle(null)}>
+          All muscles
+        </Chip>
+        {muscles.map((m) => (
+          <Chip key={m} active={muscle === m} onClick={() => onMuscle(m)}>
+            {cap(m)}
+          </Chip>
+        ))}
+      </div>
+      <div className="mt-2 flex gap-2 overflow-x-auto pb-1">
+        <Chip active={!equipment} onClick={() => onEquipment(null)}>
+          All equipment
+        </Chip>
+        {equipments.map((eq) => (
+          <Chip key={eq} active={equipment === eq} onClick={() => onEquipment(eq)}>
+            {cap(eq)}
+          </Chip>
+        ))}
+      </div>
+    </>
+  );
+}
diff --git a/apps/web/src/components/ExerciseMedia.tsx b/apps/web/src/components/ExerciseMedia.tsx
new file mode 100644
index 0000000..bbf6fab
--- /dev/null
+++ b/apps/web/src/components/ExerciseMedia.tsx
@@ -0,0 +1,169 @@
+"use client";
+
+import { useState } from "react";
+
+export interface ExerciseMediaData {
+  name: string;
+  primaryMuscle: string;
+  secondaryMuscles?: string[] | Set<string>;
+  equipment?: string;
+  instructions?: string;
+  thumbnailUrl?: string;
+  clipUrl?: string;
+  clipUrlWebm?: string;
+}
+
+const MUSCLE_COLOR: Record<string, string> = {
+  chest: "#e2483d",
+  back: "#3a63da",
+  shoulders: "#f5b301",
+  biceps: "#9b5de5",
+  triceps: "#8b5cf6",
+  forearms: "#6b7280",
+  quads: "#36d399",
+  hamstrings: "#14b8a6",
+  glutes: "#ec4899",
+  calves: "#0ea5e9",
+  abs: "#f97316",
+  traps: "#64748b",
+  fullbody: "#4f7cff",
+};
+
+function colorFor(muscle: string): string {
+  return MUSCLE_COLOR[muscle] ?? "var(--surface-2)";
+}
+
+/** Square thumbnail: real image if present, else a muscle-colored initial (offline-safe). */
+export function ExerciseThumb({
+  ex,
+  size = 44,
+  onClick,
+}: {
+  ex: ExerciseMediaData;
+  size?: number;
+  onClick?: () => void;
+}) {
+  const initial = ex.name.charAt(0).toUpperCase();
+  const style: React.CSSProperties = {
+    width: size,
+    height: size,
+    minWidth: size,
+  };
+  const inner = ex.thumbnailUrl ? (
+    // eslint-disable-next-line @next/next/no-img-element
+    <img src={ex.thumbnailUrl} alt={ex.name} className="w-full h-full object-cover" />
+  ) : (
+    <div
+      className="w-full h-full flex items-center justify-center font-bold text-white"
+      style={{ background: colorFor(ex.primaryMuscle) }}
+    >
+      {initial}
+    </div>
+  );
+  if (!onClick)
+    return (
+      <div className="rk-squircle" style={style}>
+        {inner}
+      </div>
+    );
+  return (
+    <button
+      type="button"
+      onClick={onClick}
+      aria-label={`${ex.name} details`}
+      className="rk-squircle"
+      style={style}
+    >
+      {inner}
+    </button>
+  );
+}
+
+function muscleList(m?: string[] | Set<string>): string[] {
+  if (!m) return [];
+  return Array.isArray(m) ? m : [...m];
+}
+
+/** Detail modal: looping clip when clipUrl is set, else big fallback + instructions. */
+export function ExerciseMediaModal({
+  ex,
+  onClose,
+  action,
+}: {
+  ex: ExerciseMediaData;
+  onClose: () => void;
+  /** Optional primary action rendered as a full-width button at the bottom. */
+  action?: { label: string; onClick: () => void };
+}) {
+  return (
+    <div
+      className="fixed inset-0 z-[110] flex items-end sm:items-center justify-center bg-black/60"
+      onClick={onClose}
+    >
+      <div
+        className="w-full max-w-sm bg-[var(--surface)] border border-[var(--border)] rounded-t-[var(--radius-lg)] sm:rounded-[var(--radius-lg)] p-5"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <div className="flex items-center mb-3">
+          <h2 className="flex-1 text-lg font-bold">{ex.name}</h2>
+          <button
+            type="button"
+            onClick={onClose}
+            aria-label="Close"
+            className="text-lg text-[var(--text-muted)]"
+          >
+            ×
+          </button>
+        </div>
+
+        <div className="rounded-[var(--radius)] overflow-hidden mb-3 aspect-video bg-[var(--surface-2)] flex items-center justify-center">
+          {ex.clipUrl ? (
+            <video
+              className="w-full h-full object-cover"
+              autoPlay
+              loop
+              muted
+              playsInline
+              poster={ex.thumbnailUrl}
+            >
+              {ex.clipUrlWebm && <source src={ex.clipUrlWebm} type="video/webm" />}
+              <source src={ex.clipUrl} type="video/mp4" />
+            </video>
+          ) : (
+            <div
+              className="w-20 h-20 rounded-[var(--radius)] flex items-center justify-center text-3xl font-bold text-white"
+              style={{ background: colorFor(ex.primaryMuscle) }}
+            >
+              {ex.name.charAt(0).toUpperCase()}
+            </div>
+          )}
+        </div>
+
+        <div className="flex flex-wrap gap-1 mb-3">
+          {[ex.primaryMuscle, ...muscleList(ex.secondaryMuscles), ex.equipment]
+            .filter(Boolean)
+            .map((tag, i) => (
+              <span
+                key={i}
+                className="text-xs rounded-full px-2 py-1 bg-[var(--surface-2)] text-[var(--text-muted)]"
+              >
+                {tag}
+              </span>
+            ))}
+        </div>
+
+        {ex.instructions && <p className="text-sm text-[var(--text)]">{ex.instructions}</p>}
+
+        {action && (
+          <button
+            type="button"
+            onClick={action.onClick}
+            className="mt-4 w-full min-h-11 rounded-[var(--radius)] bg-[var(--accent)] text-white font-bold focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
+          >
+            {action.label}
+          </button>
+        )}
+      </div>
+    </div>
+  );
+}
diff --git a/apps/web/src/components/ForegroundReflow.tsx b/apps/web/src/components/ForegroundReflow.tsx
new file mode 100644
index 0000000..de6bd02
--- /dev/null
+++ b/apps/web/src/components/ForegroundReflow.tsx
@@ -0,0 +1,35 @@
+"use client";
+
+import { useEffect } from "react";
+
+/**
+ * iOS PWA workaround. After the installed app returns from the background,
+ * WebKit sometimes fails to re-lay-out `position: fixed` overlays (the rest
+ * timer, bottom sheets, the mini workout bar) — they paint as if in normal
+ * flow, stranded mid-page. Forcing a synchronous reflow on resume snaps them
+ * back to the viewport.
+ *
+ * The display:none → read offsetHeight → restore dance forces a full reflow.
+ * It's flash-free: all three steps run synchronously in one tick, so the
+ * browser never paints a frame with the body hidden.
+ */
+export function ForegroundReflow() {
+  useEffect(() => {
+    const reflow = () => {
+      if (document.visibilityState !== "visible") return;
+      const b = document.body;
+      const prev = b.style.display;
+      b.style.display = "none";
+      void b.offsetHeight; // force synchronous reflow while detached
+      b.style.display = prev;
+    };
+    document.addEventListener("visibilitychange", reflow);
+    // pageshow fires on bfcache restore (a resume path visibilitychange misses).
+    window.addEventListener("pageshow", reflow);
+    return () => {
+      document.removeEventListener("visibilitychange", reflow);
+      window.removeEventListener("pageshow", reflow);
+    };
+  }, []);
+  return null;
+}
diff --git a/apps/web/src/components/InstallWall.tsx b/apps/web/src/components/InstallWall.tsx
new file mode 100644
index 0000000..047bc35
--- /dev/null
+++ b/apps/web/src/components/InstallWall.tsx
@@ -0,0 +1,117 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { Logo } from "@/components/Logo";
+
+/**
+ * Whether the app is running as an installed PWA (launched from the home screen)
+ * rather than a browser tab. `null` while detecting (client-only).
+ *
+ * Escapes so the wall never blocks the wrong context:
+ *  - `?wall=1` or localStorage `rackd.forceWall=1` forces the wall (preview it).
+ *  - outside production we treat it as installed (a dev browser tab is never
+ *    standalone, so the wall would otherwise block local development).
+ */
+export function useIsInstalled(): boolean | null {
+  const [installed, setInstalled] = useState<boolean | null>(null);
+  useEffect(() => {
+    const params = new URLSearchParams(window.location.search);
+    const forceWall =
+      params.get("wall") === "1" || window.localStorage.getItem("rackd.forceWall") === "1";
+    if (forceWall) {
+      setInstalled(false);
+      return;
+    }
+    if (
+      process.env.NODE_ENV !== "production" ||
+      window.location.hostname.includes("run.app") ||
+      window.location.hostname === "localhost" ||
+      window.location.hostname === "127.0.0.1"
+    ) {
+      setInstalled(true);
+      return;
+    }
+    const standalone =
+      window.matchMedia?.("(display-mode: standalone)").matches ||
+      (window.navigator as Navigator & { standalone?: boolean }).standalone === true;
+    setInstalled(Boolean(standalone));
+  }, []);
+  return installed;
+}
+
+/** iOS share glyph used in the install steps. */
+function ShareGlyph() {
+  return (
+    <svg
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth={2}
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      className="inline-block h-[18px] w-[18px] align-text-bottom"
+    >
+      <path d="M12 15V3" />
+      <path d="m8 7 4-4 4 4" />
+      <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" />
+    </svg>
+  );
+}
+
+/**
+ * Install gate shown until Rackd is added to the home screen. Rackd is
+ * install-only (no in-browser login), so this stands in front of the auth gate
+ * for anyone who opened it in a plain browser tab.
+ */
+export function InstallWall() {
+  const isIOS = typeof navigator !== "undefined" && /iphone|ipad|ipod/i.test(navigator.userAgent);
+
+  return (
+    <div className="flex min-h-[100dvh] flex-col items-center justify-center gap-6 px-8 text-center">
+      <Logo size={84} />
+
+      <div>
+        <h1 className="text-2xl font-extrabold">
+          Add Rackd to your
+          <br />
+          Home Screen
+        </h1>
+        <p className="mx-auto mt-2 max-w-sm text-[var(--text-muted)]">
+          Rackd runs as an app. Install it to continue. It launches full-screen, works offline, and
+          delivers your rest-timer alerts.
+        </p>
+      </div>
+
+      {isIOS ? (
+        <ol className="m-0 flex max-w-sm list-none flex-col gap-3 p-0 text-left">
+          {[
+            <>
+              Tap the Share button <ShareGlyph /> in the Safari toolbar.
+            </>,
+            <>
+              Scroll down and choose <strong>“Add to Home Screen”</strong>.
+            </>,
+            <>
+              Open <strong>Rackd</strong> from your Home Screen.
+            </>,
+          ].map((step, i) => (
+            <li key={i} className="flex items-start gap-3">
+              <span
+                className="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-extrabold"
+                style={{ background: "var(--accent-wash)", color: "var(--accent)" }}
+              >
+                {i + 1}
+              </span>
+              <span className="pt-0.5 text-[15px] leading-snug">{step}</span>
+            </li>
+          ))}
+        </ol>
+      ) : (
+        <p className="max-w-sm text-[var(--text-muted)]">
+          Rackd is an iPhone app. Open <strong>rackd.fly.dev</strong> in Safari on your iPhone and
+          add it to your Home Screen to continue.
+        </p>
+      )}
+    </div>
+  );
+}
diff --git a/apps/web/src/components/LoginScreen.tsx b/apps/web/src/components/LoginScreen.tsx
