+      },
+      {
+        name: "Full Body B",
+        exercises: [
+          e("ex_deadlift", 3, 5),
+          e("ex_ohp", 3, 5),
+          e("ex_lat_pulldown", 3, 10),
+          e("ex_hanging_leg_raise", 3, 12),
+        ],
+      },
+      {
+        name: "Full Body C",
+        exercises: [
+          e("ex_front_squat", 3, 6),
+          e("ex_incline_db_press", 3, 8),
+          e("ex_seated_row", 3, 10),
+          e("ex_calf_raise", 3, 15),
+        ],
+      },
+    ],
+  },
+];
+
+/** Clone a template into the user's own program + routines. Returns program id. */
+export async function cloneProgramTemplate(
+  template: ProgramTemplate,
+  ownerId: string,
+): Promise<string> {
+  const program = await createProgram({ ownerId, name: template.name });
+
+  for (let i = 0; i < template.days.length; i++) {
+    const day = template.days[i]!;
+    const routine = await createRoutine({ ownerId, name: day.name, order: i });
+    for (let j = 0; j < day.exercises.length; j++) {
+      const ex = day.exercises[j]!;
+      const re = await addRoutineExercise({
+        routineId: routine.id,
+        exerciseId: ex.exerciseId,
+        order: j + 1,
+        restSec: ex.rest,
+      });
+      for (let s = 0; s < ex.sets; s++) {
+        await addRoutineSet({
+          routineExerciseId: re.id,
+          order: s + 1,
+          targetReps: ex.reps,
+        });
+      }
+    }
+    await addProgramDay({
+      programId: program.id,
+      order: i + 1,
+      name: day.name,
+      routineId: routine.id,
+    });
+  }
+  return program.id;
+}
