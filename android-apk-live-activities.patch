@@ -0,0 +1,118 @@
+"use client";
+
+import { useState } from "react";
+import { useAuth } from "@/lib/auth";
+import { isAuthConfigured } from "@/lib/supabase";
+import { Logo } from "@/components/Logo";
+
+export function LoginScreen() {
+  const { signIn, signUp } = useAuth();
+  const [mode, setMode] = useState<"in" | "up">("in");
+  const [email, setEmail] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [info, setInfo] = useState<string | null>(null);
+
+  const configured = isAuthConfigured();
+
+  async function submit(e: React.FormEvent) {
+    e.preventDefault();
+    if (busy) return;
+    setBusy(true);
+    setError(null);
+    setInfo(null);
+    const fn = mode === "in" ? signIn : signUp;
+    const { error } = await fn(email.trim(), password);
+    setBusy(false);
+    if (error) {
+      setError(error);
+    } else if (mode === "up") {
+      setInfo("Account created. If email confirmation is on, check your inbox; otherwise sign in.");
+      setMode("in");
+    }
+  }
+
+  async function continueAsDemo() {
+    setBusy(true);
+    await signIn("demo@rackd.test", "demo-password");
+    setBusy(false);
+  }
+
+  const input =
+    "w-full min-h-11 px-3 bg-[var(--surface-2)] text-[var(--text)] border border-[var(--border)] rounded-[var(--radius-sm)] focus:outline-none focus:ring-2 focus:ring-[var(--accent)]";
+
+  return (
+    <main className="min-h-[100dvh] flex flex-col justify-center p-6">
+      <div className="mb-6 flex flex-col items-center text-center">
+        <Logo size={72} />
+        <h1 className="mt-4 text-3xl font-bold">Rackd</h1>
+        <p className="mt-1 text-[var(--text-muted)]">
+          {mode === "in" ? "Sign in to your workouts." : "Create your account."}
+        </p>
+      </div>
+
+      {!configured && (
+        <div className="mb-4 p-3 rounded-[var(--radius-sm)] bg-[var(--surface-2)] border border-[var(--border)] text-sm text-[var(--text-muted)] text-center">
+          Running in preview mode with demo data.
+        </div>
+      )}
+
+      <form onSubmit={submit} className="flex flex-col gap-3">
+        <input
+          className={input}
+          type="email"
+          inputMode="email"
+          autoComplete="email"
+          placeholder="Email"
+          value={email}
+          onChange={(e) => setEmail(e.target.value)}
+          required
+        />
+        <input
+          className={input}
+          type="password"
+          autoComplete={mode === "in" ? "current-password" : "new-password"}
+          placeholder="Password"
+          value={password}
+          onChange={(e) => setPassword(e.target.value)}
+          required
+        />
+
+        {error && <p className="text-sm text-[var(--danger)]">{error}</p>}
+        {info && <p className="text-sm text-[var(--success)]">{info}</p>}
+
+        <button
+          type="submit"
+          disabled={busy}
+          className="min-h-12 rounded-[var(--radius-sm)] bg-[var(--accent)] text-white font-bold disabled:opacity-60 cursor-pointer"
+        >
+          {busy ? "…" : mode === "in" ? "Sign in" : "Sign up"}
+        </button>
+
+        {!configured && (
+          <button
+            type="button"
+            onClick={continueAsDemo}
+            disabled={busy}
+            className="min-h-11 rounded-[var(--radius-sm)] bg-[var(--surface-2)] border border-[var(--border)] text-[var(--text)] font-semibold cursor-pointer"
+          >
+            Continue as Demo Lifter
+          </button>
+        )}
+      </form>
+
+      <button
+        type="button"
+        onClick={() => {
+          setMode((m) => (m === "in" ? "up" : "in"));
+          setError(null);
+          setInfo(null);
+        }}
+        className="mt-4 text-sm text-[var(--accent)] font-semibold cursor-pointer"
+      >
+        {mode === "in" ? "Need an account? Sign up" : "Have an account? Sign in"}
+      </button>
+    </main>
+  );
+}
