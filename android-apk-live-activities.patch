+export async function addProgramDay(args: {
+  programId: string;
+  order: number;
+  name?: string;
+  routineId?: string;
+  weekday?: number;
+}) {
+  return insertRow(t.programDays, {
+    ownerId: await ownerOf(t.programs, args.programId),
