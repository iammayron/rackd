@@ -0,0 +1,166 @@
+import { describe, it, expect } from "vitest";
+import { eq, asc } from "drizzle-orm";
+import { db } from "../src/db";
+import * as t from "../src/schema";
+import {
+  createRoutine,
+  addRoutineExercise,
+  addRoutineSet,
+  setRoutineExerciseSuperset,
+  updateRoutineExercise,
+  startSessionFromRoutine,
+} from "../src/index";
+import { makeRoutine, OWNER_A } from "./factories";
+
+const sessionExercises = (sessionId: string) =>
+  db
+    .select()
+    .from(t.sessionExercises)
+    .where(eq(t.sessionExercises.sessionId, sessionId))
+    .orderBy(asc(t.sessionExercises.order));
+
+const setLogs = (sessionExerciseId: string) =>
+  db
+    .select()
+    .from(t.setLogs)
+    .where(eq(t.setLogs.sessionExerciseId, sessionExerciseId))
+    .orderBy(asc(t.setLogs.order));
+
+describe("startSessionFromRoutine (deep-copy plan → live session)", () => {
+  it("preserves exercise order from the routine", async () => {
+    const { routineId } = await makeRoutine({
+      exerciseIds: ["ex_squat", "ex_bench", "ex_row"],
+      setsPer: 1,
+    });
+
+    const session = await startSessionFromRoutine({ routineId, ownerId: OWNER_A, now: 1000 });
+
+    const ses = await sessionExercises(session.id);
+    expect(ses.map((s) => s.exerciseId)).toEqual(["ex_squat", "ex_bench", "ex_row"]);
+    expect(ses.map((s) => s.order)).toEqual([1, 2, 3]);
+  });
+
+  it("carries supersetGroup and restSec onto session exercises", async () => {
+    const routine = await createRoutine({ ownerId: OWNER_A, name: "R" });
+    const re = await addRoutineExercise({
+      routineId: routine.id,
+      exerciseId: "ex_bench",
+      order: 1,
+    });
+    await setRoutineExerciseSuperset(re.id, 7);
+    await updateRoutineExercise(re.id, { restSec: 90 });
+
+    const session = await startSessionFromRoutine({
+      routineId: routine.id,
+      ownerId: OWNER_A,
+      now: 1000,
+    });
+
+    const [se] = await sessionExercises(session.id);
+    expect(se!.supersetGroup).toBe(7);
+    expect(se!.restSec).toBe(90);
+  });
+
+  it("carries barType onto session exercises and defaults to standard", async () => {
+    const routine = await createRoutine({ ownerId: OWNER_A, name: "R" });
+    const def = await addRoutineExercise({
+      routineId: routine.id,
+      exerciseId: "ex_squat",
+      order: 1,
+    });
+    const ez = await addRoutineExercise({
+      routineId: routine.id,
+      exerciseId: "ex_bench",
+      order: 2,
+    });
+    await updateRoutineExercise(ez.id, { barType: "ezbar" });
+
+    // updateRoutineExercise persisted the override on the plan…
+    const [planEz] = await db
+      .select()
+      .from(t.routineExercises)
+      .where(eq(t.routineExercises.id, ez.id));
+    expect(planEz!.barType).toBe("ezbar");
+    expect(def.barType).toBe("standard"); // column default on insert
+
+    // …and it copies through to the live session.
+    const session = await startSessionFromRoutine({
+      routineId: routine.id,
+      ownerId: OWNER_A,
+      now: 1000,
+    });
+    const ses = await sessionExercises(session.id);
+    expect(ses.find((s) => s.exerciseId === "ex_squat")!.barType).toBe("standard");
+    expect(ses.find((s) => s.exerciseId === "ex_bench")!.barType).toBe("ezbar");
+  });
+
+  it("copies routineSets to setLogs with targets, completed=false", async () => {
+    const routine = await createRoutine({ ownerId: OWNER_A, name: "R" });
+    const re = await addRoutineExercise({
+      routineId: routine.id,
+      exerciseId: "ex_bench",
+      order: 1,
+    });
+    await addRoutineSet({ routineExerciseId: re.id, order: 1, targetReps: 5, targetWeight: 100 });
+    await addRoutineSet({ routineExerciseId: re.id, order: 2, targetReps: 8, targetWeight: 80 });
+
+    const session = await startSessionFromRoutine({
+      routineId: routine.id,
+      ownerId: OWNER_A,
+      now: 1000,
+    });
+
+    const [se] = await sessionExercises(session.id);
+    const logs = await setLogs(se!.id);
+    expect(logs).toHaveLength(2);
+    expect(logs.map((l) => [l.weight, l.reps, l.completed])).toEqual([
+      [100, 5, false],
+      [80, 8, false],
+    ]);
+  });
+
+  it("defaults weight/reps to 0 when targets are null", async () => {
+    const routine = await createRoutine({ ownerId: OWNER_A, name: "R" });
+    const re = await addRoutineExercise({
+      routineId: routine.id,
+      exerciseId: "ex_bench",
+      order: 1,
+    });
+    // No targetReps / targetWeight => both null on the routine set.
+    await addRoutineSet({ routineExerciseId: re.id, order: 1 });
+
+    const session = await startSessionFromRoutine({
+      routineId: routine.id,
+      ownerId: OWNER_A,
+      now: 1000,
+    });
+
+    const [se] = await sessionExercises(session.id);
+    const logs = await setLogs(se!.id);
+    expect(logs).toHaveLength(1);
+    expect(logs[0]!.weight).toBe(0);
+    expect(logs[0]!.reps).toBe(0);
+  });
+
+  it("empty routine yields a session with no exercises", async () => {
+    const routine = await createRoutine({ ownerId: OWNER_A, name: "Empty" });
+
+    const session = await startSessionFromRoutine({
+      routineId: routine.id,
+      ownerId: OWNER_A,
+      now: 1000,
+    });
+
+    expect(session.name).toBe("Empty");
+    expect(session.routineId).toBe(routine.id);
+    expect(await sessionExercises(session.id)).toHaveLength(0);
+  });
+
+  it("a non-existent routineId is rejected by the FK (no dangling session)", async () => {
+    // sessions.routineId FK-references routines, so starting from a missing
+    // routine throws rather than creating an orphaned session.
+    await expect(
+      startSessionFromRoutine({ routineId: "does-not-exist", ownerId: OWNER_A, now: 1000 }),
+    ).rejects.toThrow();
+  });
+});
diff --git a/packages/db/test/syncRestToRoutine.test.ts b/packages/db/test/syncRestToRoutine.test.ts
new file mode 100644
index 0000000..81de1c5
--- /dev/null
+++ b/packages/db/test/syncRestToRoutine.test.ts
@@ -0,0 +1,141 @@
+import { describe, it, expect } from "vitest";
+import { eq, asc } from "drizzle-orm";
+import { db } from "../src/db";
+import * as t from "../src/schema";
+import {
+  createRoutine,
+  addRoutineExercise,
+  updateRoutineExercise,
+  startSessionFromRoutine,
+  startSession,
+  addSessionExercise,
+  updateSessionExercise,
+  finishSession,
+} from "../src/index";
+import { OWNER_A } from "./factories";
+
+/**
+ * `syncRestToRoutine` is internal; we drive it through `finishSession`, which
+ * calls it. It carries per-exercise restSec edits made during a live workout
+ * back onto the source routine for the next run.
+ */
+
+const routineExercises = (routineId: string) =>
+  db
+    .select()
+    .from(t.routineExercises)
+    .where(eq(t.routineExercises.routineId, routineId))
+    .orderBy(asc(t.routineExercises.order));
+
+const sessionExercises = (sessionId: string) =>
+  db
+    .select()
+    .from(t.sessionExercises)
+    .where(eq(t.sessionExercises.sessionId, sessionId))
+    .orderBy(asc(t.sessionExercises.order));
+
+describe("syncRestToRoutine (via finishSession)", () => {
+  it("writes a single matched exercise's restSec back to the routine", async () => {
+    const routine = await createRoutine({ ownerId: OWNER_A, name: "R" });
+    const re = await addRoutineExercise({
+      routineId: routine.id,
+      exerciseId: "ex_bench",
+      order: 1,
+    });
+    await updateRoutineExercise(re.id, { restSec: 120 });
+
+    const session = await startSessionFromRoutine({
+      routineId: routine.id,
+      ownerId: OWNER_A,
+      now: 1000,
+    });
+    const [se] = await sessionExercises(session.id);
+    await updateSessionExercise(se!.id, { restSec: 45 });
+
+    await finishSession(session.id, 2000);
+
+    const [updated] = await routineExercises(routine.id);
+    expect(updated!.restSec).toBe(45);
+  });
+
+  it("pairs duplicate routine slots by order so the edited slot updates", async () => {
+    const routine = await createRoutine({ ownerId: OWNER_A, name: "R" });
+    // Two bench slots with distinct rest values.
+    const first = await addRoutineExercise({
+      routineId: routine.id,
+      exerciseId: "ex_bench",
+      order: 1,
+    });
+    const second = await addRoutineExercise({
+      routineId: routine.id,
+      exerciseId: "ex_bench",
+      order: 2,
+    });
+    await updateRoutineExercise(first.id, { restSec: 60 });
+    await updateRoutineExercise(second.id, { restSec: 90 });
+
+    const session = await startSessionFromRoutine({
+      routineId: routine.id,
+      ownerId: OWNER_A,
+      now: 1000,
+    });
+    const ses = await sessionExercises(session.id);
+    // Edit only the second (order 2) session exercise.
+    await updateSessionExercise(ses[1]!.id, { restSec: 200 });
+
+    await finishSession(session.id, 2000);
+
+    const res = await routineExercises(routine.id);
+    // First slot (order 1) unchanged; second slot (order 2) gets the edit.
+    expect(res[0]!.restSec).toBe(60);
+    expect(res[1]!.restSec).toBe(200);
+  });
+
+  it("does not write when rest is unchanged", async () => {
+    const routine = await createRoutine({ ownerId: OWNER_A, name: "R" });
+    const re = await addRoutineExercise({
+      routineId: routine.id,
+      exerciseId: "ex_bench",
+      order: 1,
+    });
+    await updateRoutineExercise(re.id, { restSec: 120 });
+
+    const session = await startSessionFromRoutine({
+      routineId: routine.id,
+      ownerId: OWNER_A,
+      now: 1000,
+    });
+    // No edit to the session exercise; rest stays 120 on both sides.
+
+    await finishSession(session.id, 2000);
+
+    const [unchanged] = await routineExercises(routine.id);
+    expect(unchanged!.restSec).toBe(120);
+  });
+
+  it("is a no-op for an ad-hoc session with no routineId", async () => {
+    const routine = await createRoutine({ ownerId: OWNER_A, name: "R" });
+    const re = await addRoutineExercise({
+      routineId: routine.id,
+      exerciseId: "ex_bench",
+      order: 1,
+    });
+    await updateRoutineExercise(re.id, { restSec: 120 });
+
+    // Ad-hoc session: not started from the routine, no routineId link.
+    const session = await startSession({ ownerId: OWNER_A, name: "Ad-hoc", now: 1000 });
+    const se = await addSessionExercise({
+      sessionId: session.id,
+      exerciseId: "ex_bench",
+      order: 1,
+      restSec: 30,
+    });
+    await updateSessionExercise(se.id, { restSec: 30 });
+
+    await finishSession(session.id, 2000);
+
+    // The unrelated routine is untouched.
+    const [untouched] = await routineExercises(routine.id);
+    expect(untouched!.restSec).toBe(120);
+  });
+});
