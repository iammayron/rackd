+import { describe, expect, it } from "vitest";
+import { bestPrsByExercise, startOfWeek } from "@/features/prs/bestPrs";
+
+const exercises = [
+  { id: "bench", name: "Bench Press", primaryMuscle: "chest" },
+  { id: "squat", name: "Squat", primaryMuscle: "quads" },
+];
+
+const NOW = startOfWeek(Date.UTC(2026, 5, 25)) + 3 * 86_400_000; // mid-week anchor
+const thisWeek = NOW; // already inside the current week window
+const lastWeek = startOfWeek(NOW) - 86_400_000; // before week start
+
+describe("bestPrsByExercise", () => {
+  it("prefers an est-1RM record over a top-weight record for the same exercise", () => {
+    const rows = bestPrsByExercise(
+      [
+        { exerciseId: "bench", type: "weight", value: 120, achievedAt: thisWeek },
+        { exerciseId: "bench", type: "1rm", value: 100, achievedAt: thisWeek },
+      ],
+      exercises,
+      NOW,
+    );
+    expect(rows).toHaveLength(1);
+    expect(rows[0]).toMatchObject({ exerciseId: "bench", type: "1rm", value: 100 });
+  });
+
+  it("prefers the higher value within the same record type", () => {
+    const rows = bestPrsByExercise(
+      [
+        { exerciseId: "squat", type: "1rm", value: 150, achievedAt: thisWeek },
+        { exerciseId: "squat", type: "1rm", value: 180, achievedAt: lastWeek },
+      ],
+      exercises,
+      NOW,
+    );
+    expect(rows[0]).toMatchObject({ value: 180 });
+  });
+
+  it("returns one row per exercise, newest achievement first", () => {
+    const rows = bestPrsByExercise(
+      [
+        { exerciseId: "bench", type: "1rm", value: 100, achievedAt: lastWeek },
+        { exerciseId: "squat", type: "1rm", value: 150, achievedAt: thisWeek },
+      ],
+      exercises,
+      NOW,
+    );
+    expect(rows.map((r) => r.exerciseId)).toEqual(["squat", "bench"]);
+  });
+
+  it("flags records set this week as fresh, older ones as stale", () => {
+    const rows = bestPrsByExercise(
+      [
+        { exerciseId: "bench", type: "1rm", value: 100, achievedAt: thisWeek },
+        { exerciseId: "squat", type: "1rm", value: 150, achievedAt: lastWeek },
+      ],
+      exercises,
+      NOW,
+    );
+    const byId = Object.fromEntries(rows.map((r) => [r.exerciseId, r.fresh]));
+    expect(byId.bench).toBe(true);
+    expect(byId.squat).toBe(false);
+  });
+
+  it("skips records whose exercise is not in the library list", () => {
+    const rows = bestPrsByExercise(
+      [{ exerciseId: "ghost", type: "1rm", value: 100, achievedAt: thisWeek }],
+      exercises,
+      NOW,
+    );
+    expect(rows).toEqual([]);
+  });
+});
diff --git a/apps/web/test/features/copy-targets.test.ts b/apps/web/test/features/copy-targets.test.ts
new file mode 100644
index 0000000..cbafac1
--- /dev/null
+++ b/apps/web/test/features/copy-targets.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, it } from "vitest";
+import { copyTargets } from "@/features/active-workout/copy-targets";
+
+// The real display edge: canonical kg → lb, rounded to one decimal.
+const KG_PER_LB = 0.45359237;
+const displayLb = (kg: number) => Number((kg / KG_PER_LB).toFixed(1));
+const displayKg = (kg: number) => Number(kg.toFixed(1));
+
+const set = (order: number, weight: number, reps: number, completed = false) => ({
+  order,
+  weight,
+  reps,
+  completed,
+});
+
+describe("copyTargets", () => {
+  it("offers the later sets that differ", () => {
+    const done = set(1, 100, 12);
+    const sets = [done, set(2, 80, 12), set(3, 80, 10)];
+    expect(copyTargets(sets, done, displayKg).map((s) => s.order)).toEqual([2, 3]);
+  });
+
+  it("offers nothing when the later sets already match exactly", () => {
+    const done = set(1, 100, 12);
+    const sets = [done, set(2, 100, 12), set(3, 100, 12)];
+    expect(copyTargets(sets, done, displayKg)).toEqual([]);
+  });
+
+  it("offers nothing when the sets read the same on screen but differ in stored kg", () => {
+    // The reported bug. 42.5 kg shows as 93.7 lb; ticking a set used to push the
+    // rounded 93.7 back through the conversion and store 42.5019… Raw-kg
+    // comparison then saw a difference and prompted to copy 93.7 onto 93.7.
+    const drifted = 42.5 / KG_PER_LB;
+    const restored = Number(drifted.toFixed(1)) * KG_PER_LB;
+    expect(restored).not.toBe(42.5); // the round-trip really is lossy
+    expect(displayLb(restored)).toBe(displayLb(42.5)); // …but identical on screen
+
+    const done = set(1, restored, 12);
+    const sets = [done, set(2, 42.5, 12), set(3, 42.5, 12)];
+    expect(copyTargets(sets, done, displayLb)).toEqual([]);
+  });
+
+  it("still offers a set whose weight differs visibly", () => {
+    const done = set(1, 42.5, 12);
+    const sets = [done, set(2, 45, 12)];
+    expect(copyTargets(sets, done, displayLb).map((s) => s.order)).toEqual([2]);
+  });
+
+  it("offers a set whose reps differ even when the weight matches", () => {
+    const done = set(1, 100, 12);
+    const sets = [done, set(2, 100, 8)];
+    expect(copyTargets(sets, done, displayKg).map((s) => s.order)).toEqual([2]);
+  });
+
+  it("skips sets that are already completed", () => {
+    const done = set(1, 100, 12);
+    const sets = [done, set(2, 80, 12, true), set(3, 80, 12)];
+    expect(copyTargets(sets, done, displayKg).map((s) => s.order)).toEqual([3]);
+  });
+
+  it("never offers earlier sets, nor the completed set itself", () => {
+    const done = set(2, 100, 12);
+    const sets = [set(1, 60, 12), done, set(3, 60, 12)];
+    expect(copyTargets(sets, done, displayKg).map((s) => s.order)).toEqual([3]);
+  });
+
+  it("offers nothing when the completed set is the last one", () => {
+    const done = set(3, 100, 12);
+    expect(copyTargets([set(1, 60, 12), set(2, 60, 12), done], done, displayKg)).toEqual([]);
+  });
+
+  it("treats a rounding difference below display precision as a match in kg too", () => {
+    const done = set(1, 42.5, 12);
+    const sets = [done, set(2, 42.53, 12)]; // both render "42.5 kg"
+    expect(copyTargets(sets, done, displayKg)).toEqual([]);
+  });
+});
diff --git a/apps/web/test/features/program-progress-day-index.test.ts b/apps/web/test/features/program-progress-day-index.test.ts
new file mode 100644
index 0000000..d03cfe5
--- /dev/null
+++ b/apps/web/test/features/program-progress-day-index.test.ts
@@ -0,0 +1,63 @@
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { dayIndex } from "@/lib/day";
+
+/**
+ * `dayIndex` anchors the week-block progress bar: it must map an epoch ms to a
+ * *local* calendar-day number such that consecutive calendar days differ by
+ * exactly 1 and any clock time on the same day collapses to one index. The
+ * fragile part is DST — a spring-forward day is 23h and a fall-back day 25h of
+ * wall-clock time, so naive `Math.floor(ms / DAY_MS)` (UTC days) would drift.
+ * We pin the whole file to a DST-observing zone so the boundaries are exercised
+ * deterministically regardless of the host machine's timezone.
+ */
+const ORIGINAL_TZ = process.env.TZ;
+beforeAll(() => {
+  process.env.TZ = "America/New_York";
+});
+afterAll(() => {
+  if (ORIGINAL_TZ === undefined) delete process.env.TZ;
+  else process.env.TZ = ORIGINAL_TZ;
+});
+
+// Local-time midnight epoch for a calendar day (month is 0-based).
+const localDay = (y: number, m: number, d: number, h = 0, min = 0) =>
+  new Date(y, m, d, h, min).getTime();
+
+describe("dayIndex", () => {
+  it("collapses every clock time of a local day to one index", () => {
+    const day = dayIndex(localDay(2025, 5, 24, 0, 1));
+    expect(dayIndex(localDay(2025, 5, 24, 12, 0))).toBe(day);
+    expect(dayIndex(localDay(2025, 5, 24, 23, 59))).toBe(day);
+  });
+
+  it("steps consecutive calendar days by exactly 1", () => {
+    const a = dayIndex(localDay(2025, 5, 24));
+    const b = dayIndex(localDay(2025, 5, 25));
+    expect(b - a).toBe(1);
+  });
+
+  it("keeps a +1 step across the spring-forward boundary (23h day)", () => {
+    // US spring-forward: 2025-03-09 02:00 → 03:00 (that local day is only 23h).
+    const mar8 = dayIndex(localDay(2025, 2, 8, 12));
+    const mar9 = dayIndex(localDay(2025, 2, 9, 12));
+    const mar10 = dayIndex(localDay(2025, 2, 10, 12));
+    expect(mar9 - mar8).toBe(1);
+    expect(mar10 - mar9).toBe(1);
+  });
+
+  it("keeps a +1 step across the fall-back boundary (25h day)", () => {
+    // US fall-back: 2025-11-02 02:00 → 01:00 (that local day is 25h long).
+    const nov1 = dayIndex(localDay(2025, 10, 1, 12));
+    const nov2 = dayIndex(localDay(2025, 10, 2, 12));
+    const nov3 = dayIndex(localDay(2025, 10, 3, 12));
+    expect(nov2 - nov1).toBe(1);
+    expect(nov3 - nov2).toBe(1);
+  });
+
+  it("collapses both ambiguous fall-back hours to the same day index", () => {
+    // 01:30 occurs twice on 2025-11-02 (EDT then EST); both are that calendar day.
+    const day = dayIndex(localDay(2025, 10, 2, 12));
+    expect(dayIndex(localDay(2025, 10, 2, 0, 30))).toBe(day);
+    expect(dayIndex(localDay(2025, 10, 2, 23, 30))).toBe(day);
+  });
+});
