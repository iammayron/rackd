diff --git a/.claude/hooks/format.sh b/.claude/hooks/format.sh
new file mode 100644
index 0000000..16bedf6
--- /dev/null
+++ b/.claude/hooks/format.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+# PostToolUse hook: format the file Claude just edited, using whatever formatter
+# the project has. Receives the tool payload as JSON on stdin.
+# Never fails the tool call (always exit 0).
+set -euo pipefail
+
+input="$(cat)"
+file="$(printf '%s' "$input" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const j=JSON.parse(s);process.stdout.write((j.tool_input&&j.tool_input.file_path)||"")}catch{process.stdout.write("")}})' 2>/dev/null || true)"
+
+[ -z "$file" ] && exit 0
+[ -f "$file" ] || exit 0
+
+have() { command -v "$1" >/dev/null 2>&1; }
+
+# Repo-local formatter first: the version is pinned in package.json, so a
+# differently-versioned global install can't restyle the codebase behind our
+# backs. Falls back to a global/npx one only when the project has none.
+repo_root="${CLAUDE_PROJECT_DIR:-.}"
+local_prettier="$repo_root/node_modules/.bin/prettier"
+
+case "$file" in
+  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.json|*.css|*.scss|*.html|*.md|*.mdx|*.yaml|*.yml)
+    if have biome; then biome format --write "$file" >/dev/null 2>&1 || true
+    elif [ -x "$local_prettier" ]; then "$local_prettier" --write "$file" >/dev/null 2>&1 || true
+    elif have prettier; then prettier --write "$file" >/dev/null 2>&1 || true
+    else npx --no-install prettier --write "$file" >/dev/null 2>&1 || true
+    fi
+    ;;
+  *.py)
+    if have ruff; then ruff format "$file" >/dev/null 2>&1 || true; fi
+    if have black; then black -q "$file" >/dev/null 2>&1 || true; fi
+    ;;
+  *.go)  have gofmt && gofmt -w "$file" >/dev/null 2>&1 || true ;;
+  *.rs)  have rustfmt && rustfmt "$file" >/dev/null 2>&1 || true ;;
+  *.rb)  have rubocop && rubocop -A "$file" >/dev/null 2>&1 || true ;;
+esac
+exit 0
diff --git a/.claude/hooks/run-tests.sh b/.claude/hooks/run-tests.sh
new file mode 100644
index 0000000..5f03d9c
--- /dev/null
+++ b/.claude/hooks/run-tests.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+# Stop hook: when work touched code, run the fast gate (typecheck + core vitest)
+# before letting the turn end. Blocks (exit 2) on failure so the model fixes it.
+#
+# Deliberately NOT run here: `@rackd/db` repo tests need a live Postgres, so
+# running them on every Stop would block whenever the DB is down. Those belong to
+# verify-app / an explicit `pnpm --filter @rackd/db test`.
+set -uo pipefail
+
+input="$(cat)"
+
+# Loop guard: if we already blocked once this turn, don't block again.
+active="$(printf '%s' "$input" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{process.stdout.write(String(JSON.parse(s).stop_hook_active||""))}catch{process.stdout.write("")}})' 2>/dev/null || true)"
+[ "$active" = "true" ] && exit 0
+
+cd "${CLAUDE_PROJECT_DIR:-.}" || exit 0
+
+# Nothing to test if no TS under packages/ or apps/ changed (tracked or not).
+changed="$( { git diff --name-only HEAD; git ls-files --others --exclude-standard; } 2>/dev/null \
+  | grep -E '^(packages|apps)/.*\.(ts|tsx)$' || true)"
+[ -z "$changed" ] && exit 0
+
+# Gate needs node >= 22; local node may be older. Load nvm 22 if present.
+export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
+[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 && nvm use 22 >/dev/null 2>&1 || true
+
+out="$(pnpm typecheck && pnpm --filter @rackd/core test 2>&1)"
+status=$?
+if [ $status -ne 0 ]; then
+  # stderr is fed back to the model; exit 2 blocks the stop.
+  printf 'Gate failed — fix before finishing (typecheck + @rackd/core test):\n\n%s\n' "$out" >&2
+  exit 2
+fi
+exit 0
