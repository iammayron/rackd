diff --git a/apps/web/test/lib/api.test.ts b/apps/web/test/lib/api.test.ts
new file mode 100644
index 0000000..479daa8
--- /dev/null
+++ b/apps/web/test/lib/api.test.ts
@@ -0,0 +1,141 @@
+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+/**
+ * Pure client-lib tests for the typed fetch wrapper (`api`) and the
+ * offline-aware mutation helper (`apiMutate`). No DB: idb-keyval is an in-memory
+ * Map and fetch is a vi.fn(). The global Supabase mock (test/setup.ts) supplies a
+ * fixed access token; the "no session" case re-mocks ./supabase per-test.
+ */
+
+const store = new Map<unknown, unknown>();
+vi.mock("idb-keyval", () => ({
+  get: vi.fn(async (key: unknown) => store.get(key)),
+  set: vi.fn(async (key: unknown, value: unknown) => {
+    store.set(key, value);
+  }),
+  del: vi.fn(async (key: unknown) => {
+    store.delete(key);
+  }),
+  keys: vi.fn(async () => Array.from(store.keys())),
+}));
+
+import { api, apiMutate } from "../../src/lib/api";
+
+const PREFIX = "mutation:";
+
+function setOnline(value: boolean) {
+  Object.defineProperty(navigator, "onLine", { value, configurable: true });
+}
+
+function jsonRes(body: unknown, status = 200) {
+  return {
+    ok: status >= 200 && status < 300,
+    status,
+    text: async () => (body === undefined ? "" : JSON.stringify(body)),
+  };
+}
+
+function textRes(text: string, status: number) {
+  return {
+    ok: status >= 200 && status < 300,
+    status,
+    text: async () => text,
+  };
+}
+
+beforeEach(() => {
+  store.clear();
+  vi.restoreAllMocks();
+  vi.resetModules();
+  global.fetch = vi.fn();
+  setOnline(true);
+});
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+describe("api", () => {
+  it("GET ok returns the parsed body and attaches auth + content-type headers", async () => {
+    (global.fetch as ReturnType<typeof vi.fn>).mockResolvedValue(jsonRes({ hello: "world" }));
+
+    const result = await api<{ hello: string }>("/api/thing");
+    expect(result).toEqual({ hello: "world" });
+
+    const [path, init] = (global.fetch as ReturnType<typeof vi.fn>).mock.calls[0]!;
+    expect(path).toBe("/api/thing");
+    expect(init.headers["Content-Type"]).toBe("application/json");
+    expect(init.headers.Authorization).toBe("Bearer test-session-token");
+  });
+
+  it("returns undefined on a 204 / empty body (does not throw on JSON.parse)", async () => {
+    (global.fetch as ReturnType<typeof vi.fn>).mockResolvedValue(jsonRes(undefined, 204));
+
+    await expect(api("/api/thing", { method: "DELETE" })).resolves.toBeUndefined();
+  });
+
+  it("throws an Error containing the status and body text on non-2xx", async () => {
+    (global.fetch as ReturnType<typeof vi.fn>).mockResolvedValue(textRes("kaboom", 500));
+
+    await expect(api("/api/thing")).rejects.toThrow(/500/);
+    await expect(api("/api/thing")).rejects.toThrow(/kaboom/);
+  });
+
+  it("omits the Authorization header when there is no session", async () => {
+    // Re-mock ./supabase so getSession resolves no session, with a fresh module graph.
+    vi.doMock("../../src/lib/supabase", () => ({
+      getSupabase: () => ({
+        auth: {
+          getSession: async () => ({ data: { session: null }, error: null }),
+        },
+      }),
+    }));
+    const fetchMock = vi.fn().mockResolvedValue(jsonRes({ ok: true }));
+    global.fetch = fetchMock;
+
+    const { api: freshApi } = await import("../../src/lib/api");
+    await freshApi("/api/thing");
+
+    const init = fetchMock.mock.calls[0]![1];
+    expect(init.headers.Authorization).toBeUndefined();
+    expect(init.headers["Content-Type"]).toBe("application/json");
+  });
+});
+
+describe("apiMutate", () => {
+  it("online success returns the parsed result and queues nothing", async () => {
+    (global.fetch as ReturnType<typeof vi.fn>).mockResolvedValue(jsonRes({ id: 7 }));
+
+    const result = await apiMutate<{ id: number }>("/api/thing", {
+      method: "POST",
+      body: '{"a":1}',
+    });
+    expect(result).toEqual({ id: 7 });
+    expect(store.size).toBe(0);
+  });
+
+  it("offline write failure enqueues the mutation and resolves undefined", async () => {
+    setOnline(false);
+    (global.fetch as ReturnType<typeof vi.fn>).mockRejectedValue(new Error("offline"));
+
+    const result = await apiMutate("/api/thing", { method: "POST", body: '{"a":1}' });
+    expect(result).toBeUndefined();
+
+    const keys = Array.from(store.keys()) as string[];
+    expect(keys).toHaveLength(1);
+    expect(keys[0]!.startsWith(PREFIX)).toBe(true);
+    const entry = store.get(keys[0]!) as Record<string, unknown>;
+    expect(entry.url).toBe("/api/thing");
+    expect(entry.method).toBe("POST");
+    expect(entry.body).toBe('{"a":1}');
+  });
+
+  it("offline READ (non-write) failure rethrows and does not enqueue", async () => {
+    setOnline(false);
+    (global.fetch as ReturnType<typeof vi.fn>).mockRejectedValue(new Error("offline"));
+
+    await expect(apiMutate("/api/thing", { method: "GET" })).rejects.toThrow(/offline/);
+    expect(store.size).toBe(0);
+  });
+});
diff --git a/apps/web/test/lib/offline-queue.test.ts b/apps/web/test/lib/offline-queue.test.ts
new file mode 100644
index 0000000..a7a5431
--- /dev/null
+++ b/apps/web/test/lib/offline-queue.test.ts
@@ -0,0 +1,173 @@
+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+/**
+ * Pure client-lib tests for the IndexedDB-backed offline mutation queue. No DB:
+ * idb-keyval is replaced with an in-memory Map and fetch is a vi.fn(). The global
+ * Supabase mock (test/setup.ts) makes getSession() resolve a fixed access token.
+ */
+
+// In-memory idb-keyval backed by a Map, reset between tests.
+const store = new Map<unknown, unknown>();
+vi.mock("idb-keyval", () => ({
+  get: vi.fn(async (key: unknown) => store.get(key)),
+  set: vi.fn(async (key: unknown, value: unknown) => {
+    store.set(key, value);
+  }),
+  del: vi.fn(async (key: unknown) => {
+    store.delete(key);
+  }),
+  keys: vi.fn(async () => Array.from(store.keys())),
+}));
+
+import { enqueue, flushQueue, isWriteMethod } from "../../src/lib/offline-queue";
+
+const PREFIX = "mutation:";
+
+beforeEach(() => {
+  store.clear();
+  vi.restoreAllMocks();
+  global.fetch = vi.fn();
+});
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+/** Insert a queued mutation directly into the store with a controlled createdAt. */
+function seed(entry: {
+  id: string;
+  url: string;
+  method: string;
+  body?: string;
+  createdAt: number;
+}) {
+  store.set(`${PREFIX}${entry.id}`, entry);
+}
+
+function okRes() {
+  return { ok: true, status: 200 };
+}
+function notOkRes() {
+  return { ok: false, status: 409 };
+}
+
+describe("isWriteMethod", () => {
+  it("returns true for write methods (case-insensitive)", () => {
+    for (const m of ["POST", "PUT", "PATCH", "DELETE", "post", "put", "patch", "delete"]) {
+      expect(isWriteMethod(m)).toBe(true);
+    }
+  });
+
+  it("returns false for read/other methods", () => {
+    for (const m of ["GET", "HEAD", "get", "head", "OPTIONS"]) {
+      expect(isWriteMethod(m)).toBe(false);
+    }
+  });
+});
+
+describe("enqueue", () => {
+  it("stores an entry under a mutation: key with id + createdAt", async () => {
+    vi.spyOn(Date, "now").mockReturnValue(123456);
+    await enqueue({ url: "/api/x", method: "POST", body: '{"a":1}' });
+
+    const keys = Array.from(store.keys()) as string[];
+    expect(keys).toHaveLength(1);
+    expect(keys[0]!.startsWith(PREFIX)).toBe(true);
+
+    const entry = store.get(keys[0]!) as Record<string, unknown>;
+    expect(entry.url).toBe("/api/x");
+    expect(entry.method).toBe("POST");
+    expect(entry.body).toBe('{"a":1}');
+    expect(typeof entry.id).toBe("string");
+    expect((entry.id as string).length).toBeGreaterThan(0);
+    expect(entry.createdAt).toBe(123456);
+    // key is keyed by the generated id.
+    expect(keys[0]).toBe(`${PREFIX}${entry.id}`);
+  });
+});
+
+describe("flushQueue", () => {
+  it("returns 0 and does not fetch on an empty queue", async () => {
+    const flushed = await flushQueue();
+    expect(flushed).toBe(0);
+    expect(global.fetch).not.toHaveBeenCalled();
+  });
+
+  it("replays oldest-first (FIFO by createdAt), deletes all, returns count", async () => {
+    // Seed out of insertion order to prove the sort.
+    seed({ id: "b", url: "/api/2", method: "POST", body: "2", createdAt: 200 });
+    seed({ id: "c", url: "/api/3", method: "POST", body: "3", createdAt: 300 });
+    seed({ id: "a", url: "/api/1", method: "POST", body: "1", createdAt: 100 });
+
+    (global.fetch as ReturnType<typeof vi.fn>).mockResolvedValue(okRes());
+
+    const flushed = await flushQueue();
+    expect(flushed).toBe(3);
+
+    const fetchMock = global.fetch as ReturnType<typeof vi.fn>;
+    expect(fetchMock).toHaveBeenCalledTimes(3);
+    // Assert FIFO order of replay.
+    expect(fetchMock.mock.calls[0]![0]).toBe("/api/1");
+    expect(fetchMock.mock.calls[1]![0]).toBe("/api/2");
+    expect(fetchMock.mock.calls[2]![0]).toBe("/api/3");
+
+    // Everything removed from idb.
+    expect(store.size).toBe(0);
+  });
+
+  it("carries the Authorization bearer + stored body/method on each replay", async () => {
+    seed({ id: "a", url: "/api/1", method: "PATCH", body: '{"v":1}', createdAt: 100 });
+    (global.fetch as ReturnType<typeof vi.fn>).mockResolvedValue(okRes());
+
+    await flushQueue();
+
+    const fetchMock = global.fetch as ReturnType<typeof vi.fn>;
+    const [url, init] = fetchMock.mock.calls[0]!;
+    expect(url).toBe("/api/1");
+    expect(init.method).toBe("PATCH");
+    expect(init.body).toBe('{"v":1}');
+    expect(init.headers["Content-Type"]).toBe("application/json");
+    // Token from the global supabase mock.
+    expect(init.headers.Authorization).toBe("Bearer test-session-token");
+  });
+
+  it("stops on a non-ok response: deletes only the successful ones, leaves the rest", async () => {
+    seed({ id: "a", url: "/api/1", method: "POST", body: "1", createdAt: 100 });
+    seed({ id: "b", url: "/api/2", method: "POST", body: "2", createdAt: 200 });
+    seed({ id: "c", url: "/api/3", method: "POST", body: "3", createdAt: 300 });
+
+    const fetchMock = global.fetch as ReturnType<typeof vi.fn>;
+    fetchMock
+      .mockResolvedValueOnce(okRes())
+      .mockResolvedValueOnce(okRes())
+      .mockResolvedValueOnce(notOkRes());
+
+    const flushed = await flushQueue();
+    expect(flushed).toBe(2);
+    expect(fetchMock).toHaveBeenCalledTimes(3);
+
+    // First two deleted, the third remains queued.
+    expect(store.has(`${PREFIX}a`)).toBe(false);
+    expect(store.has(`${PREFIX}b`)).toBe(false);
+    expect(store.has(`${PREFIX}c`)).toBe(true);
+  });
+
+  it("stops on a network error mid-flush, leaving the remainder queued", async () => {
+    seed({ id: "a", url: "/api/1", method: "POST", body: "1", createdAt: 100 });
+    seed({ id: "b", url: "/api/2", method: "POST", body: "2", createdAt: 200 });
+    seed({ id: "c", url: "/api/3", method: "POST", body: "3", createdAt: 300 });
+
+    const fetchMock = global.fetch as ReturnType<typeof vi.fn>;
+    fetchMock.mockResolvedValueOnce(okRes()).mockRejectedValueOnce(new Error("offline"));
+
+    const flushed = await flushQueue();
+    expect(flushed).toBe(1);
+    // Stopped at the throw — third request never attempted.
+    expect(fetchMock).toHaveBeenCalledTimes(2);
+
+    expect(store.has(`${PREFIX}a`)).toBe(false);
+    expect(store.has(`${PREFIX}b`)).toBe(true);
+    expect(store.has(`${PREFIX}c`)).toBe(true);
+  });
+});
diff --git a/apps/web/test/setup.ts b/apps/web/test/setup.ts
new file mode 100644
index 0000000..37426d9
--- /dev/null
+++ b/apps/web/test/setup.ts
@@ -0,0 +1,29 @@
+import { vi } from "vitest";
+
+/**
+ * Stub Supabase at the network seam for the WHOLE suite. Both server and client
+ * code construct a client via `@supabase/supabase-js` createClient:
+ *  - API routes: `getAuthUser` calls `getUser(token)` → here a non-empty token
+ *    maps to user `{ id: token }`, empty/absent → null (401). So a request with
+ *    `Authorization: Bearer owner-a` is "called by owner-a".
+ *  - Client lib: `getSupabase().auth.getSession()` → a fixed test session token.
+ * No real Supabase network calls; the DB below the auth seam stays real.
+ */
+vi.mock("@supabase/supabase-js", () => ({
+  createClient: () => ({
+    auth: {
+      getUser: async (token?: string) => ({
+        data: { user: token ? { id: token } : null },
+        error: null,
+      }),
+      getSession: async () => ({
+        data: { session: { access_token: "test-session-token" } },
+        error: null,
+      }),
+      signInWithPassword: async () => ({ error: null }),
+      signUp: async () => ({ error: null }),
+      signOut: async () => ({ error: null }),
+      onAuthStateChange: () => ({ data: { subscription: { unsubscribe() {} } } }),
+    },
+  }),
+}));
